# ==========================================
# 870tivo - Environment Variables Template
# ==========================================
# Copia este archivo como .env para desarrollo local:
#   cp .env.example .env
#
# Para GitHub Actions (CI/CD), configura estas variables como Secrets en:
#   Settings > Secrets and variables > Actions > Repository secrets

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# URL de la instancia de Supabase (requerida para cliente y SSR)
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave pública anónima de Supabase (safe for browser)
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Llave de rol de servicio (Service Role) con privilegios administrativos (solo backend / SSR / CI)
# ADVERTENCIA: Mantener privada y nunca exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ------------------------------------------
# Sanity CMS Configuration (Opcional)
# ------------------------------------------
SANITY_PROJECT_ID=tu-sanity-project-id
SANITY_DATASET=production
