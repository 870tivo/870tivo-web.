---
/**
 * dashboard.astro — Centro de Control Operativo 870tivo
 * Layout full-width (noSidebar=true) · Tema oscuro profundo fijo.
 *
 * ESTRUCTURA:
 *   [DashHeader]  — Cabecera con saludo, rol, correo y acciones rápidas
 *   [DashKpis]    — 4 KPIs con datos reales de Supabase                     ← Fase 2 ✓
 *   [DashContent] — Bloque central 2 columnas (Fase 3 — próximo)
 *   [DashBottom]  — Moderación + Bitácora  (Fase 4 — próximo)
 */

import AdminLayout from '../../layouts/AdminLayout.astro';
import DashHeader from '../../components/admin/dashboard/DashHeader.astro';
import DashKpis from '../../components/admin/dashboard/DashKpis.astro';
import DashEditorialTabs from '../../components/admin/dashboard/DashEditorialTabs.astro';
import DashActividades from '../../components/admin/dashboard/DashActividades.astro';
import DashComments from '../../components/admin/dashboard/DashComments.astro';
import DashAuditLog from '../../components/admin/dashboard/DashAuditLog.astro';

// ── Autenticación SSR ──────────────────────────────────────────
const user = Astro.locals.user;
if (!user?.id) {
  return Astro.redirect('/2416f50b-da02-4a5b-86a8-61ae470ed3bd/login');
}

const role     = Astro.locals.role;
const isSuperAdmin = Astro.locals.isSuperAdmin;

// Nombre visible
const userEmail     = user.email ?? 'admin@870tivo.com';
const userFirstName = Astro.locals.userFirstName ?? (user.user_metadata?.first_name as string) ?? '';
const userLastName  = Astro.locals.userLastName  ?? (user.user_metadata?.last_name  as string) ?? '';
const metaName      = [userFirstName, userLastName].filter(Boolean).join(' ')
                   || Astro.locals.userFullName
                   || (user.user_metadata?.full_name as string)
                   || (user.user_metadata?.name     as string);
const rawName  = metaName || userEmail.split('@')[0];
const userName = rawName.charAt(0).toUpperCase() + rawName.slice(1);

// Nombre de rol para el badge
const userRoleName: string = role?.name
  ? role.name
  : (isSuperAdmin ? 'super_admin' : 'editor');

// Parámetro de error de acceso (redireccionado desde otra sección)
const errorParam   = Astro.url.searchParams.get('error');
const messageParam = Astro.url.searchParams.get('message')
  ?? 'Acceso restringido: Se requieren privilegios de Administrador.';

const ADMIN_BASE = '/2416f50b-da02-4a5b-86a8-61ae470ed3bd';
---

<AdminLayout
  title="Dashboard · 870tivo Control Studio"
  headerTitle="Dashboard"
  activeModule="dashboard"
  noSidebar={false}
  fullWidth={true}
>
  <!--
    NOTA: AdminLayout en modo noSidebar=true inyecta el AdminHeader estándar
    (con breadcrumb y chip de usuario) + este slot.
    DashHeader es la cabecera editorial dentro del contenido de la página,
    se renderiza ANTES que los KPIs como la primera sección visible.
  -->

  <!-- ── Banner de acceso denegado (solo si viene de redirect con ?error) ── -->
  {errorParam === 'access_denied' && (
    <div
      role="alert"
      class="mb-6 flex items-start gap-3 rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm"
    >
      <svg class="mt-0.5 w-4 h-4 shrink-0 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
      <div>
        <p class="font-semibold text-amber-300">Privilegios insuficientes</p>
        <p class="mt-0.5 text-amber-400/80 text-xs">{messageParam}</p>
      </div>
    </div>
  )}

  <!-- ── ZONA 1: Cabecera operativa full-width ────────────── -->
  <!--
    DashHeader no va dentro del <main> del AdminLayout sino directamente
    en el slot para aprovechar el ancho total sin el padding del main.
    Usamos un wrapper negativo para "romper" el padding del contenedor.
  -->
  <div class="-mx-4 sm:-mx-6 lg:-mx-8 -mt-8 sm:-mt-10 mb-8">
    <DashHeader
      userName={userName}
      userEmail={userEmail}
      userRole={userRoleName}
      adminBase={ADMIN_BASE}
    />
  </div>

  <!-- ── ZONA 2: Bloque de KPIs ──────────────────────────── -->
  <section class="mb-8" aria-label="Indicadores de impacto del mes">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-widest">
          Impacto del Mes
        </h2>
      </div>
      <!-- Timestamp de última actualización -->
      <span class="font-sans text-[11px] text-zinc-500 font-medium">
        Actualizado: {new Date().toLocaleString('es-CO', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })}
      </span>
    </div>

    <!-- El componente DashKpis hace sus propias queries SSR -->
    <DashKpis />
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ZONA 3: Gestión Activa de Contenidos (2 Columnas)
       Columna Izquierda: Blog / Galería / Autores (Tabs)
       Columna Derecha: Panel Integral de Actividades
       ═══════════════════════════════════════════════════════ -->
  <section class="mb-8" aria-label="Gestión activa de contenidos y programación">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      <!-- Columna Izquierda (7 cols): Catálogo & Gestión Editorial -->
      <div class="lg:col-span-7 xl:col-span-7 flex flex-col">
        <DashEditorialTabs adminBase={ADMIN_BASE} />
      </div>

      <!-- Columna Derecha (5 cols): Programación Cultural -->
      <div class="lg:col-span-5 xl:col-span-5 flex flex-col">
        <DashActividades adminBase={ADMIN_BASE} />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ZONA 4: Moderación y Auditoría (2 Columnas)
       Columna Izquierda: Comentarios Recientes (Aprobar/Responder/Eliminar)
       Columna Derecha: Bitácora de Cambios (Audit Log cronológico)
       ═══════════════════════════════════════════════════════ -->
  <section class="mb-8" aria-label="Moderación de comentarios y bitácora de cambios">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
      <!-- Columna Izquierda: Moderación de Comentarios -->
      <div class="flex flex-col">
        <DashComments />
      </div>

      <!-- Columna Derecha: Bitácora de Cambios (Audit Log) -->
      <div class="flex flex-col">
        <DashAuditLog />
      </div>
    </div>
  </section>

</AdminLayout>

<!--
  OVERRIDE DE ESTILOS GLOBALES PARA MODO FULL-WIDTH OSCURO
  Forzamos el fondo oscuro del body/main cuando estamos en el dashboard.
  El AdminLayout ya tiene dark:bg-[#111111] pero con noSidebar
  queremos asegurar que no haya flashes de color claro.
-->
<style is:global>
  /* Fuerza el fondo oscuro en el body cuando está en el dashboard */
  body.admin-body {
    background-color: #111111 !important;
  }
</style>
