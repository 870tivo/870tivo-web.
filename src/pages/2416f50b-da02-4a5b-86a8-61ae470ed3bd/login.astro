---
import '../../styles/global.css';
import ThemeToggle from '../../components/common/ThemeToggle';

// If user already has a valid server session in middleware, middleware will redirect.
// Here we configure the page metadata.
const title = 'Iniciar Sesión | Galería 870 - Administración';
const fontsUrl = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap';
---

<!doctype html>
<html lang="es" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Acceso privado al panel administrativo de Galería 870" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontsUrl} rel="stylesheet" />

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'dark';
      })();

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>

  <body class="min-h-screen bg-brand-bg text-brand-ink dark:bg-brand-ink dark:text-brand-darkInk font-sans antialiased flex flex-col justify-between selection:bg-brand-orange selection:text-white transition-colors duration-200">
    
    <!-- Top Utility Bar -->
    <header class="w-full px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 text-xs uppercase tracking-widest text-brand-muted hover:text-brand-orange dark:hover:text-brand-bg transition-colors font-medium">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Volver a la galería</span>
      </a>

      <div class="flex items-center gap-3">
        <ThemeToggle client:load />
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 flex items-center justify-center px-4 py-8">
      <div class="w-full max-w-md">
        
        <!-- Brand Header Card -->
        <div class="bg-brand-card/70 dark:bg-brand-darkCard border border-brand-ink/10 dark:border-brand-darkCard/80 rounded-2xl p-8 sm:p-10 shadow-xl backdrop-blur-sm transition-all duration-300">
          
          <!-- Logo & Header -->
          <div class="text-center mb-8">
            <div class="inline-block relative mb-4">
              <img 
                src="/assets/logo/870.jpeg" 
                alt="Galería 870" 
                class="w-16 h-16 object-cover rounded-xl shadow-md mx-auto border border-brand-ink/10 dark:border-white/10"
              />
            </div>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-brand-ink dark:text-brand-darkInk">
              Galería 870
            </h1>
            <p class="text-xs uppercase tracking-widest text-brand-orange dark:text-brand-bg font-semibold mt-1">
              Panel Administrativo
            </p>
            <p class="text-xs text-brand-muted mt-2">
              Acceso exclusivo para el equipo de administración
            </p>
          </div>

          <!-- Error Alert Banner -->
          <div id="errorAlert" class="hidden mb-6 p-4 rounded-xl text-sm bg-red-500/10 border border-red-500/30 text-red-700 dark:text-red-400">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div class="flex-1">
                <p id="errorMessage" class="font-medium">Error al iniciar sesión</p>
              </div>
            </div>
          </div>

          <!-- Timeout Banner (visible cuando ?reason=timeout) -->
          <div id="timeoutAlert" class="hidden mb-6 p-4 rounded-xl text-sm bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-400">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div class="flex-1">
                <p class="font-medium">Sesión cerrada por inactividad</p>
                <p class="text-xs mt-0.5 opacity-80">Tu sesión se cerró automáticamente tras 30 minutos sin actividad. Inicia sesión para continuar.</p>
              </div>
            </div>
          </div>

          <!-- Form -->
          <form id="loginForm" class="space-y-5" novalidate>
            <div>
              <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-brand-ink/80 dark:text-brand-darkInk/80 mb-2">
                Correo Electrónico
              </label>
              <div class="relative">
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  autocomplete="email"
                  placeholder="admin@galeria870.com" 
                  class="w-full px-4 py-3 text-sm rounded-xl bg-white/70 dark:bg-brand-ink/60 border border-brand-ink/15 dark:border-brand-darkCard/80 text-brand-ink dark:text-brand-darkInk placeholder:text-brand-muted/70 focus:outline-none focus:ring-2 focus:ring-brand-orange dark:focus:ring-brand-yellow focus:border-transparent transition-all"
                />
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between mb-2">
                <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-brand-ink/80 dark:text-brand-darkInk/80">
                  Contraseña
                </label>
                <a 
                  href="/2416f50b-da02-4a5b-86a8-61ae470ed3bd/forgot-password" 
                  class="text-xs text-brand-muted hover:text-brand-orange dark:hover:text-brand-bg transition-colors"
                >
                  ¿Olvidaste tu contraseña?
                </a>
              </div>
              <div class="relative">
                <input 
                  type="password" 
                  id="password" 
                  name="password" 
                  required 
                  autocomplete="current-password"
                  placeholder="••••••••••••" 
                  class="w-full px-4 py-3 pr-11 text-sm rounded-xl bg-white/70 dark:bg-brand-ink/60 border border-brand-ink/15 dark:border-brand-darkCard/80 text-brand-ink dark:text-brand-darkInk placeholder:text-brand-muted/70 focus:outline-none focus:ring-2 focus:ring-brand-orange dark:focus:ring-brand-yellow focus:border-transparent transition-all"
                />
                <button 
                  type="button" 
                  id="togglePassword" 
                  aria-label="Mostrar u ocultar contraseña"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-brand-muted hover:text-brand-ink dark:hover:text-brand-darkInk transition-colors p-1"
                >
                  <svg id="eyeIcon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  <svg id="eyeOffIcon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a10.059 10.059 0 013.999-5.325m3.543-1.425A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.05 10.05 0 01-4.132 5.411m0 0L21 21M3 3l18 18" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              id="submitBtn" 
              class="w-full py-3.5 px-6 rounded-xl font-medium text-sm tracking-wide text-white bg-brand-ink dark:bg-brand-orange hover:bg-brand-ink/90 dark:hover:bg-brand-orange/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-orange dark:focus:ring-brand-yellow shadow-md hover:shadow-lg active:scale-[0.99] transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer mt-2"
            >
              <span id="btnText">Iniciar Sesión</span>
              <svg id="btnSpinner" class="hidden animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </form>

        </div>

        <!-- Subtle security notice -->
        <p class="text-center text-xs text-brand-muted mt-6">
          870tivo &mdash; Sistema de Gestión de Contenido Privado
        </p>

      </div>
    </main>

    <footer class="py-4 text-center text-xs text-brand-muted/70">
      &copy; {new Date().getFullYear()} Galería 870. Todos los derechos reservados.
    </footer>

    <!-- Client-side Auth Script (rate limiting vía endpoint SSR) -->
    <script>
      import { supabase } from '../../lib/supabase';

      const LOGIN_API_URL  = '/api/admin/auth/login';
      const DASHBOARD_URL  = '/2416f50b-da02-4a5b-86a8-61ae470ed3bd/dashboard';

      const loginForm       = document.getElementById('loginForm')       as HTMLFormElement   | null;
      const emailInput      = document.getElementById('email')           as HTMLInputElement  | null;
      const passwordInput   = document.getElementById('password')        as HTMLInputElement  | null;
      const submitBtn       = document.getElementById('submitBtn')       as HTMLButtonElement | null;
      const btnText         = document.getElementById('btnText');
      const btnSpinner      = document.getElementById('btnSpinner');
      const errorAlert      = document.getElementById('errorAlert');
      const errorMessage    = document.getElementById('errorMessage');
      const togglePasswordBtn = document.getElementById('togglePassword');
      const eyeIcon         = document.getElementById('eyeIcon');
      const eyeOffIcon      = document.getElementById('eyeOffIcon');

      // ── Redirigir si ya hay sesión activa en sessionStorage ──────────────────
      // No llamamos setAuthCookies() aquí: las cookies las establece el servidor
      // en el endpoint /api/admin/auth/login vía Set-Cookie. El middleware SSR
      // validará las cookies en la próxima navegación.
      supabase.auth.getSession().then(({ data: { session } }) => {
        if (session) {
          window.location.href = DASHBOARD_URL;
        }
      });

      // ── Banner de sesión expirada por inactividad ────────────────────────────
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('reason') === 'timeout') {
        document.getElementById('timeoutAlert')?.classList.remove('hidden');
      }

      // ── Toggle visibilidad de contraseña ─────────────────────────────────────
      togglePasswordBtn?.addEventListener('click', () => {
        if (!passwordInput) return;
        const isPassword = passwordInput.type === 'password';
        passwordInput.type = isPassword ? 'text' : 'password';
        eyeIcon?.classList.toggle('hidden', isPassword);
        eyeOffIcon?.classList.toggle('hidden', !isPassword);
      });

      // ── Helpers de UI ────────────────────────────────────────────────────────
      function showError(msg: string): void {
        if (errorMessage) errorMessage.textContent = msg;
        errorAlert?.classList.remove('hidden');
      }

      function hideError(): void {
        errorAlert?.classList.add('hidden');
      }

      function setLoading(loading: boolean): void {
        if (!submitBtn) return;
        submitBtn.disabled = loading;
        if (loading) {
          btnText?.classList.add('opacity-80');
          if (btnText) btnText.textContent = 'Verificando...';
          btnSpinner?.classList.remove('hidden');
        } else {
          btnText?.classList.remove('opacity-80');
          if (btnText) btnText.textContent = 'Iniciar Sesión';
          btnSpinner?.classList.add('hidden');
        }
      }

      /**
       * Bloquea el formulario y muestra countdown hasta que expire el bloqueo.
       * Reanuda el formulario automáticamente cuando el tiempo expira.
       */
      function applyBlockedState(blockedUntil: number): void {
        const tick = () => {
          const remaining = Math.max(0, blockedUntil - Date.now());
          if (remaining <= 0) {
            setLoading(false);
            if (btnText) btnText.textContent = 'Iniciar Sesión';
            return;
          }
          const mins = Math.floor(remaining / 60_000);
          const secs = String(Math.floor((remaining % 60_000) / 1_000)).padStart(2, '0');
          if (btnText) btnText.textContent = `Bloqueado — ${mins}:${secs}`;
          setTimeout(tick, 1_000);
        };
        setLoading(true);
        tick();
      }

      // ── Submit del formulario → delegación al endpoint SSR ───────────────────
      loginForm?.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        hideError();

        const email    = emailInput?.value.trim()   ?? '';
        const password = passwordInput?.value        ?? '';

        if (!email || !password) {
          showError('Por favor completa todos los campos.');
          return;
        }

        setLoading(true);

        try {
          // ── Llamada al endpoint SSR con rate limiting ──────────────────────
          const res  = await fetch(LOGIN_API_URL, {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ email, password }),
          });

          const json = await res.json() as {
            success:      boolean;
            message:      string;
            code?:        string;
            isBlocked?:   boolean;
            blockedUntil?: number;
            attemptsLeft?: number;
            failureCount?: number;
          };

          // ── Éxito → las cookies ya fueron establecidas por el servidor vía Set-Cookie.
          // Solo necesitamos confirmar success === true y navegar al dashboard.
          if (json.success) {
            if (btnText) btnText.textContent = 'Acceso concedido...';
            setTimeout(() => { window.location.href = DASHBOARD_URL; }, 300);
            return;
          }

          // ── Bloqueo total (5 intentos agotados) ───────────────────────────
          if (json.isBlocked && json.blockedUntil) {
            showError(json.message);
            applyBlockedState(json.blockedUntil);
            return;
          }

          // ── Error de credenciales / rate limit previo ─────────────────────
          showError(json.message ?? 'Error al iniciar sesión. Intenta nuevamente.');
          setLoading(false);

        } catch (err: unknown) {
          console.error('[login] Error inesperado:', err);
          showError('Ocurrió un error inesperado al conectar con el servidor.');
          setLoading(false);
        }
      });
    </script>
  </body>
</html>
