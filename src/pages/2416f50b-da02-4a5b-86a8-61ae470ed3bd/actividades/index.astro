                : 'bg-[#FAF6F0] dark:bg-[#1E1E1E] text-[#78716A] dark:text-neutral-400 border-transparent hover:text-[#1F1B16] dark:hover:text-white hover:border-[#E5DFD5] dark:hover:border-[#333333]'
            }`}
          >
            <span>🗣️ Encuentros</span>
            <span class="text-[10px] px-1.5 py-0.2 rounded-full bg-black/10 dark:bg-black/20 font-mono">
              {counts.encuentros}
            </span>
          </button>
        </div>

        <!-- Selector de Vista (Tabla vs Cuadrícula 16:10) -->
        <div class="flex items-center gap-1.5 shrink-0 border-t md:border-t-0 pt-2 md:pt-0 border-[#E5DFD5] dark:border-[#282828]">
          <span class="text-[11px] text-[#78716A] dark:text-neutral-400 font-medium hidden sm:inline">Vista:</span>
          <div class="inline-flex p-1 rounded-xl bg-[#FAF6F0] dark:bg-[#141414] border border-[#E5DFD5] dark:border-[#282828]">
            <button
              type="button"
              id="viewTableBtn"
              class="px-2.5 py-1 rounded-lg text-xs font-semibold transition-all cursor-pointer bg-white dark:bg-[#202020] text-[#1F1B16] dark:text-white shadow-xs flex items-center gap-1.5"
              title="Vista de Tabla Editorial"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
              </svg>
              <span>Tabla</span>
            </button>
            <button
              type="button"
              id="viewGridBtn"
              class="px-2.5 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer text-[#78716A] dark:text-neutral-400 hover:text-[#1F1B16] dark:hover:text-white flex items-center gap-1.5"
              title="Vista en Grilla de Afiches (16:10)"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
              <span>Grilla 16:10</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ── BARRA DE BÚSQUEDA Y FILTRO DE ESTADO ── -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
      <!-- Buscador dinámico -->
      <div class="w-full sm:max-w-md">
        <div class="relative">
          <input
            type="text"
            id="activitySearchInput"
            value={searchQuery}
            placeholder="Buscar por título, lugar o slug..."
            class="w-full pl-9 pr-4 py-2 text-xs bg-white dark:bg-[#181818] border border-[#E5DFD5] dark:border-[#282828] rounded-xl text-[#1F1B16] dark:text-white placeholder-[#78716A] dark:placeholder-neutral-500 focus:outline-none focus:border-[#E4572E] transition-colors"
          />
          <svg class="w-4 h-4 text-[#78716A] dark:text-neutral-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      <!-- Filtro por Estado (Publicado / Borrador / Todos) -->
      <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
        <span class="text-xs text-[#78716A] dark:text-neutral-400 font-medium">Estado:</span>
        <select
          id="activityStatusSelect"
          class="px-3 py-1.5 text-xs bg-white dark:bg-[#181818] border border-[#E5DFD5] dark:border-[#282828] rounded-xl text-[#1F1B16] dark:text-white focus:outline-none focus:border-[#E4572E] transition-colors cursor-pointer"
        >
          <option value="all" selected={statusFilter === 'all'}>Todos los estados</option>
          <option value="publicado" selected={statusFilter === 'publicado'}>Solo Publicados</option>
          <option value="borrador" selected={statusFilter === 'borrador'}>Solo Borradores</option>
        </select>

        <span id="resultsCounter" class="text-xs font-semibold text-[#78716A] dark:text-neutral-400 ml-2">
          {activities.length} resultado(s)
        </span>
      </div>
    </div>

    <!-- ── LISTADO PRINCIPAL: VISTA TABLA (POR DEFECTO) ── -->
    <div id="activitiesTableView" class="space-y-4">
      <div class="bg-white dark:bg-[#181818] rounded-2xl border border-[#E5DFD5] dark:border-[#282828] overflow-hidden shadow-xs">
        <div class="overflow-x-auto custom-scrollbar">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="border-b border-[#E5DFD5] dark:border-[#282828] bg-[#FAF6F0]/70 dark:bg-[#141414]/70 text-[#78716A] dark:text-neutral-400 font-bold uppercase tracking-wider text-[10px]">
                <th scope="col" class="py-3 px-4 w-28">Afiche (16:10)</th>
                <th scope="col" class="py-3 px-4">Actividad & Detalles</th>
                <th scope="col" class="py-3 px-4 w-36">Categoría</th>
                <th scope="col" class="py-3 px-4 w-44">Fecha & Ubicación</th>
                <th scope="col" class="py-3 px-4 w-32 text-center">Estado</th>
                <th scope="col" class="py-3 px-4 w-36 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody id="activityTableBody" class="divide-y divide-[#E5DFD5]/60 dark:divide-[#282828]">
              {activities.map((act) => {
                const meta = ACTIVITY_CATEGORIES[act.category];
                const isPast = isPastEvent(act.event_date);

                return (
                  <tr
                    class="activity-row hover:bg-[#FAF6F0]/50 dark:hover:bg-[#1E1E1E]/50 transition-colors group"
                    data-id={act.id}
                    data-slug={act.slug}
                    data-title={act.title.toLowerCase()}
                    data-category={act.category}
                    data-location={act.location.toLowerCase()}
                    data-status={act.status}
                    data-published={act.is_published ? 'true' : 'false'}
                  >
                    <!-- Portada 16:10 Miniatura -->
                    <td class="py-3 px-4 align-middle">
                      <div class="relative w-24 aspect-[16/10] rounded-lg overflow-hidden bg-neutral-100 dark:bg-[#141414] border border-[#E5DFD5] dark:border-[#282828] shadow-xs group-hover:border-[#E4572E]/50 transition-all">
                        {act.cover_url ? (
                          <img
                            src={act.cover_url}
                            alt={act.title}
                            loading="lazy"
                            class="activity-cover-img w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                          />
                        ) : (
                          <div class="w-full h-full flex items-center justify-center text-neutral-400 dark:text-neutral-600 bg-neutral-200 dark:bg-neutral-800">
                            <span class="text-[9px] font-mono font-bold">16:10</span>
                          </div>
                        )}
                        <span class="absolute bottom-0.5 right-0.5 px-1 rounded bg-black/70 text-white font-mono text-[8px]">
                          16:10
                        </span>
                      </div>
                    </td>

                    <!-- Título & Slug -->
                    <td class="py-3 px-4 align-middle">
                      <div class="space-y-1">
                        <div class="flex items-center gap-2">
                          <a
                            href={`/actividades/${act.slug}`}
                            target="_blank"
                            class="font-serif font-bold text-sm text-[#1F1B16] dark:text-white hover:text-[#E4572E] dark:hover:text-[#F2B134] transition-colors leading-snug line-clamp-1"
                          >
                            {act.title}
                          </a>
                          {isPast && (
                            <span class="text-[9px] px-1.5 py-0.2 rounded font-mono bg-neutral-100 dark:bg-neutral-800 text-neutral-500 border border-neutral-200 dark:border-neutral-700">
                              Pasado
                            </span>
                          )}
                        </div>

                        <div class="flex items-center gap-2 text-[11px] text-[#78716A] dark:text-neutral-400">
                          <span class="font-mono text-[10px] text-neutral-500 dark:text-neutral-400">
                            /{act.slug}
                          </span>
                          {act.description && (
                            <span class="hidden xl:inline text-neutral-400 dark:text-neutral-500 font-sans truncate max-w-md">
                              &bull; {act.description}
                            </span>
                          )}
                        </div>
                      </div>
                    </td>

                    <!-- Categoría con Badge Oficial -->
                    <td class="py-3 px-4 align-middle">
                      <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold border ${meta.badgeClass}`}>
                        <span>
                          {act.category === 'ciclos-cine' && '🎬'}
                          {act.category === 'club-lectura' && '📚'}
                          {act.category === 'talleres' && '🛠️'}
                          {act.category === 'encuentros' && '🗣️'}
                        </span>
                        <span>{meta.label}</span>
                      </span>
                    </td>

                    <!-- Fecha & Ubicación -->
                    <td class="py-3 px-4 align-middle">
                      <div class="space-y-0.5">
                        <div class="font-medium text-[#1F1B16] dark:text-neutral-200 text-xs flex items-center gap-1.5">
                          <svg class="w-3.5 h-3.5 text-[#E4572E] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                          </svg>
                          <span>{formatDateTime(act.event_date)}</span>
                        </div>
                        <div class="text-[11px] text-[#78716A] dark:text-neutral-400 flex items-center gap-1 truncate max-w-[180px]">
                          <svg class="w-3 h-3 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                          </svg>
                          <span class="truncate">{act.location}</span>
                        </div>
                      </div>
                    </td>

                    <!-- Estado (Publicado / Borrador) -->
                    <td class="py-3 px-4 align-middle text-center">
                      <button
                        type="button"
                        class="toggle-status-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold transition-all cursor-pointer border"
                        data-id={act.id}
                        data-status={act.status}
                        data-published={act.is_published ? 'true' : 'false'}
                        title="Haz clic para alternar visibilidad"
                      >
                        {act.is_published && act.status === 'publicado' ? (
                          <span class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-400 bg-emerald-500/10 border-emerald-500/30">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                            Publicado
                          </span>
                        ) : (
                          <span class="inline-flex items-center gap-1.5 text-amber-700 dark:text-amber-400 bg-amber-500/10 border-amber-500/30">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                            Borrador
                          </span>
                        )}
                      </button>
                    </td>

                    <!-- Acciones -->
                    <td class="py-3 px-4 align-middle text-right">
                      <div class="flex items-center justify-end gap-1.5">
                        <!-- Ver público -->
                        <a
                          href={`/actividades/${act.slug}`}
                          target="_blank"
                          class="p-1.5 rounded-lg text-neutral-500 hover:text-[#1F1B16] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
                          title="Ver en vivo"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                          </svg>
                        </a>

                        <!-- Editar -->
                        {canUpdate && (
                          <button
                            type="button"
                            class="edit-activity-btn p-1.5 rounded-lg text-neutral-500 hover:text-[#E4572E] hover:bg-[#E4572E]/10 transition-colors cursor-pointer"
                            data-id={act.id}
                            data-slug={act.slug}
                            data-category={act.category}
                            title="Editar actividad"
                          >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                          </button>
                        )}

                        <!-- Eliminar -->
                        {canDelete && (
                          <button
                            type="button"
                            class="delete-activity-btn p-1.5 rounded-lg text-neutral-400 hover:text-red-600 hover:bg-red-500/10 transition-colors cursor-pointer"
                            data-id={act.id}
                            data-slug={act.slug}
                            data-title={act.title}
                            data-cover={act.cover_url || ''}
                            title="Eliminar actividad"
                          >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                          </button>
                        )}
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ── LISTADO PRINCIPAL: VISTA GRILLA 16:10 (OCULTA POR DEFECTO) ── -->
    <div id="activitiesGridView" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {activities.map((act) => {
        const meta = ACTIVITY_CATEGORIES[act.category];
        const isPast = isPastEvent(act.event_date);

        return (
          <div
            class="activity-card group bg-white dark:bg-[#181818] rounded-2xl border border-[#E5DFD5] dark:border-[#282828] hover:border-[#E4572E]/50 dark:hover:border-[#E4572E]/50 overflow-hidden shadow-xs hover:shadow-md transition-all flex flex-col"
            data-id={act.id}
            data-slug={act.slug}
            data-title={act.title.toLowerCase()}
            data-category={act.category}
            data-location={act.location.toLowerCase()}
            data-status={act.status}
            data-published={act.is_published ? 'true' : 'false'}
          >
            <!-- Portada 16:10 -->
            <div class="relative w-full aspect-[16/10] overflow-hidden bg-neutral-100 dark:bg-[#121212]">
              {act.cover_url ? (
                <img
                  src={act.cover_url}
                  alt={act.title}
                  loading="lazy"
                  class="activity-cover-img w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              ) : (
                <div class="w-full h-full flex flex-col items-center justify-center text-neutral-400 bg-neutral-200 dark:bg-neutral-800">
                  <span class="font-serif font-bold text-lg text-neutral-500">870tivo</span>
                  <span class="text-[10px] font-mono">16:10 Cover</span>
                </div>
              )}

              <!-- Badges Superpuestos -->
              <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5">
                <span class={`px-2 py-0.5 rounded-lg text-[10px] font-bold border backdrop-blur-md bg-white/90 dark:bg-[#141414]/90 ${meta.badgeClass}`}>
                  {meta.label}
                </span>
                {isPast && (
                  <span class="px-2 py-0.5 rounded-lg text-[10px] font-mono bg-black/70 text-neutral-300">
                    Pasado
                  </span>
                )}
              </div>

              <div class="absolute top-2.5 right-2.5">
                {act.is_published && act.status === 'publicado' ? (
                  <span class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-emerald-500 text-white shadow-xs">
                    Publicado
                  </span>
                ) : (
                  <span class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-amber-500 text-[#141414] shadow-xs">
                    Borrador
                  </span>
                )}
              </div>

              <span class="absolute bottom-1 right-2 text-[9px] font-mono text-white/80 bg-black/60 px-1 rounded">
                16:10
              </span>
            </div>

            <!-- Contenido -->
            <div class="p-4 flex-1 flex flex-col justify-between space-y-3">
              <div class="space-y-1.5">
                <div class="flex items-center gap-1 text-[11px] text-[#E4572E] font-semibold">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span>{formatDateTime(act.event_date)}</span>
                </div>

                <h3 class="font-serif font-bold text-base text-[#1F1B16] dark:text-white line-clamp-2 leading-snug group-hover:text-[#E4572E] transition-colors">
                  {act.title}
                </h3>

                <p class="text-xs text-[#78716A] dark:text-neutral-400 line-clamp-2">
                  {act.description || 'Sin sinopsis disponible.'}
                </p>
              </div>

              <!-- Footer de la Card -->
              <div class="pt-3 border-t border-[#E5DFD5] dark:border-[#282828] flex items-center justify-between text-xs">
                <span class="text-[11px] text-[#78716A] dark:text-neutral-400 truncate max-w-[140px]">
                  📍 {act.location}
                </span>

                <div class="flex items-center gap-1">
                  <a
                    href={`/actividades/${act.slug}`}
                    target="_blank"
                    class="p-1.5 rounded-lg text-neutral-500 hover:text-[#1F1B16] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800"
                    title="Ver"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                  </a>

                  {canUpdate && (
                    <button
                      type="button"
                      class="edit-activity-btn p-1.5 rounded-lg text-neutral-500 hover:text-[#E4572E] hover:bg-[#E4572E]/10"
                      data-id={act.id}
                      data-slug={act.slug}
                      data-category={act.category}
                      title="Editar"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                    </button>
                  )}

                  {canDelete && (
                    <button
                      type="button"
                      class="delete-activity-btn p-1.5 rounded-lg text-neutral-400 hover:text-red-600 hover:bg-red-500/10"
                      data-id={act.id}
                      data-slug={act.slug}
                      data-title={act.title}
                      data-cover={act.cover_url || ''}
                      title="Eliminar"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  )}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- ── EMPTY STATE (CUANDO NO HAY RESULTADOS) ── -->
    <div id="noResultsState" class="hidden py-16 text-center bg-white dark:bg-[#181818] rounded-2xl border border-[#E5DFD5] dark:border-[#282828] p-8">
      <div class="w-16 h-16 mx-auto rounded-2xl bg-[#E4572E]/10 flex items-center justify-center text-[#E4572E] mb-3">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <h3 class="font-serif font-bold text-lg text-[#1F1B16] dark:text-white mb-1">
        No se encontraron actividades
      </h3>
      <p class="text-xs text-[#78716A] dark:text-neutral-400 max-w-sm mx-auto mb-5">
        No hay registros que coincidan con los filtros aplicados o la categoría seleccionada.
      </p>
      {canCreate && (
        <button
          type="button"
          id="emptyCreateBtn"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#E4572E] hover:bg-[#CF4821] text-white text-xs font-semibold transition-all cursor-pointer shadow-xs"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Crear Nueva Actividad</span>
        </button>
      )}
    </div>

  </div>

  <!-- ── MODAL DE CONFIRMACIÓN DE ELIMINACIÓN ── -->
  <div
    id="deleteActivityModal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-200"
    role="dialog"
    aria-modal="true"
    aria-labelledby="deleteModalTitle"
  >
    <div
      id="deleteModalCard"
      class="w-full max-w-md bg-white dark:bg-[#181818] rounded-2xl border border-[#E5DFD5] dark:border-[#282828] p-6 shadow-2xl scale-95 transition-transform duration-200"
    >
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </div>
        <div>
          <h3 id="deleteModalTitle" class="font-serif font-bold text-base text-[#1F1B16] dark:text-white">
            Eliminar Actividad
          </h3>
          <p class="text-xs text-[#78716A] dark:text-neutral-400">
            Esta acción no se puede deshacer.
          </p>
        </div>
      </div>

      <p class="text-xs text-[#1F1B16] dark:text-neutral-300 mb-4 leading-relaxed">
        ¿Estás seguro de que deseas eliminar permanentemente la actividad <strong id="deleteTargetTitle" class="text-[#E4572E]"></strong>? También se removerá su afiche del bucket de almacenamiento.
      </p>

      <div class="flex items-center justify-end gap-2.5 pt-2">
        <button
          type="button"
          id="cancelDeleteBtn"
          class="px-4 py-2 rounded-xl text-xs font-semibold bg-neutral-100 hover:bg-neutral-200 dark:bg-neutral-800 dark:hover:bg-neutral-700 text-[#1F1B16] dark:text-white transition-colors cursor-pointer"
        >
          Cancelar
        </button>
        <button
          type="button"
          id="confirmDeleteBtn"
          class="px-4 py-2 rounded-xl text-xs font-semibold bg-red-600 hover:bg-red-700 text-white transition-colors cursor-pointer inline-flex items-center gap-1.5"
        >
          <span id="confirmDeleteText">Sí, Eliminar</span>
          <div id="deleteSpinner" class="hidden w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
        </button>
      </div>
    </div>
  </div>

  <!-- ── TOAST NOTIFICATION ── -->
  <div
    id="adminToast"
    class="fixed bottom-6 right-6 z-50 transform translate-y-16 opacity-0 transition-all duration-300 pointer-events-none"
  >
    <div class="flex items-center gap-2.5 px-4 py-3 rounded-xl shadow-xl border text-xs font-medium bg-[#1F1B16] text-white border-neutral-700" id="toastInner">
      <span id="toastIcon">✨</span>
      <span id="toastMessage">Operación realizada con éxito.</span>
    </div>
  </div>
  <!-- ── MODAL FORMULARIO ESPECIALIZADO CRUD ── -->
  <ActivityEditorModal />
</AdminLayout>

<!-- ── SCRIPT CLIENT-SIDE: TOGGLES, URL SYNC Y FILTRADO REACTIVO ── -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // ── Referencias DOM ──
    const tabs = document.querySelectorAll('.category-tab-btn');
    const tableRows = document.querySelectorAll('.activity-row');
    const gridCards = document.querySelectorAll('.activity-card');
    const searchInput = document.getElementById('activitySearchInput');
    const statusSelect = document.getElementById('activityStatusSelect');
    const resultsCounter = document.getElementById('resultsCounter');
    const noResultsState = document.getElementById('noResultsState');
    const tableView = document.getElementById('activitiesTableView');
    const gridView = document.getElementById('activitiesGridView');
    const viewTableBtn = document.getElementById('viewTableBtn');
    const viewGridBtn = document.getElementById('viewGridBtn');
    const createBtnText = document.getElementById('createBtnText');
    const openCreateBtn = document.getElementById('openCreateActivityBtn');
    const emptyCreateBtn = document.getElementById('emptyCreateBtn');

    // Delete Modal
    const deleteModal = document.getElementById('deleteActivityModal');
    const deleteModalCard = document.getElementById('deleteModalCard');
    const deleteTargetTitle = document.getElementById('deleteTargetTitle');
    const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
    const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
    const confirmDeleteText = document.getElementById('confirmDeleteText');
    const deleteSpinner = document.getElementById('deleteSpinner');
    let itemToDelete = null;

    // ── Estado Local ──
    const urlParams = new URLSearchParams(window.location.search);
    let activeCategory = (urlParams.get('categoria') || urlParams.get('category') || 'todas').toLowerCase();
    let currentSearch = (urlParams.get('search') || urlParams.get('q') || '').trim().toLowerCase();
    let currentStatus = (urlParams.get('status') || 'all').trim().toLowerCase();

    const categoryNames = {
      'todas': 'Actividad',
      'ciclos-cine': 'Ciclo de Cine',
      'club-lectura': 'Club de Lectura',
      'talleres': 'Taller',
      'encuentros': 'Encuentro',
    };

    // ── 1. Filtrado Reactivo en el DOM ──
    function applyFilters() {
      let visibleCount = 0;

      const items = [...tableRows, ...gridCards];
      const processedIds = new Set();

      items.forEach((item) => {
        const itemCat = item.getAttribute('data-category') || '';
        const itemTitle = item.getAttribute('data-title') || '';
        const itemLoc = item.getAttribute('data-location') || '';
        const itemSlug = item.getAttribute('data-slug') || '';
        const itemStatus = item.getAttribute('data-status') || '';
        const id = item.getAttribute('data-id') || '';

        // Comprobación de categoría
        const matchCat = activeCategory === 'todas' || itemCat === activeCategory;

        // Comprobación de búsqueda
        const matchSearch =
          !currentSearch ||
          itemTitle.includes(currentSearch) ||
          itemLoc.includes(currentSearch) ||
          itemSlug.includes(currentSearch);

        // Comprobación de estado
        const matchStatus =
          currentStatus === 'all' ||
          itemStatus === currentStatus;

        const isVisible = matchCat && matchSearch && matchStatus;

        if (isVisible) {
          item.classList.remove('hidden');
          if (!processedIds.has(id)) {
            processedIds.add(id);
            visibleCount++;
          }
        } else {
          item.classList.add('hidden');
        }
      });

      // Actualizar contador
      if (resultsCounter) {
        resultsCounter.textContent = `${visibleCount} resultado(s)`;
      }

      // Empty State
      if (noResultsState) {
        if (visibleCount === 0) {
          noResultsState.classList.remove('hidden');
          if (tableView) tableView.classList.add('hidden');
          if (gridView) gridView.classList.add('hidden');
        } else {
          noResultsState.classList.add('hidden');
          // Restaurar vista activa
          const isGrid = gridView && !gridView.classList.contains('data-active-view-off') && viewGridBtn?.classList.contains('bg-white');
          if (isGrid) {
            if (gridView) gridView.classList.remove('hidden');
            if (tableView) tableView.classList.add('hidden');
          } else {
            if (tableView) tableView.classList.remove('hidden');
            if (gridView) gridView.classList.add('hidden');
          }
        }
      }

      // Actualizar texto del botón de creación con la categoría activa
      if (createBtnText) {
        const singularName = categoryNames[activeCategory] || 'Actividad';
        createBtnText.textContent = `+ Nueva ${singularName}`;
      }
    }

    // ── 2. Sincronización de URL (?categoria=...) ──
    function updateUrlParams() {
      const newUrl = new URL(window.location.href);

      if (activeCategory && activeCategory !== 'todas') {
        newUrl.searchParams.set('categoria', activeCategory);
      } else {
        newUrl.searchParams.delete('categoria');
        newUrl.searchParams.delete('category');
      }

      if (currentSearch) {
        newUrl.searchParams.set('search', currentSearch);
      } else {
        newUrl.searchParams.delete('search');
        newUrl.searchParams.delete('q');
      }

      if (currentStatus && currentStatus !== 'all') {
        newUrl.searchParams.set('status', currentStatus);
      } else {
        newUrl.searchParams.delete('status');
      }

      window.history.replaceState({}, '', newUrl.toString());
    }

    // ── 3. Gestión de Pestañas / Toggles ──
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetTab = tab.getAttribute('data-tab') || 'todas';
        activeCategory = targetTab;

        // Actualizar visual de botones
        tabs.forEach((t) => {
          const isSelected = t.getAttribute('data-tab') === activeCategory;
          t.setAttribute('aria-selected', isSelected ? 'true' : 'false');

          if (isSelected) {
            // Estilos activos según categoría
            if (activeCategory === 'ciclos-cine') {
              t.className = 'category-tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer select-none shrink-0 border bg-[#E4572E] text-white border-[#E4572E] shadow-xs';
            } else if (activeCategory === 'club-lectura') {
              t.className = 'category-tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer select-none shrink-0 border bg-[#2F4B3A] text-white border-[#2F4B3A] shadow-xs';
            } else if (activeCategory === 'talleres') {
              t.className = 'category-tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer select-none shrink-0 border bg-[#F2B134] text-[#1F1B16] border-[#F2B134] font-bold shadow-xs';
            } else {
              t.className = 'category-tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer select-none shrink-0 border bg-[#1F1B16] text-white border-[#1F1B16] dark:bg-white dark:text-[#141414] dark:border-white shadow-xs';
            }
          } else {
            t.className = 'category-tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer select-none shrink-0 border bg-[#FAF6F0] dark:bg-[#1E1E1E] text-[#78716A] dark:text-neutral-400 border-transparent hover:text-[#1F1B16] dark:hover:text-white hover:border-[#E5DFD5] dark:hover:border-[#333333]';
          }
        });

        applyFilters();
        updateUrlParams();
      });
    });

    // ── 4. Filtro de Búsqueda ──
    let searchDebounce;
    searchInput?.addEventListener('input', (e) => {
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(() => {
        currentSearch = e.target.value.trim().toLowerCase();
        applyFilters();
        updateUrlParams();
      }, 150);
    });

    // ── 5. Filtro de Estado ──
    statusSelect?.addEventListener('change', (e) => {
      currentStatus = e.target.value;
      applyFilters();
      updateUrlParams();
    });

    // ── 6. Switch de Vista (Tabla vs Grilla 16:10) ──
    viewTableBtn?.addEventListener('click', () => {
      if (tableView) tableView.classList.remove('hidden');
      if (gridView) gridView.classList.add('hidden');

      viewTableBtn.className = 'px-2.5 py-1 rounded-lg text-xs font-semibold transition-all cursor-pointer bg-white dark:bg-[#202020] text-[#1F1B16] dark:text-white shadow-xs flex items-center gap-1.5';
      viewGridBtn.className = 'px-2.5 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer text-[#78716A] dark:text-neutral-400 hover:text-[#1F1B16] dark:hover:text-white flex items-center gap-1.5';
    });

    viewGridBtn?.addEventListener('click', () => {
      if (tableView) tableView.classList.add('hidden');
      if (gridView) gridView.classList.remove('hidden');

      viewGridBtn.className = 'px-2.5 py-1 rounded-lg text-xs font-semibold transition-all cursor-pointer bg-white dark:bg-[#202020] text-[#1F1B16] dark:text-white shadow-xs flex items-center gap-1.5';
      viewTableBtn.className = 'px-2.5 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer text-[#78716A] dark:text-neutral-400 hover:text-[#1F1B16] dark:hover:text-white flex items-center gap-1.5';
    });

    // ── 7. Toggle Rápido de Estado / Visibilidad ──
    document.querySelectorAll('.toggle-status-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const id = btn.getAttribute('data-id');
        const currentPub = btn.getAttribute('data-published') === 'true';
        const nextPub = !currentPub;
        const nextStatus = nextPub ? 'publicado' : 'borrador';

        try {
          // Intentar llamada API (o simular cambio en el DOM)
          await fetch(`/api/admin/activities/toggle-status`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, is_published: nextPub, status: nextStatus }),
          });

          // Actualizar visual en la fila
          btn.setAttribute('data-published', nextPub ? 'true' : 'false');
          btn.setAttribute('data-status', nextStatus);

          const row = btn.closest('.activity-row');
          if (row) {
            row.setAttribute('data-published', nextPub ? 'true' : 'false');
            row.setAttribute('data-status', nextStatus);
          }

          if (nextPub) {
            btn.innerHTML = `
              <span class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-400 bg-emerald-500/10 border-emerald-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                Publicado
              </span>
            `;
            showToast('Actividad publicada exitosamente', '✅');
          } else {
            btn.innerHTML = `
              <span class="inline-flex items-center gap-1.5 text-amber-700 dark:text-amber-400 bg-amber-500/10 border-amber-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                Borrador
              </span>
            `;
            showToast('Actividad cambiada a borrador', '📝');
          }
        } catch (err) {
          console.warn('Endpoint toggle-status no disponible o error:', err);
          showToast('Estado actualizado en la vista', 'ℹ️');
        }
      });
    });

    // ── 8. Modal de Eliminación ──
    function openDeleteModal(item) {
      itemToDelete = item;
      if (deleteTargetTitle) deleteTargetTitle.textContent = item.title;
      deleteModal?.classList.remove('opacity-0', 'pointer-events-none');
      deleteModal?.classList.add('opacity-100');
      deleteModalCard?.classList.remove('scale-95');
      deleteModalCard?.classList.add('scale-100');
    }

    function closeDeleteModal() {
      itemToDelete = null;
      deleteModal?.classList.add('opacity-0', 'pointer-events-none');
      deleteModal?.classList.remove('opacity-100');
      deleteModalCard?.classList.add('scale-95');
      deleteModalCard?.classList.remove('scale-100');
      if (deleteSpinner) deleteSpinner.classList.add('hidden');
      if (confirmDeleteText) confirmDeleteText.textContent = 'Sí, Eliminar';
      if (confirmDeleteBtn) confirmDeleteBtn.removeAttribute('disabled');
    }

    document.querySelectorAll('.delete-activity-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const id = btn.getAttribute('data-id') || '';
        const title = btn.getAttribute('data-title') || '';
        const slug = btn.getAttribute('data-slug') || '';
        const cover = btn.getAttribute('data-cover') || '';
        openDeleteModal({ id, title, slug, cover });
      });
    });

    cancelDeleteBtn?.addEventListener('click', closeDeleteModal);
    deleteModal?.addEventListener('click', (e) => {
      if (e.target === deleteModal) closeDeleteModal();
    });

    confirmDeleteBtn?.addEventListener('click', async () => {
      if (!itemToDelete) return;

      if (deleteSpinner) deleteSpinner.classList.remove('hidden');
      if (confirmDeleteText) confirmDeleteText.textContent = 'Eliminando...';
      confirmDeleteBtn.setAttribute('disabled', 'true');

      try {
        await fetch(`/api/admin/activities/delete`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: itemToDelete.id, slug: itemToDelete.slug, cover_url: itemToDelete.cover }),
        });

        // Remover del DOM
        document.querySelectorAll(`[data-id="${itemToDelete.id}"]`).forEach((el) => el.remove());
        closeDeleteModal();
        showToast(`Actividad «${itemToDelete.title}» eliminada correctamente`, '🗑️');
        applyFilters();
      } catch (err) {
        console.error('Error al eliminar actividad:', err);
        closeDeleteModal();
        showToast('Error al eliminar la actividad', '❌');
      }
    });

    // ── 9. Botón Crear Actividad (Integración con Paso 3) ──
    function triggerCreateModal() {
      // Notificar al componente modal (Paso 3) con la categoría activa
      window.dispatchEvent(
        new CustomEvent('open-activity-modal', {
          detail: {
            mode: 'create',
            category: activeCategory !== 'todas' ? activeCategory : 'ciclos-cine',
          },
        })
      );
      showToast(`Preparando formulario para: ${categoryNames[activeCategory] || 'Actividad'}`, '📝');
    }

    openCreateBtn?.addEventListener('click', triggerCreateModal);
    emptyCreateBtn?.addEventListener('click', triggerCreateModal);

    // ── 10. Botones Editar (Integración con Paso 3) ──
    document.querySelectorAll('.edit-activity-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const id = btn.getAttribute('data-id');
        const slug = btn.getAttribute('data-slug');
        const cat = btn.getAttribute('data-category');

        window.dispatchEvent(
          new CustomEvent('open-activity-modal', {
            detail: {
              mode: 'edit',
              id,
              slug,
              category: cat,
            },
          })
        );
        showToast(`Cargando editor para: /${slug}`, '✏️');
      });
    });

    // ── 11. Toast Utility ──
    function showToast(message, icon = '✨') {
      const toast = document.getElementById('adminToast');
      const msgEl = document.getElementById('toastMessage');
      const iconEl = document.getElementById('toastIcon');

      if (!toast || !msgEl) return;
      msgEl.textContent = message;
      if (iconEl) iconEl.textContent = icon;

      toast.classList.remove('translate-y-16', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.add('translate-y-16', 'opacity-0', 'pointer-events-none');
        toast.classList.remove('translate-y-0', 'opacity-100');
      }, 3000);
    }

    // Exponer globalmente para el modal de edición
    window.__showAdminToast = showToast;

    // Fallback de imágenes que fallen
    document.querySelectorAll('.activity-cover-img').forEach((img) => {
      img.addEventListener('error', () => {
        img.setAttribute('src', '/assets/logo/870.jpeg');
      });
    });

    // Inicializar filtros con el estado actual
    applyFilters();
  });
</script>

