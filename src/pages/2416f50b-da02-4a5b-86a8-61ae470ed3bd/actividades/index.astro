        </div>
      </div>

      <!-- Encuentros -->
      <div class="bg-white dark:bg-[#181818] p-3.5 rounded-2xl border border-[#E5DFD5] dark:border-[#282828] shadow-xs">
        <span class="text-[10px] font-bold uppercase tracking-wider text-[#78716A] dark:text-neutral-300 block">🗣️ Encuentros</span>
        <div class="flex items-baseline justify-between mt-1">
          <span class="text-2xl font-black text-[#1F1B16] dark:text-white">{counts.encuentros}</span>
          <span class="w-2 h-2 rounded-full bg-neutral-400"></span>
        </div>
      </div>

      <!-- Estado: Publicadas -->
      <div class="bg-white dark:bg-[#181818] p-3.5 rounded-2xl border border-[#E5DFD5] dark:border-[#282828] shadow-xs">
        <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 block">Publicadas</span>
        <div class="flex items-baseline justify-between mt-1">
          <span class="text-2xl font-black text-emerald-600 dark:text-emerald-400">{counts.publicadas}</span>
          <span class="text-[10px] font-medium text-[#78716A] dark:text-neutral-400 font-mono">
            {counts.borradores} borrador
          </span>
        </div>
      </div>
    </div>

    <!-- ── SISTEMA DE TOGGLES / PESTAÑAS POR CATEGORÍA ── -->
    <div class="bg-white dark:bg-[#181818] rounded-2xl border border-[#E5DFD5] dark:border-[#282828] p-2.5 sm:p-3 shadow-xs">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">

        <!-- Tabs de Categoría -->
        <div 
          class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5" 
          id="activityCategoryTabs" 
          role="tablist"
          aria-label="Filtrar actividades por categoría"
        >
          <!-- Tab: Todas -->
          <button
            type="button"
            role="tab"
            data-tab="todas"
            aria-selected={activeCategoryParam === 'todas' ? 'true' : 'false'}
            class={`category-tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer select-none shrink-0 border ${
              activeCategoryParam === 'todas'
                ? 'bg-[#1F1B16] text-white border-[#1F1B16] dark:bg-white dark:text-[#141414] dark:border-white shadow-xs'
