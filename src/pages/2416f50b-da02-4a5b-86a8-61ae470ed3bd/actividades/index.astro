          </button>

          <!-- Tab: Ciclos de Cine -->
          <button
            type="button"
            role="tab"
            data-tab="ciclos-cine"
            aria-selected={activeCategoryParam === 'ciclos-cine' ? 'true' : 'false'}
            class={`category-tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer select-none shrink-0 border ${
              activeCategoryParam === 'ciclos-cine'
                ? 'bg-[#E4572E] text-white border-[#E4572E] shadow-xs'
