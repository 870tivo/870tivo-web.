---
/**
 * src/pages/2416f50b-da02-4a5b-86a8-61ae470ed3bd/actividades/index.astro
 * (src/pages/admin/actividades/index.astro)
 * 
 * Módulo de Administración de Actividades y Eventos Culturales (870tivo Control Studio).
 * 
 * Características:
 * - Sistema de pestañas/toggles interactivos para las 4 categorías oficiales:
 *   Ciclos de Cine, Club de Lectura, Talleres y Encuentros (+ opción Todas).
 * - Sincronización fluida con query params de la URL (?categoria=...).
 * - Métricas y KPIs editoriales en tiempo real.
 * - Doble visualización: Tabla editorial responsiva y Grilla de afiches en proporción 16:10.
 * - Acciones rápidas: Editar, Eliminar (con modal de confirmación), Toggle de publicación y Enlace al portal público.
 * - Búsqueda server-side y filtrado client-side reactivo sin recarga obligatoria.
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';
import Button from '../../../components/common/Button.astro';
import ActivityEditorModal from '../../../components/admin/ActivityEditorModal.astro';
import { supabaseAdmin } from '../../../lib/supabase';
import { hasPermission } from '../../../lib/auth';
import type { ActivityRow } from '../../../types/database';
import { ACTIVITY_CATEGORIES } from '../../../types/database';

export const prerender = false;

// 1. Verificación de sesión de usuario en SSR
const user = Astro.locals.user;
if (!user?.id) {
  return Astro.redirect('/2416f50b-da02-4a5b-86a8-61ae470ed3bd/login?redirect=/2416f50b-da02-4a5b-86a8-61ae470ed3bd/actividades');
}

// 2. Verificación de permisos del módulo
const canCreate = await hasPermission(user.id, 'actividades', 'create');
const canUpdate = await hasPermission(user.id, 'actividades', 'update');
const canDelete = await hasPermission(user.id, 'actividades', 'delete');

// 3. Parámetros de URL para SSR
const activeCategoryParam = (Astro.url.searchParams.get('categoria') || Astro.url.searchParams.get('category') || 'todas').toLowerCase();
const searchQuery = (Astro.url.searchParams.get('search') || Astro.url.searchParams.get('q') || '').trim();
const statusFilter = (Astro.url.searchParams.get('status') || 'all').trim().toLowerCase();

// 4. Semillas de respaldo (Fallback) en caso de que la tabla aún esté en proceso de migración o vacía
const FALLBACK_ACTIVITIES: ActivityRow[] = [
  {
    id: 'seed-cine-1',
    slug: 'ciclo-cine-la-vendedora-de-rosas',
    title: 'Ciclo de Cine Colombiano: La Vendedora de Rosas',
    category: 'ciclos-cine',
    description: 'Proyección especial y conversatorio alrededor de la obra icónica de Víctor Gaviria y el neorrealismo urbano.',
    content: 'En este encuentro nos sumergiremos en las calles de Medellín a través de la mirada descarnada y poética de Víctor Gaviria.',
    event_date: new Date(Date.now() + 5 * 24 * 60 * 60 * 1000).toISOString(),
    location: 'Sala Audiovisual 870tivo',
    cover_url: '/assets/logo/870.jpeg',
    status: 'publicado',
    is_published: true,
    tags: ['Cine', 'Colombia', 'Neorrealismo', 'Víctor Gaviria'],
    metadata: {
      director: 'Víctor Gaviria',
      release_year: 1998,
      duration_min: 120,
      country: 'Colombia',
      trailer_url: 'https://youtube.com',
    },
    created_at: new Date(Date.now() - 3 * 24 * 60 * 60 * 1000).toISOString(),
    updated_at: new Date(Date.now() - 3 * 24 * 60 * 60 * 1000).toISOString(),
  },
  {
    id: 'seed-club-1',
    slug: 'club-lectura-voces-memoria',
    title: 'Club de Lectura: Voces de la Memoria y la Ficción',
    category: 'club-lectura',
    description: 'Lecturas y diálogos literarios en torno a relatos contemporáneos y narrativas territoriales.',
    content: 'Una tarde dedicada a desmenuzar las páginas de la literatura latinoamericana reciente.',
    event_date: new Date(Date.now() + 10 * 24 * 60 * 60 * 1000).toISOString(),
    location: 'Biblioteca Comunitaria 870',
    cover_url: '/assets/logo/870.jpeg',
    status: 'publicado',
    is_published: true,
    tags: ['Literatura', 'Memoria', 'Crónica', 'Latinoamérica'],
    metadata: {
      book_title: 'Relato de un Náufrago / Crónicas Urbanas',
      book_author: 'Varios Autores',
      assigned_readings: 'Capítulos 1 a 4 y ensayo introductorio',
    },
    created_at: new Date(Date.now() - 6 * 24 * 60 * 60 * 1000).toISOString(),
    updated_at: new Date(Date.now() - 6 * 24 * 60 * 60 * 1000).toISOString(),
  },
  {
    id: 'seed-taller-1',
    slug: 'taller-serigrafia-cartelismo',
    title: 'Taller Práctico: Serigrafía y Cartelismo Popular',
    category: 'talleres',
    description: 'Formación creativa y técnica en artes gráficas, grabado artesanal e intervención visual urbana.',
    content: 'Aprende los fundamentos de la serigrafía tradicional, desde el tensado y preparación de mallas.',
    event_date: new Date(Date.now() + 14 * 24 * 60 * 60 * 1000).toISOString(),
    location: 'Taller de Artes Gráficas 870',
    cover_url: '/assets/logo/870.jpeg',
    status: 'borrador',
    is_published: false,
    tags: ['Serigrafía', 'Grabado', 'Gráfica Popular', 'Técnica'],
    metadata: {
      facilitator: 'Colectivo Gráfico 870',
      level: 'Principiante',
      materials: 'Mallas serigráficas, tintas al agua y papel 220g incluidos',
      capacity: 15,
    },
    created_at: new Date(Date.now() - 8 * 24 * 60 * 60 * 1000).toISOString(),
    updated_at: new Date(Date.now() - 8 * 24 * 60 * 60 * 1000).toISOString(),
  },
  {
    id: 'seed-encuentro-1',
    slug: 'encuentro-dialogos-inmateriales',
    title: 'Encuentro Abierto: Diálogos Inmateriales y Noche Acústica',
    category: 'encuentros',
    description: 'Jornada interdisciplinar con fanzines independientes, lecturas poéticas y música en vivo.',
    content: 'Un espacio de intercambio libre para artistas, creadores y público general.',
    event_date: new Date(Date.now() + 21 * 24 * 60 * 60 * 1000).toISOString(),
    location: 'Patio Central 870tivo',
    cover_url: '/assets/logo/870.jpeg',
    status: 'publicado',
    is_published: true,
    tags: ['Fanzine', 'Poesía', 'Música Acústica', 'Feria'],
    metadata: {
      guests: 'Editores independientes invitados y cantautores locales',
      event_format: 'Feria de autoedición, micrófono abierto y concierto acústico',
    },
    created_at: new Date(Date.now() - 12 * 24 * 60 * 60 * 1000).toISOString(),
    updated_at: new Date(Date.now() - 12 * 24 * 60 * 60 * 1000).toISOString(),
  },
];

// 5. Consulta principal a Supabase
let activities: ActivityRow[] = [];
let allActivities: ActivityRow[] = [];

try {
  // Consulta de todos los registros para estadísticas y conteos exactos por pestaña
  const { data: allData, error: allError } = await supabaseAdmin
    .from('activities')
    .select('*')
    .order('event_date', { ascending: true });

  if (allError) {
    console.warn('Aviso al consultar activities en Supabase:', allError.message);
    allActivities = FALLBACK_ACTIVITIES;
  } else if (allData && allData.length > 0) {
    allActivities = allData as ActivityRow[];
  } else {
    allActivities = FALLBACK_ACTIVITIES;
  }

  // Filtrado inicial para SSR
  activities = allActivities.filter((act) => {
    // Filtro por categoría
    if (activeCategoryParam !== 'todas' && act.category !== activeCategoryParam) {
      return false;
    }
    // Filtro por búsqueda
    if (searchQuery) {
      const q = searchQuery.toLowerCase();
      const matchTitle = act.title.toLowerCase().includes(q);
      const matchLoc = act.location.toLowerCase().includes(q);
      const matchSlug = act.slug.toLowerCase().includes(q);
      if (!matchTitle && !matchLoc && !matchSlug) return false;
    }
    // Filtro por estado
    if (statusFilter === 'publicado' && act.status !== 'publicado') return false;
    if (statusFilter === 'borrador' && act.status !== 'borrador') return false;
    if (statusFilter === 'archivado' && act.status !== 'archivado') return false;

    return true;
  });

} catch (err: any) {
  console.error('Excepción al conectar con Supabase en /admin/actividades:', err);
  allActivities = FALLBACK_ACTIVITIES;
  activities = FALLBACK_ACTIVITIES;
}

// 6. Conteo por categorías para los badges de las pestañas
const counts = {
  todas: allActivities.length,
  'ciclos-cine': allActivities.filter((a) => a.category === 'ciclos-cine').length,
  'club-lectura': allActivities.filter((a) => a.category === 'club-lectura').length,
  talleres: allActivities.filter((a) => a.category === 'talleres').length,
  encuentros: allActivities.filter((a) => a.category === 'encuentros').length,
  publicadas: allActivities.filter((a) => a.is_published || a.status === 'publicado').length,
  borradores: allActivities.filter((a) => !a.is_published || a.status === 'borrador').length,
};

// 7. Formateador de fecha y hora en español
function formatDateTime(dateStr: string) {
  try {
    const d = new Date(dateStr);
    return new Intl.DateTimeFormat('es-CO', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      hour12: true,
    }).format(d);
  } catch {
    return dateStr;
  }
}

// Determinar si una fecha ya pasó
function isPastEvent(dateStr: string) {
  try {
    return new Date(dateStr).getTime() < Date.now();
  } catch {
    return false;
  }
}
---

<AdminLayout
  title="Gestión de Actividades y Eventos | 870tivo Control Studio"
  headerTitle="Actividades & Agenda Cultural"
  activeModule="actividades"
>
  <div class="space-y-6">

    <!-- ── CABECERA PRINCIPAL & ACCIONES ── -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="text-[11px] uppercase font-bold tracking-widest text-[#E4572E]">
            Agenda & Programación Cultural
          </span>
          <span class="text-xs px-2.5 py-0.5 rounded-full bg-white dark:bg-[#1E1E1E] border border-[#E5DFD5] dark:border-[#282828] text-[#1F1B16] dark:text-[#FAF6F0] font-semibold">
            {allActivities.length} Eventos en Base
          </span>
          <span class="text-xs px-2.5 py-0.5 rounded-full bg-[#2F4B3A]/10 dark:bg-[#2F4B3A]/25 border border-[#2F4B3A]/30 text-[#2F4B3A] dark:text-[#A7C7B3] font-medium">
            Storage: activities (16:10)
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-extrabold text-[#1F1B16] dark:text-white tracking-tight">
          Gestión de Actividades Culturales
        </h1>
        <p class="text-xs sm:text-sm text-[#78716A] dark:text-neutral-400 mt-1 max-w-3xl leading-relaxed">
          Programa y administra proyecciones, sesiones de lectura, talleres prácticos y encuentros comunitarios. Carga afiches con relación de aspecto 16:10 y sincroniza la visibilidad en el portal público de 870tivo.
        </p>
      </div>

      <!-- Acciones de Cabecera -->
      <div class="flex flex-wrap items-center gap-2.5 shrink-0">
        <!-- Ver Portal Público -->
        <a
          href="/actividades"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white dark:bg-[#181818] hover:bg-[#FAF6F0] dark:hover:bg-[#222222] text-[#1F1B16] dark:text-[#FAF6F0] hover:text-[#E4572E] border border-[#E5DFD5] dark:border-[#282828] text-xs font-semibold transition-all shadow-xs"
        >
          <span>Ver Agenda Pública</span>
          <svg class="w-3.5 h-3.5 text-[#78716A] dark:text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>

        <!-- Botón Nueva Actividad -->
        {canCreate && (
          <Button
            variant="primary"
            id="openCreateActivityBtn"
            size="md"
            class="shadow-sm"
          >
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
            </svg>
            <span id="createBtnText">Nueva Actividad</span>
          </Button>
        )}
      </div>
    </div>

    <!-- ── MÉTRICAS Y KPIS EDITORIALES ── -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      <!-- Total -->
      <div class="bg-white dark:bg-[#181818] p-3.5 rounded-2xl border border-[#E5DFD5] dark:border-[#282828] shadow-xs">
        <span class="text-[10px] font-bold uppercase tracking-wider text-[#78716A] dark:text-neutral-400 block">Total</span>
        <div class="flex items-baseline justify-between mt-1">
          <span class="text-2xl font-black text-[#1F1B16] dark:text-white">{counts.todas}</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 font-mono">100%</span>
        </div>
      </div>

      <!-- Ciclos Cine -->
      <div class="bg-white dark:bg-[#181818] p-3.5 rounded-2xl border border-[#E5DFD5] dark:border-[#282828] shadow-xs">
        <span class="text-[10px] font-bold uppercase tracking-wider text-[#E4572E] block">🎬 Cine</span>
        <div class="flex items-baseline justify-between mt-1">
          <span class="text-2xl font-black text-[#1F1B16] dark:text-white">{counts['ciclos-cine']}</span>
          <span class="w-2 h-2 rounded-full bg-[#E4572E]"></span>
        </div>
      </div>

      <!-- Club Lectura -->
      <div class="bg-white dark:bg-[#181818] p-3.5 rounded-2xl border border-[#E5DFD5] dark:border-[#282828] shadow-xs">
        <span class="text-[10px] font-bold uppercase tracking-wider text-[#2F4B3A] dark:text-[#A7C7B3] block">📚 Lectura</span>
        <div class="flex items-baseline justify-between mt-1">
          <span class="text-2xl font-black text-[#1F1B16] dark:text-white">{counts['club-lectura']}</span>
          <span class="w-2 h-2 rounded-full bg-[#2F4B3A]"></span>
        </div>
      </div>

      <!-- Talleres -->
      <div class="bg-white dark:bg-[#181818] p-3.5 rounded-2xl border border-[#E5DFD5] dark:border-[#282828] shadow-xs">
