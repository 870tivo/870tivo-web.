---
import '../../styles/global.css';
import ThemeToggle from '../../components/common/ThemeToggle';

const title = 'Restablecer Contraseña | Galería 870 - Administración';
const fontsUrl = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap';
---

<!doctype html>
<html lang="es" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Establece una nueva contraseña para la administración de Galería 870" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontsUrl} rel="stylesheet" />

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'dark';
      })();

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>

  <body class="min-h-screen bg-brand-bg text-brand-ink dark:bg-brand-ink dark:text-brand-darkInk font-sans antialiased flex flex-col justify-between selection:bg-brand-orange selection:text-white transition-colors duration-200">
    
    <!-- Top Utility Bar -->
    <header class="w-full px-6 py-4 flex items-center justify-between">
      <a href="/admin/login" class="flex items-center gap-2 text-xs uppercase tracking-widest text-brand-muted hover:text-brand-orange dark:hover:text-brand-bg transition-colors font-medium">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Ir a iniciar sesión</span>
      </a>

      <div class="flex items-center gap-3">
        <ThemeToggle client:load />
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 flex items-center justify-center px-4 py-8">
      <div class="w-full max-w-md">
        
        <!-- Main Card -->
        <div class="bg-brand-card/70 dark:bg-brand-darkCard border border-brand-ink/10 dark:border-brand-darkCard/80 rounded-2xl p-8 sm:p-10 shadow-xl backdrop-blur-sm transition-all duration-300">
          
          <!-- Logo & Header -->
          <div class="text-center mb-8">
            <div class="inline-block relative mb-4">
              <img 
                src="/assets/logo/870.jpeg" 
                alt="Galería 870" 
                class="w-16 h-16 object-cover rounded-xl shadow-md mx-auto border border-brand-ink/10 dark:border-white/10"
              />
            </div>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-brand-ink dark:text-brand-darkInk">
              Nueva Contraseña
            </h1>
            <p class="text-xs uppercase tracking-widest text-brand-orange dark:text-brand-bg font-semibold mt-1">
              Galería 870
            </p>
            <p class="text-xs text-brand-muted mt-2">
              Ingresa y confirma tu nueva credencial de acceso
            </p>
          </div>

          <!-- Invalid/Expired Link Alert -->
          <div id="invalidSessionAlert" class="hidden mb-6 p-4 rounded-xl text-sm bg-amber-500/10 border border-amber-500/30 text-amber-800 dark:text-amber-300">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div class="flex-1 space-y-2">
                <p class="font-medium">Enlace de recuperación no detectado o expirado</p>
                <p class="text-xs opacity-90">
                  Para actualizar tu contraseña, debes acceder usando el enlace que recibiste en tu correo electrónico.
                </p>
                <a 
                  href="/admin/forgot-password" 
                  class="inline-block mt-1 text-xs font-semibold underline hover:text-brand-orange transition-colors"
                >
                  Solicitar un nuevo enlace &rarr;
                </a>
              </div>
            </div>
          </div>

          <!-- Error Alert Banner -->
          <div id="errorAlert" class="hidden mb-6 p-4 rounded-xl text-sm bg-red-500/10 border border-red-500/30 text-red-700 dark:text-red-400">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div class="flex-1">
                <p id="errorMessage" class="font-medium">Error al actualizar la contraseña</p>
              </div>
            </div>
          </div>

          <!-- Success State -->
          <div id="successContainer" class="hidden space-y-6">
            <div class="p-5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-800 dark:text-emerald-300">
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="space-y-1">
                  <h3 class="font-semibold text-sm">¡Contraseña actualizada con éxito!</h3>
                  <p class="text-xs opacity-90 leading-relaxed">
                    Tu contraseña ha sido restablecida de forma segura. Redirigiendo al panel de administración...
                  </p>
                </div>
              </div>
            </div>

            <a 
              href="/admin/dashboard" 
              class="block w-full py-3.5 px-4 rounded-xl text-center text-sm font-medium text-white bg-brand-ink dark:bg-brand-orange hover:bg-brand-ink/90 dark:hover:bg-brand-orange/90 transition-all shadow-md"
            >
              Ir al Panel de Administración
            </a>
          </div>

          <!-- Reset Password Form -->
          <form id="resetForm" class="space-y-5" novalidate>
            <div>
              <label for="newPassword" class="block text-xs font-semibold uppercase tracking-wider text-brand-ink/80 dark:text-brand-darkInk/80 mb-2">
                Nueva Contraseña
              </label>
              <div class="relative">
                <input 
                  type="password" 
                  id="newPassword" 
                  name="newPassword" 
                  required 
                  minlength="6"
                  autocomplete="new-password"
                  placeholder="Mínimo 6 caracteres" 
                  class="w-full px-4 py-3 pr-11 text-sm rounded-xl bg-white/70 dark:bg-brand-ink/60 border border-brand-ink/15 dark:border-brand-darkCard/80 text-brand-ink dark:text-brand-darkInk placeholder:text-brand-muted/70 focus:outline-none focus:ring-2 focus:ring-brand-orange dark:focus:ring-brand-yellow focus:border-transparent transition-all"
                />
                <button 
                  type="button" 
                  id="toggleNewPassword" 
                  aria-label="Mostrar u ocultar contraseña"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-brand-muted hover:text-brand-ink dark:hover:text-brand-darkInk transition-colors p-1"
                >
                  <svg id="eyeIcon1" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  <svg id="eyeOffIcon1" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a10.059 10.059 0 013.999-5.325m3.543-1.425A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.05 10.05 0 01-4.132 5.411m0 0L21 21M3 3l18 18" />
                  </svg>
                </button>
              </div>
            </div>

            <div>
              <label for="confirmPassword" class="block text-xs font-semibold uppercase tracking-wider text-brand-ink/80 dark:text-brand-darkInk/80 mb-2">
                Confirmar Nueva Contraseña
              </label>
              <div class="relative">
                <input 
                  type="password" 
                  id="confirmPassword" 
                  name="confirmPassword" 
                  required 
                  minlength="6"
                  autocomplete="new-password"
                  placeholder="Repite la nueva contraseña" 
                  class="w-full px-4 py-3 pr-11 text-sm rounded-xl bg-white/70 dark:bg-brand-ink/60 border border-brand-ink/15 dark:border-brand-darkCard/80 text-brand-ink dark:text-brand-darkInk placeholder:text-brand-muted/70 focus:outline-none focus:ring-2 focus:ring-brand-orange dark:focus:ring-brand-yellow focus:border-transparent transition-all"
                />
                <button 
                  type="button" 
                  id="toggleConfirmPassword" 
                  aria-label="Mostrar u ocultar contraseña"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-brand-muted hover:text-brand-ink dark:hover:text-brand-darkInk transition-colors p-1"
                >
                  <svg id="eyeIcon2" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  <svg id="eyeOffIcon2" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a10.059 10.059 0 013.999-5.325m3.543-1.425A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.05 10.05 0 01-4.132 5.411m0 0L21 21M3 3l18 18" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              id="submitBtn" 
              class="w-full py-3.5 px-6 rounded-xl font-medium text-sm tracking-wide text-white bg-brand-ink dark:bg-brand-orange hover:bg-brand-ink/90 dark:hover:bg-brand-orange/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-orange dark:focus:ring-brand-yellow shadow-md hover:shadow-lg active:scale-[0.99] transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer mt-2"
            >
              <span id="btnText">Actualizar Contraseña</span>
              <svg id="btnSpinner" class="hidden animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </form>

        </div>

        <p class="text-center text-xs text-brand-muted mt-6">
          870tivo &mdash; Actualización Segura de Contraseña
        </p>

      </div>
    </main>

    <footer class="py-4 text-center text-xs text-brand-muted/70">
      &copy; {new Date().getFullYear()} Galería 870. Todos los derechos reservados.
    </footer>

    <!-- Client-side Password Update Script -->
    <script>
      import { supabase, setAuthCookies } from '../../lib/supabase';

      const resetForm = document.getElementById('resetForm') as HTMLFormElement | null;
      const newPasswordInput = document.getElementById('newPassword') as HTMLInputElement | null;
      const confirmPasswordInput = document.getElementById('confirmPassword') as HTMLInputElement | null;
      const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
      const btnText = document.getElementById('btnText');
      const btnSpinner = document.getElementById('btnSpinner');
      const errorAlert = document.getElementById('errorAlert');
      const errorMessage = document.getElementById('errorMessage');
      const successContainer = document.getElementById('successContainer');
      const invalidSessionAlert = document.getElementById('invalidSessionAlert');

      // Toggles
      const toggleNewPassword = document.getElementById('toggleNewPassword');
      const eyeIcon1 = document.getElementById('eyeIcon1');
      const eyeOffIcon1 = document.getElementById('eyeOffIcon1');

      const toggleConfirmPassword = document.getElementById('toggleConfirmPassword');
      const eyeIcon2 = document.getElementById('eyeIcon2');
      const eyeOffIcon2 = document.getElementById('eyeOffIcon2');

      toggleNewPassword?.addEventListener('click', () => {
        if (!newPasswordInput) return;
        const isPassword = newPasswordInput.type === 'password';
        newPasswordInput.type = isPassword ? 'text' : 'password';
        eyeIcon1?.classList.toggle('hidden', isPassword);
        eyeOffIcon1?.classList.toggle('hidden', !isPassword);
      });

      toggleConfirmPassword?.addEventListener('click', () => {
        if (!confirmPasswordInput) return;
        const isPassword = confirmPasswordInput.type === 'password';
        confirmPasswordInput.type = isPassword ? 'text' : 'password';
        eyeIcon2?.classList.toggle('hidden', isPassword);
        eyeOffIcon2?.classList.toggle('hidden', !isPassword);
      });

      function showError(msg: string) {
        if (errorMessage) errorMessage.textContent = msg;
        if (errorAlert) errorAlert.classList.remove('hidden');
      }

      function hideError() {
        if (errorAlert) errorAlert.classList.add('hidden');
      }

      function setLoading(loading: boolean) {
        if (!submitBtn) return;
        submitBtn.disabled = loading;
        if (loading) {
          btnText?.classList.add('opacity-80');
          if (btnText) btnText.textContent = 'Actualizando...';
          btnSpinner?.classList.remove('hidden');
        } else {
          btnText?.classList.remove('opacity-80');
          if (btnText) btnText.textContent = 'Actualizar Contraseña';
          btnSpinner?.classList.add('hidden');
        }
      }

      // Check recovery session
      let hasValidSession = false;

      // Listen for PASSWORD_RECOVERY event or check existing session
      supabase.auth.onAuthStateChange(async (event, session) => {
        if (event === 'PASSWORD_RECOVERY' || (session && event === 'SIGNED_IN')) {
          hasValidSession = true;
          invalidSessionAlert?.classList.add('hidden');
          if (session) setAuthCookies(session);
        }
      });

      // Verification fallback
      setTimeout(async () => {
        const { data: { session } } = await supabase.auth.getSession();
        const hash = window.location.hash;
        const hasHashParams = hash && (hash.includes('access_token') || hash.includes('type=recovery'));
        const hasCodeParam = new URLSearchParams(window.location.search).has('code');

        if (session || hasHashParams || hasCodeParam) {
          hasValidSession = true;
          invalidSessionAlert?.classList.add('hidden');
          if (session) setAuthCookies(session);
        } else if (!hasValidSession) {
          invalidSessionAlert?.classList.remove('hidden');
        }
      }, 700);

      resetForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideError();

        const newPassword = newPasswordInput?.value;
        const confirmPassword = confirmPasswordInput?.value;

        if (!newPassword || !confirmPassword) {
          showError('Por favor complete todos los campos.');
          return;
        }

        if (newPassword.length < 6) {
          showError('La contraseña debe tener al menos 6 caracteres.');
          return;
        }

        if (newPassword !== confirmPassword) {
          showError('Las contraseñas no coinciden. Por favor verifíquelas.');
          return;
        }

        setLoading(true);

        try {
          const { error } = await supabase.auth.updateUser({
            password: newPassword,
          });

          if (error) {
            let friendlyMsg = 'No se pudo actualizar la contraseña.';
            if (error.message.includes('same_password') || error.message.includes('different from the old password')) {
              friendlyMsg = 'La nueva contraseña debe ser diferente de la anterior.';
            } else if (error.message.includes('Auth session missing') || error.message.includes('jwt')) {
              friendlyMsg = 'El enlace de recuperación ha expirado o no es válido. Por favor solicita uno nuevo.';
            } else if (error.message) {
              friendlyMsg = error.message;
            }
            showError(friendlyMsg);
            setLoading(false);
            return;
          }

          // If session is present or updated, synchronize cookies
          const { data: sessionData } = await supabase.auth.getSession();
          if (sessionData.session) {
            setAuthCookies(sessionData.session);
          }

          resetForm.classList.add('hidden');
          successContainer?.classList.remove('hidden');

          // Automatic redirect to admin dashboard after short delay
          setTimeout(() => {
            window.location.href = '/admin/dashboard';
          }, 1500);

        } catch (err: any) {
          console.error('Error updating password:', err);
          showError('Ocurrió un error inesperado al actualizar la contraseña.');
          setLoading(false);
        }
      });
    </script>
  </body>
</html>
