---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { posts } from '../../lib/posts';
import Card from '../../components/common/Card.astro';
import Button from '../../components/common/Button.astro';

// Server-side authentication context
const user = Astro.locals.user;
const userEmail = user?.email || 'Administrador';

const errorParam = Astro.url.searchParams.get('error');
const messageParam = Astro.url.searchParams.get('message') || 'Acceso restringido: Se requieren privilegios de Administrador para acceder a esta sección.';

const totalPosts = posts.length;
---

<AdminLayout 
  title="Dashboard Principal | 870tivo Control Studio" 
  headerTitle="Dashboard & Vista General"
  activeModule="dashboard"
>
  {errorParam === 'access_denied' && (
    <div 
      role="alert" 
      class="mb-6 p-4 rounded-2xl bg-amber-500/10 dark:bg-amber-500/15 border border-amber-500/30 text-amber-800 dark:text-amber-200 flex items-start gap-3 shadow-sm animate-fade-in"
    >
      <svg class="w-5 h-5 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <div class="flex-1">
        <p class="font-semibold text-sm">Privilegios Insuficientes</p>
        <p class="text-xs sm:text-sm mt-0.5 opacity-90">{messageParam}</p>
      </div>
    </div>
  )}

  <!-- Welcome Hero Banner -->
  <section class="relative overflow-hidden rounded-3xl bg-white dark:bg-[#141414] border border-[#E5DFD5] dark:border-[#282828] p-6 sm:p-8 lg:p-10 shadow-sm mb-8 sm:mb-10 transition-colors duration-200">
    <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-editorial-primary/10 border border-editorial-primary/25 text-editorial-primary text-xs font-semibold mb-3">
          <span class="w-2 h-2 rounded-full bg-editorial-primary animate-pulse"></span>
          Sistema de Administración 870tivo
        </div>
        <h1 class="text-2xl sm:text-4xl font-bold text-[#1F1B16] dark:text-white tracking-tight leading-tight font-serif">
          Hola, <span class="text-editorial-primary font-serif">{userEmail.split('@')[0]}</span> 👋
        </h1>
        <p class="text-[#78716A] dark:text-slate-300 text-sm sm:text-base mt-2.5 leading-relaxed font-normal">
          Bienvenido al centro de mando administrativo. Desde aquí puedes supervisar todas las secciones de tu página web y gestionar directamente el módulo de publicaciones editoriales.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <Button 
          href="/admin/publicaciones" 
          variant="primary"
          size="md"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          <span>Publicaciones</span>
        </Button>

        <Button 
          href="/admin/usuarios" 
          variant="secondary"
          size="md"
        >
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span>Usuarios</span>
        </Button>

        <Button 
          href="/admin/roles" 
          variant="secondary"
          size="md"
        >
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Roles</span>
        </Button>

        <Button 
          href="/" 
          target="_blank"
          variant="ghost"
          size="md"
        >
          <span>Sitio Web</span>
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </Button>
      </div>
    </div>
  </section>

  <!-- Metric Quick Cards -->
  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-10">
    
    <!-- Stat 1: Publicaciones -->
    <a href="/admin/publicaciones" class="group block">
      <Card variant="interactive" class="p-5">
        <div class="flex items-center justify-between mb-3">
          <span class="p-2.5 rounded-xl bg-editorial-primary/10 text-editorial-primary group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
          </span>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[#FAF6F0] dark:bg-[#1F1F1F] text-[#1F1B16] dark:text-slate-300 border border-[#E5DFD5] dark:border-[#282828]">
            Editorial
          </span>
        </div>
        <div class="text-2xl font-bold font-serif text-[#1F1B16] dark:text-white tracking-tight">{totalPosts}</div>
        <div class="text-xs text-[#78716A] dark:text-slate-400 font-medium mt-1">Publicaciones Registradas</div>
        <div class="text-[11px] text-editorial-primary mt-2 font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
          <span>Gestionar artículos</span> &rarr;
        </div>
      </Card>
    </a>

    <!-- Stat 2: Usuarios -->
    <a href="/admin/usuarios" class="group block">
      <Card variant="interactive" class="p-5">
        <div class="flex items-center justify-between mb-3">
          <span class="p-2.5 rounded-xl bg-editorial-forest/30 text-[#2F4B3A] dark:text-emerald-400 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </span>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[#FAF6F0] dark:bg-[#1F1F1F] text-[#1F1B16] dark:text-slate-300 border border-[#E5DFD5] dark:border-[#282828]">
            Cuentas
          </span>
        </div>
        <div class="text-2xl font-bold font-serif text-[#1F1B16] dark:text-white tracking-tight">Usuarios</div>
        <div class="text-xs text-[#78716A] dark:text-slate-400 font-medium mt-1">Miembros del Sistema</div>
        <div class="text-[11px] text-editorial-primary mt-2 font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
          <span>Gestionar cuentas</span> &rarr;
        </div>
      </Card>
    </a>

    <!-- Stat 3: Roles & Permisos -->
    <a href="/admin/roles" class="group block">
      <Card variant="interactive" class="p-5">
        <div class="flex items-center justify-between mb-3">
          <span class="p-2.5 rounded-xl bg-editorial-accent/20 text-editorial-accent group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </span>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[#FAF6F0] dark:bg-[#1F1F1F] text-[#1F1B16] dark:text-slate-300 border border-[#E5DFD5] dark:border-[#282828]">
            Control
          </span>
        </div>
        <div class="text-2xl font-bold font-serif text-[#1F1B16] dark:text-white tracking-tight">Roles</div>
        <div class="text-xs text-[#78716A] dark:text-slate-400 font-medium mt-1">Matriz de Acceso</div>
        <div class="text-[11px] text-editorial-primary mt-2 font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
          <span>Configurar permisos</span> &rarr;
        </div>
      </Card>
    </a>

    <!-- Stat 4: Despliegue & Servidor -->
    <Card variant="default" class="p-5">
      <div class="flex items-center justify-between mb-3">
        <span class="p-2.5 rounded-xl bg-editorial-forest/30 text-[#2F4B3A] dark:text-emerald-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </span>
        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-editorial-forest/30 text-[#2F4B3A] dark:text-emerald-300 border border-editorial-forest/50">
          Seguro
        </span>
      </div>
      <div class="text-2xl font-bold font-serif text-[#1F1B16] dark:text-white tracking-tight">Privado</div>
      <div class="text-xs text-[#78716A] dark:text-slate-400 font-medium mt-1">Supabase SSR Guard</div>
      <div class="text-[11px] text-[#2F4B3A] dark:text-emerald-400 mt-2 font-medium">Sesión activa protegida</div>
    </Card>

  </section>
  <!-- SECCIÓN CENTRAL: Todas las Secciones de la Página Web -->
  <section class="mb-10">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs uppercase font-bold tracking-widest text-editorial-primary">Mapa del Sistema</span>
          <span class="text-xs px-2 py-0.5 rounded-full bg-[#FAF6F0] dark:bg-[#1F1F1F] text-[#1F1B16] dark:text-slate-300 font-medium border border-[#E5DFD5] dark:border-[#282828]">5 Secciones</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-[#1F1B16] dark:text-white tracking-tight font-serif mt-1">
          Todas las Secciones de tu Página Web
        </h2>
        <p class="text-xs sm:text-sm text-[#78716A] dark:text-slate-400 mt-1">
          Aquí tienes una vista panorámica de todas las áreas que componen Galería 870tivo y el estado de su módulo administrativo.
        </p>
      </div>
    </div>

    <!-- Grid of All Website Sections -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- 1. MÓDULO PUBLICACIONES (ACTIVO) -->
      <Card variant="default" class="relative p-6 flex flex-col justify-between group border-[#282828] hover:border-editorial-primary/50 transition-colors">
        <div class="absolute -top-3 right-6 px-3 py-0.5 rounded-full bg-editorial-primary text-white text-[10px] font-bold tracking-wider uppercase shadow-sm">
          Módulo Principal
        </div>

        <div>
          <div class="w-12 h-12 rounded-2xl bg-editorial-primary/10 border border-editorial-primary/20 flex items-center justify-center text-editorial-primary mb-4 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-1">
            <h3 class="text-lg font-bold text-white group-hover:text-editorial-primary transition-colors font-serif">
              Publicaciones & Artículos
            </h3>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Espacio para la redacción, edición y control de artículos del blog, ensayos literarios, reseñas críticas y publicaciones editoriales.
          </p>
          <div class="flex items-center gap-2 mb-6">
            <span class="text-xs px-2.5 py-1 rounded-lg bg-[#1F1F1F] text-editorial-paper font-semibold border border-[#282828]">
              {totalPosts} Artículos
            </span>
            <span class="text-xs px-2.5 py-1 rounded-lg bg-editorial-forest/30 text-emerald-300 font-medium border border-editorial-forest/50">
              Panel Listo
            </span>
          </div>
        </div>

        <div class="pt-4 border-t border-[#282828] flex items-center justify-between">
          <Button 
            href="/admin/publicaciones" 
            variant="primary"
            size="sm"
          >
            <span>Gestionar Publicaciones</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </Button>
          <a 
            href="/blog/pajaro-muerto" 
            target="_blank" 
            class="text-xs text-slate-400 hover:text-white transition-colors"
            title="Ver publicación de muestra en vivo"
          >
            Ver en sitio &rarr;
          </a>
        </div>
      </Card>

      <!-- 2. GALERÍA DE ARTE -->
      <Card variant="interactive" class="p-6 flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-editorial-accent/15 border border-editorial-accent/25 flex items-center justify-center text-editorial-accent mb-4 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-1">
            <h3 class="text-lg font-bold text-white group-hover:text-editorial-accent transition-colors font-serif">
              Galería 870
            </h3>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#1F1F1F] text-slate-400 font-semibold border border-[#282828]">Exhibición</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Catálogo de piezas de arte visual, artistas convocados, fichas descriptivas, precios y exposiciones presenciales.
          </p>
          <div class="flex items-center gap-2 mb-6">
            <span class="text-xs px-2.5 py-1 rounded-lg bg-[#1F1F1F] text-editorial-paper font-medium border border-[#282828]">
              Catálogo Público
            </span>
          </div>
        </div>

        <div class="pt-4 border-t border-[#282828] flex items-center justify-between">
          <Button 
            href="/galeria" 
            target="_blank" 
            variant="secondary"
            size="sm"
          >
            <span>Ver Sección Galería</span>
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </Button>
        </div>
      </Card>

      <!-- 3. CINE CLUB -->
      <Card variant="interactive" class="p-6 flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-editorial-forest/30 border border-editorial-forest/50 flex items-center justify-center text-emerald-400 mb-4 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-1">
            <h3 class="text-lg font-bold text-white group-hover:text-emerald-300 transition-colors font-serif">
              Cine Club
            </h3>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#1F1F1F] text-slate-400 font-semibold border border-[#282828]">Proyecciones</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Ciclos de cine independiente y experimental, cronograma de funciones, carteleras, directores y fichas técnicas.
          </p>
          <div class="flex items-center gap-2 mb-6">
            <span class="text-xs px-2.5 py-1 rounded-lg bg-[#1F1F1F] text-editorial-paper font-medium border border-[#282828]">
              Cartelera Activa
            </span>
          </div>
        </div>

        <div class="pt-4 border-t border-[#282828] flex items-center justify-between">
          <Button 
            href="/cine-club" 
            target="_blank" 
            variant="secondary"
            size="sm"
          >
            <span>Ver Cartelera Cine</span>
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </Button>
        </div>
      </Card>

      <!-- 4. PÁGINAS INSTITUCIONALES (NOSOTROS & CONTACTO) -->
      <Card variant="interactive" class="p-6 flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#1F1F1F] border border-[#282828] flex items-center justify-center text-slate-300 mb-4 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-1">
            <h3 class="text-lg font-bold text-white group-hover:text-editorial-paper transition-colors font-serif">
              Páginas Institucionales
            </h3>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#1F1F1F] text-slate-400 font-semibold border border-[#282828]">Estáticas</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Contenido sobre la identidad de 870tivo, manifiesto editorial, trayectoria colectiva y canales de contacto oficial.
          </p>
          <div class="flex items-center gap-2 mb-6">
            <span class="text-xs px-2.5 py-1 rounded-lg bg-[#1F1F1F] text-editorial-paper font-medium border border-[#282828]">
              3 Páginas (/nosotros, /contacto)
            </span>
          </div>
        </div>

        <div class="pt-4 border-t border-[#282828] flex items-center justify-between">
          <Button 
            href="/paginas/nosotros" 
            target="_blank" 
            variant="secondary"
            size="sm"
          >
            <span>Ver Nosotros</span>
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </Button>
        </div>
      </Card>

      <!-- 5. REDES & ARCHIVO RAW -->
      <Card variant="interactive" class="p-6 flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#1F1F1F] border border-[#282828] flex items-center justify-center text-slate-300 mb-4 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-1">
            <h3 class="text-lg font-bold text-white group-hover:text-editorial-paper transition-colors font-serif">
              Redes & Difusión
            </h3>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#1F1F1F] text-slate-400 font-semibold border border-[#282828]">Social</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Portal de difusión digital con enlaces directos a Instagram (@870tivo y @870raw para fotografía documental sin editar).
          </p>
          <div class="flex items-center gap-2 mb-6">
