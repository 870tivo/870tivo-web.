---
import '../../styles/global.css';
import ThemeToggle from '../../components/common/ThemeToggle';

// Retrieve authenticated user from middleware context if available in SSR
const user = Astro.locals.user;
const userEmail = user?.email || '';

const title = 'Panel de Administración | Galería 870';
const fontsUrl = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap';
---

<!doctype html>
<html lang="es" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Panel privado de administración de Galería 870" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontsUrl} rel="stylesheet" />

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'dark';
      })();

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>

  <body class="min-h-screen bg-brand-bg text-brand-ink dark:bg-brand-ink dark:text-brand-darkInk font-sans antialiased flex flex-col justify-between selection:bg-brand-orange selection:text-white transition-colors duration-200">
    
    <!-- Admin Navigation Header -->
    <header class="border-b border-brand-ink/10 dark:border-brand-darkCard/80 bg-brand-card/50 dark:bg-brand-darkCard/60 backdrop-blur-md sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between">
        
        <!-- Left: Brand & Admin Tag -->
        <div class="flex items-center gap-4">
          <a href="/admin/dashboard" class="flex items-center gap-3 group">
            <img 
              src="/assets/logo/870.jpeg" 
              alt="870 Logo" 
              class="w-10 h-10 object-cover rounded-lg shadow-sm border border-brand-ink/10 dark:border-white/10 group-hover:brightness-110 transition-all"
            />
            <div class="flex flex-col">
              <span class="font-serif font-bold text-lg leading-tight tracking-wide text-brand-ink dark:text-brand-darkInk">
                870tivo
              </span>
              <span class="text-[10px] text-brand-orange dark:text-brand-bg tracking-widest uppercase font-semibold">
                Panel de Administración
              </span>
            </div>
          </a>

          <span class="hidden md:inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
            Sesión Activa
          </span>
        </div>

        <!-- Right: User Email, ThemeToggle & Logout -->
        <div class="flex items-center gap-4">
          <div class="hidden sm:flex flex-col text-right">
            <span class="text-xs font-semibold text-brand-ink dark:text-brand-darkInk" id="displayEmail">
              {userEmail || 'Administrador'}
            </span>
            <span class="text-[10px] text-brand-muted uppercase tracking-wider">
              Supabase Auth
            </span>
          </div>

          <ThemeToggle client:load />

          <a 
            href="/" 
            target="_blank" 
            title="Ver sitio web público"
            class="text-xs hidden lg:flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-brand-ink/15 dark:border-brand-darkCard text-brand-muted hover:text-brand-ink dark:hover:text-brand-darkInk hover:border-brand-ink/30 transition-all"
          >
            <span>Ver Sitio</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>

          <!-- Logout Button -->
          <button 
            type="button" 
            id="logoutBtn"
            class="flex items-center gap-2 text-xs font-medium px-3.5 py-2 rounded-xl bg-brand-ink/10 dark:bg-white/10 hover:bg-red-500/20 text-brand-ink dark:text-brand-darkInk hover:text-red-700 dark:hover:text-red-400 border border-brand-ink/10 dark:border-white/10 hover:border-red-500/30 transition-all duration-200 cursor-pointer"
            title="Cerrar sesión segura"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span class="hidden sm:inline">Cerrar Sesión</span>
          </button>
        </div>

      </div>
    </header>

    <!-- Main Admin Dashboard Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      
      <!-- Welcome Hero Banner -->
      <section class="mb-10 bg-brand-card/60 dark:bg-brand-darkCard border border-brand-ink/10 dark:border-brand-darkCard/80 rounded-2xl p-6 sm:p-8 shadow-sm">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div>
            <span class="text-xs uppercase tracking-widest text-brand-orange dark:text-brand-bg font-semibold">
              Bienvenido al Sistema de Gestión
            </span>
            <h1 class="font-serif text-2xl sm:text-4xl font-bold tracking-tight text-brand-ink dark:text-brand-darkInk mt-1">
              Panel Administrativo 870tivo
            </h1>
            <p class="text-sm text-brand-muted mt-2 max-w-2xl leading-relaxed">
              Control centralizado de contenidos, exposiciones, cine club y publicaciones de Galería 870.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-3 shrink-0">
            <a 
              href="/admin/reset-password" 
              class="px-4 py-2 text-xs font-medium rounded-xl border border-brand-ink/20 dark:border-white/10 text-brand-ink dark:text-brand-darkInk hover:border-brand-orange dark:hover:border-brand-yellow hover:text-brand-orange dark:hover:text-brand-yellow transition-all"
            >
              Cambiar Contraseña
            </a>
          </div>
        </div>
      </section>

      <!-- Admin Notice: Strictly Private System -->
      <div class="mb-8 p-4 rounded-xl bg-brand-orange/10 border border-brand-orange/20 text-brand-ink dark:text-brand-darkInk flex items-start gap-3">
        <svg class="w-5 h-5 text-brand-orange shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div class="text-xs leading-relaxed">
          <strong class="font-semibold">Seguridad Administrativa:</strong>
          El registro público se encuentra completamente deshabilitado. La creación y asignación de nuevos usuarios administradores se realiza exclusivamente de forma manual desde el 
          <a href="https://supabase.com/dashboard" target="_blank" rel="noopener noreferrer" class="underline font-bold text-brand-orange hover:opacity-80">
            Dashboard de Supabase
          </a>.
        </div>
      </div>

      <!-- Content Management Grid -->
      <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Module: Galería & Obras -->
        <div class="bg-brand-card/40 dark:bg-brand-darkCard/70 border border-brand-ink/10 dark:border-brand-darkCard/80 rounded-2xl p-6 hover:shadow-md transition-all group">
          <div class="flex items-center justify-between mb-4">
            <span class="p-3 rounded-xl bg-brand-turquoise/10 text-brand-turquoise font-semibold">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </span>
            <span class="text-[10px] uppercase tracking-wider text-brand-muted font-bold">Catálogo</span>
          </div>
          <h2 class="font-serif text-xl font-bold text-brand-ink dark:text-brand-darkInk mb-2 group-hover:text-brand-turquoise transition-colors">
            Galería 870
          </h2>
          <p class="text-xs text-brand-muted leading-relaxed mb-4">
            Gestión de piezas de arte, artistas participantes, precios y exposiciones temporales.
          </p>
          <a href="/galeria" class="text-xs font-semibold text-brand-turquoise hover:underline flex items-center gap-1">
            Explorar Galería &rarr;
          </a>
        </div>

        <!-- Module: Cine Club -->
        <div class="bg-brand-card/40 dark:bg-brand-darkCard/70 border border-brand-ink/10 dark:border-brand-darkCard/80 rounded-2xl p-6 hover:shadow-md transition-all group">
          <div class="flex items-center justify-between mb-4">
            <span class="p-3 rounded-xl bg-brand-orange/10 text-brand-orange font-semibold">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
              </svg>
            </span>
            <span class="text-[10px] uppercase tracking-wider text-brand-muted font-bold">Eventos</span>
          </div>
          <h2 class="font-serif text-xl font-bold text-brand-ink dark:text-brand-darkInk mb-2 group-hover:text-brand-orange transition-colors">
            Cine Club
          </h2>
          <p class="text-xs text-brand-muted leading-relaxed mb-4">
            Programación de funciones de cine, ciclos cinematográficos, directores y fichas técnicas.
          </p>
          <a href="/cine-club" class="text-xs font-semibold text-brand-orange hover:underline flex items-center gap-1">
            Ver Cine Club &rarr;
          </a>
        </div>

        <!-- Module: Blog & Editorial -->
        <div class="bg-brand-card/40 dark:bg-brand-darkCard/70 border border-brand-ink/10 dark:border-brand-darkCard/80 rounded-2xl p-6 hover:shadow-md transition-all group">
          <div class="flex items-center justify-between mb-4">
            <span class="p-3 rounded-xl bg-brand-yellow/20 text-brand-ink dark:text-brand-yellow font-semibold">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
            </span>
            <span class="text-[10px] uppercase tracking-wider text-brand-muted font-bold">Publicaciones</span>
          </div>
          <h2 class="font-serif text-xl font-bold text-brand-ink dark:text-brand-darkInk mb-2 group-hover:text-brand-orange dark:group-hover:text-brand-yellow transition-colors">
            Artículos & Blog
          </h2>
          <p class="text-xs text-brand-muted leading-relaxed mb-4">
            Textos críticos, ensayos de arte contemporáneo y noticias editoriales de la galería.
          </p>
          <a href="/blog/pajaro-muerto" class="text-xs font-semibold text-brand-orange dark:text-brand-yellow hover:underline flex items-center gap-1">
            Ir a Publicaciones &rarr;
          </a>
        </div>

      </section>

    </main>

    <!-- Footer -->
    <footer class="py-6 border-t border-brand-ink/10 dark:border-brand-darkCard/80 text-center text-xs text-brand-muted">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <span>&copy; {new Date().getFullYear()} Galería 870 &mdash; Sistema de Administración Privada.</span>
        <span class="text-[11px] opacity-75">Protegido con Supabase Auth & Astro Middleware</span>
      </div>
    </footer>

    <!-- Client-side Guard & Logout Script -->
    <script>
      import { supabase, clearAuthCookies } from '../../lib/supabase';

      const logoutBtn = document.getElementById('logoutBtn');
      const displayEmail = document.getElementById('displayEmail');

      // Client-side session guard (defense-in-depth)
      supabase.auth.getSession().then(({ data: { session }, error }) => {
        if (!session || error) {
          clearAuthCookies();
          window.location.href = '/admin/login';
        } else if (session.user?.email && displayEmail) {
          displayEmail.textContent = session.user.email;
        }
      });

      // Handle Logout
      logoutBtn?.addEventListener('click', async () => {
        try {
          if (logoutBtn) {
            logoutBtn.classList.add('opacity-60', 'pointer-events-none');
          }
          await supabase.auth.signOut();
          clearAuthCookies();
          window.location.href = '/admin/login';
        } catch (err) {
          console.error('Error signing out:', err);
          clearAuthCookies();
          window.location.href = '/admin/login';
        }
      });
    </script>
  </body>
</html>
