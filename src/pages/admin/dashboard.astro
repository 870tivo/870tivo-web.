---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { posts } from '../../lib/posts';

// Server-side authentication context
const user = Astro.locals.user;
const userEmail = user?.email || 'Administrador';

const totalPosts = posts.length;
---

<AdminLayout 
  title="Dashboard Principal | 870tivo Control Studio" 
  headerTitle="Dashboard & Vista General"
  activeModule="dashboard"
>
  <!-- Welcome Hero Banner -->
  <section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-slate-900/90 to-slate-950 border border-slate-800/90 p-6 sm:p-8 lg:p-10 shadow-2xl shadow-cyan-950/20 mb-8 sm:mb-10">
    <div class="absolute -right-12 -top-12 w-64 h-64 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-12 -bottom-12 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/25 text-cyan-300 text-xs font-semibold mb-3">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          Sistema de Administración 870tivo
        </div>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
          Hola, <span class="bg-gradient-to-r from-cyan-300 via-teal-200 to-amber-300 bg-clip-text text-transparent font-serif">{userEmail.split('@')[0]}</span> 👋
        </h1>
        <p class="text-slate-300 text-sm sm:text-base mt-2.5 leading-relaxed font-normal">
          Bienvenido al centro de mando administrativo. Desde aquí puedes supervisar todas las secciones de tu página web y gestionar directamente el módulo de publicaciones editoriales.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a 
          href="/admin/publicaciones" 
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-bold text-xs uppercase tracking-wider shadow-lg shadow-amber-500/20 transition-all transform hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          <span>Publicaciones</span>
        </a>

        <a 
          href="/admin/usuarios" 
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-gradient-to-r from-purple-500/30 to-indigo-500/30 hover:from-purple-500/40 hover:to-indigo-500/40 border border-purple-500/40 text-purple-200 hover:text-white font-bold text-xs uppercase tracking-wider transition-all transform hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4 text-purple-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span>Usuarios</span>
        </a>

        <a 
          href="/admin/roles" 
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-gradient-to-r from-cyan-500/30 to-blue-500/30 hover:from-cyan-500/40 hover:to-blue-500/40 border border-cyan-500/40 text-cyan-200 hover:text-white font-bold text-xs uppercase tracking-wider transition-all transform hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4 text-cyan-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Roles</span>
        </a>

        <a 
          href="/" 
          target="_blank"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700 text-slate-200 hover:text-white text-xs font-semibold transition-all"
        >
          <span>Sitio Web</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Metric Quick Cards -->
  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-10">
    
    <!-- Stat 1: Publicaciones -->
    <a href="/admin/publicaciones" class="group block p-5 rounded-2xl bg-slate-900/60 hover:bg-slate-900 border border-slate-800/80 hover:border-amber-500/40 transition-all duration-200">
      <div class="flex items-center justify-between mb-3">
        <span class="p-2.5 rounded-xl bg-amber-500/10 text-amber-400 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
        </span>
        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">
          Editorial
        </span>
      </div>
      <div class="text-2xl font-extrabold text-white tracking-tight">{totalPosts}</div>
      <div class="text-xs text-slate-300 font-medium mt-1">Publicaciones Registradas</div>
      <div class="text-[11px] text-amber-400/90 mt-2 font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
        <span>Gestionar artículos</span> &rarr;
      </div>
    </a>

    <!-- Stat 2: Usuarios -->
    <a href="/admin/usuarios" class="group block p-5 rounded-2xl bg-slate-900/60 hover:bg-slate-900 border border-slate-800/80 hover:border-purple-500/40 transition-all duration-200">
      <div class="flex items-center justify-between mb-3">
        <span class="p-2.5 rounded-xl bg-purple-500/10 text-purple-400 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </span>
        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-400 border border-purple-500/20">
          Cuentas
        </span>
      </div>
      <div class="text-2xl font-extrabold text-white tracking-tight">Usuarios</div>
      <div class="text-xs text-slate-300 font-medium mt-1">Miembros del Sistema</div>
      <div class="text-[11px] text-purple-400/90 mt-2 font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
        <span>Gestionar cuentas</span> &rarr;
      </div>
    </a>

    <!-- Stat 3: Roles & Permisos -->
    <a href="/admin/roles" class="group block p-5 rounded-2xl bg-slate-900/60 hover:bg-slate-900 border border-slate-800/80 hover:border-cyan-500/40 transition-all duration-200">
      <div class="flex items-center justify-between mb-3">
        <span class="p-2.5 rounded-xl bg-cyan-500/10 text-cyan-400 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </span>
        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
          Control
        </span>
      </div>
      <div class="text-2xl font-extrabold text-white tracking-tight">Roles</div>
      <div class="text-xs text-slate-300 font-medium mt-1">Matriz de Acceso</div>
      <div class="text-[11px] text-cyan-400/90 mt-2 font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
        <span>Configurar permisos</span> &rarr;
      </div>
    </a>

    <!-- Stat 4: Despliegue & Servidor -->
    <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800/80">
      <div class="flex items-center justify-between mb-3">
        <span class="p-2.5 rounded-xl bg-emerald-500/10 text-emerald-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </span>
        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          Seguro
        </span>
      </div>
      <div class="text-2xl font-extrabold text-white tracking-tight">Privado</div>
      <div class="text-xs text-slate-300 font-medium mt-1">Supabase SSR Guard</div>
      <div class="text-[11px] text-emerald-400/90 mt-2 font-medium">Sesión activa protegida</div>
    </div>

  </section>

  <!-- SECCIÓN CENTRAL: Todas las Secciones de la Página Web -->
  <section class="mb-10">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs uppercase font-bold tracking-widest text-cyan-400">Mapa del Sistema</span>
          <span class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 font-medium">5 Secciones</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight mt-1">
          Todas las Secciones de tu Página Web
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 mt-1">
          Aquí tienes una vista panorámica de todas las áreas que componen Galería 870tivo y el estado de su módulo administrativo.
        </p>
      </div>
    </div>

    <!-- Grid of All Website Sections -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- 1. MÓDULO PUBLICACIONES (ACTIVO) -->
      <div class="relative rounded-3xl p-6 bg-gradient-to-b from-amber-950/20 via-slate-900/90 to-slate-950 border-2 border-amber-500/40 shadow-xl shadow-amber-950/20 flex flex-col justify-between group">
        <div class="absolute -top-3 right-6 px-3 py-0.5 rounded-full bg-amber-400 text-slate-950 text-[10px] font-extrabold tracking-wider uppercase shadow-sm">
          Módulo Principal
        </div>

        <div>
          <div class="w-12 h-12 rounded-2xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-amber-300 mb-4 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-1">
            <h3 class="text-lg font-bold text-white group-hover:text-amber-300 transition-colors">
              Publicaciones & Artículos
            </h3>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
            Espacio para la redacción, edición y control de artículos del blog, ensayos literarios, reseñas críticas y publicaciones editoriales.
          </p>
          <div class="flex items-center gap-2 mb-6">
            <span class="text-xs px-2.5 py-1 rounded-lg bg-slate-800 text-amber-300 font-semibold">
              {totalPosts} Artículos
            </span>
            <span class="text-xs px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 font-medium border border-emerald-500/20">
              Panel Listo
            </span>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
          <a 
            href="/admin/publicaciones" 
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs transition-colors shadow-sm"
          >
            <span>Gestionar Publicaciones</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a 
            href="/blog/pajaro-muerto" 
            target="_blank" 
            class="text-xs text-slate-400 hover:text-white transition-colors"
            title="Ver publicación de muestra en vivo"
          >
            Ver en sitio &rarr;
          </a>
        </div>
      </div>

      <!-- 2. GALERÍA DE ARTE -->
      <div class="rounded-3xl p-6 bg-slate-900/60 border border-slate-800/80 hover:border-cyan-500/40 transition-all flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 mb-4 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-1">
            <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors">
              Galería 870
            </h3>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-semibold">Exhibición</span>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
            Catálogo de piezas de arte visual, artistas convocados, fichas descriptivas, precios y exposiciones presenciales.
          </p>
          <div class="flex items-center gap-2 mb-6">
            <span class="text-xs px-2.5 py-1 rounded-lg bg-slate-800/80 text-cyan-300 font-medium">
              Catálogo Público
            </span>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
          <a 
            href="/galeria" 
            target="_blank" 
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-850 hover:bg-slate-800 text-slate-200 hover:text-white font-medium text-xs border border-slate-700/80 transition-all"
          >
            <span>Ver Sección Galería</span>
            <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <!-- 3. CINE CLUB -->
      <div class="rounded-3xl p-6 bg-slate-900/60 border border-slate-800/80 hover:border-amber-500/40 transition-all flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-4 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-1">
            <h3 class="text-lg font-bold text-white group-hover:text-amber-300 transition-colors">
              Cine Club
            </h3>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-semibold">Proyecciones</span>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
            Ciclos de cine independiente y experimental, cronograma de funciones, carteleras, directores y fichas técnicas.
          </p>
          <div class="flex items-center gap-2 mb-6">
            <span class="text-xs px-2.5 py-1 rounded-lg bg-slate-800/80 text-amber-300 font-medium">
              Cartelera Activa
            </span>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
          <a 
            href="/cine-club" 
            target="_blank" 
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-850 hover:bg-slate-800 text-slate-200 hover:text-white font-medium text-xs border border-slate-700/80 transition-all"
          >
            <span>Ver Cartelera Cine</span>
            <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <!-- 4. PÁGINAS INSTITUCIONALES (NOSOTROS & CONTACTO) -->
      <div class="rounded-3xl p-6 bg-slate-900/60 border border-slate-800/80 hover:border-emerald-500/40 transition-all flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mb-4 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-1">
            <h3 class="text-lg font-bold text-white group-hover:text-emerald-300 transition-colors">
              Páginas Institucionales
            </h3>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-semibold">Estaticas</span>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
            Contenido sobre la identidad de 870tivo, manifiesto editorial, trayectoria colectiva y canales de contacto oficial.
          </p>
          <div class="flex items-center gap-2 mb-6">
            <span class="text-xs px-2.5 py-1 rounded-lg bg-slate-800/80 text-emerald-400 font-medium">
              3 Páginas (/nosotros, /contacto)
            </span>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
          <a 
            href="/paginas/nosotros" 
            target="_blank" 
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-850 hover:bg-slate-800 text-slate-200 hover:text-white font-medium text-xs border border-slate-700/80 transition-all"
          >
            <span>Ver Nosotros</span>
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <!-- 5. REDES & ARCHIVO RAW -->
      <div class="rounded-3xl p-6 bg-slate-900/60 border border-slate-800/80 hover:border-pink-500/40 transition-all flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-pink-500/10 border border-pink-500/20 flex items-center justify-center text-pink-400 mb-4 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-1">
            <h3 class="text-lg font-bold text-white group-hover:text-pink-300 transition-colors">
              Redes & Difusión
            </h3>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-semibold">Social</span>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
