---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import InviteUserModal from '../../../components/admin/InviteUserModal.astro';
import Card from '../../../components/common/Card.astro';
import Button from '../../../components/common/Button.astro';
import SearchInput from '../../../components/common/SearchInput.astro';
import { supabaseAdmin } from '../../../lib/supabase';
import { getAllRoles, isUserAdminOrHasAccess } from '../../../lib/auth';
import type { AdminUserListItem } from '../../../types/roles';

// 1. SSR Auth & RBAC Guard (Defense in Depth)
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/admin/login');
}
const role = Astro.locals.role;
const permissions = Astro.locals.permissions;
if (!isUserAdminOrHasAccess(role, permissions)) {
  const msg = encodeURIComponent('Acceso restringido: Se requieren privilegios de Administrador para gestionar usuarios.');
  return Astro.redirect(`/admin/dashboard?error=access_denied&message=${msg}`);
}

// 2. Fetch available roles
const roles = await getAllRoles();

// 2. Fetch all users from Supabase Auth via admin client
let usersList: AdminUserListItem[] = [];
let fetchError: string | null = null;

try {
  const { data: authData, error: authErr } = await supabaseAdmin.auth.admin.listUsers({
    page: 1,
    perPage: 100,
  });

  if (authErr) throw authErr;

  // 3. Fetch all role assignments
  const { data: userRoles, error: urErr } = await supabaseAdmin
    .from('user_roles')
    .select('user_id, role_id, roles(id, name, permissions)');

  if (urErr) throw urErr;

  // Build lookup map for user roles
  const roleMap: Record<string, { roleId: string; roleName: string; permissions: any }> = {};
  if (userRoles) {
    for (const ur of userRoles) {
      const roleData = Array.isArray(ur.roles) ? ur.roles[0] : ur.roles;
      if (roleData) {
        roleMap[ur.user_id] = {
          roleId: roleData.id,
          roleName: roleData.name,
          permissions: roleData.permissions,
        };
      }
    }
  }

  // Combine auth users with their roles
  usersList = (authData?.users || []).map((u: any) => {
    const assigned = roleMap[u.id];
    return {
      id: u.id,
      email: u.email || 'Sin correo',
      created_at: u.created_at,
      last_sign_in_at: u.last_sign_in_at || null,
      roleId: assigned?.roleId || null,
      roleName: assigned?.roleName || null,
      permissions: assigned?.permissions || null,
    };
  });
} catch (err: any) {
  console.error('Error cargando usuarios en SSR:', err);
  fetchError = err?.message || 'Error al conectar con el servidor de autenticación.';
}

const totalUsers = usersList.length;
const usersWithRole = usersList.filter((u) => u.roleId !== null).length;
const usersWithoutRole = totalUsers - usersWithRole;
---

<AdminLayout 
  title="Gestión de Usuarios & Roles | 870tivo Control Studio" 
  headerTitle="Usuarios & Accesos"
  activeModule="usuarios"
>
  <!-- Header with Actions -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-[#1F1B16] dark:text-white tracking-tight">
        Usuarios & Asignación de Roles
      </h1>
      <p class="text-xs sm:text-sm text-[#78716A] dark:text-slate-400 mt-1 max-w-2xl">
        Administra las cuentas de usuario registradas y asigna el rol correspondiente a cada miembro de tu equipo.
      </p>
    </div>

    <!-- Quick Action: Manage Roles & Invite User -->
    <div class="flex flex-wrap items-center gap-3">
      <Button
        variant="secondary"
        href="/admin/roles"
        size="md"
      >
        <svg class="w-4 h-4 text-[#E4572E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
        </svg>
        <span>Gestionar Catálogo de Roles</span>
      </Button>

      <Button
        variant="primary"
        id="openInviteUserModalBtn"
        size="md"
      >
        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
        </svg>
        <span>+ Invitar Usuario</span>
      </Button>
    </div>
  </div>

  <!-- Metric Quick Cards -->
  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <Card variant="default" padding="md" class="metric-card">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs text-[#78716A] dark:text-neutral-400 font-medium">Usuarios Registrados</span>
        <span class="p-2 rounded-xl bg-[#E4572E]/10 text-[#E4572E]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </span>
      </div>
      <div class="text-2xl font-extrabold text-[#1F1B16] dark:text-white">{totalUsers}</div>
      <div class="text-xs text-[#78716A] dark:text-neutral-400 mt-1">Total registrados</div>
    </Card>

    <Card variant="default" padding="md" class="metric-card">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs text-[#78716A] dark:text-neutral-400 font-medium">Con Rol Asignado</span>
        <span class="p-2 rounded-xl bg-[#2F4B3A]/20 text-[#2F4B3A] dark:text-[#A7C7B3]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </span>
      </div>
      <div class="text-2xl font-extrabold text-[#2F4B3A] dark:text-[#A7C7B3]">{usersWithRole}</div>
      <div class="text-xs text-[#78716A] dark:text-neutral-400 mt-1">Con permisos activos</div>
    </Card>

    <Card variant="default" padding="md" class="metric-card">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs text-[#78716A] dark:text-neutral-400 font-medium">Sin Rol Asignado</span>
        <span class="p-2 rounded-xl bg-[#F2B134]/15 text-[#966B0D] dark:text-[#F2B134]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </span>
      </div>
      <div class="text-2xl font-extrabold text-[#966B0D] dark:text-[#F2B134]">{usersWithoutRole}</div>
      <div class="text-xs text-[#78716A] dark:text-neutral-400 mt-1">Pendientes de asignar</div>
    </Card>

    <Card variant="default" padding="md" class="metric-card">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs text-[#78716A] dark:text-neutral-400 font-medium">Roles Disponibles</span>
        <span class="p-2 rounded-xl bg-[#E4572E]/10 text-[#E4572E]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </span>
      </div>
      <div class="text-2xl font-extrabold text-[#1F1B16] dark:text-white">{roles.length}</div>
      <div class="text-xs text-[#78716A] dark:text-neutral-400 mt-1">En catálogo</div>
    </Card>
  </section>

  {fetchError && (
    <div class="p-4 mb-6 rounded-2xl bg-red-500/10 border border-red-500/30 text-red-300 text-xs">
      <strong>Error:</strong> {fetchError}
    </div>
  )}

  <!-- Filter & Search Bar -->
  <Card variant="subtle" padding="sm" class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <!-- Status Tabs -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-2 md:pb-0" id="userFilterTabs">
      <button 
        type="button" 
        data-filter="all"
        class="user-tab-btn active px-3.5 py-1.5 rounded-xl bg-[#E4572E]/15 border border-[#E4572E]/30 text-[#E4572E] text-xs font-semibold whitespace-nowrap cursor-pointer transition-all"
      >
        Todos (<span id="countAllUsers">{totalUsers}</span>)
      </button>
      <button 
        type="button" 
        data-filter="with-role"
        class="user-tab-btn px-3.5 py-1.5 rounded-xl border border-transparent text-[#78716A] dark:text-neutral-400 hover:text-[#1F1B16] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5 text-xs font-medium whitespace-nowrap cursor-pointer transition-all"
      >
        Con Rol (<span id="countWithRole">{usersWithRole}</span>)
      </button>
      <button 
        type="button" 
        data-filter="without-role"
        class="user-tab-btn px-3.5 py-1.5 rounded-xl border border-transparent text-[#78716A] dark:text-neutral-400 hover:text-[#1F1B16] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5 text-xs font-medium whitespace-nowrap cursor-pointer transition-all"
      >
        Sin Rol (<span id="countWithoutRole">{usersWithoutRole}</span>)
      </button>
    </div>

    <!-- Centralized Search Input -->
    <SearchInput 
      id="userSearchInput" 
      placeholder="Buscar por correo electrónico o ID..."
      wrapperClass="w-full md:w-80"
    />
  </Card>

  <!-- Users Table -->
  <Card padding="none" variant="default" class="overflow-hidden mb-10">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-[#1F1B16] dark:text-neutral-300" id="usersTable">
        <thead class="bg-[#FAF6F0] dark:bg-[#141414] text-xs font-semibold uppercase tracking-widest text-[#78716A] dark:text-neutral-400 border-b border-[#E5DFD5] dark:border-[#282828]">
          <tr>
            <th class="py-4 px-6">Usuario & Correo</th>
            <th class="py-4 px-6">Fecha Registro</th>
            <th class="py-4 px-6">Rol</th>
            <th class="py-4 px-6 text-right">Permisos Módulos</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E5DFD5] dark:divide-slate-800/60" id="usersTableBody">
          {usersList.map((user) => {
            const hasRole = Boolean(user.roleId);
            const isSuperAdmin = user.roleName === 'Super Administrador';
            const userInitial = (user.email?.[0] || 'U').toUpperCase();
            const dateFormatted = new Date(user.created_at).toLocaleDateString('es-ES', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            });

            return (
              <tr 
                class="admin-row-hover group user-row"
                data-user-id={user.id}
                data-email={user.email.toLowerCase()}
                data-role-id={user.roleId || ''}
                data-has-role={hasRole ? 'true' : 'false'}
              >
                <!-- User email and avatar -->
                <td class="py-4 px-6">
                  <div class="flex items-center gap-3.5">
                    <div class={`admin-avatar-hover w-10 h-10 rounded-xl flex items-center justify-center text-white font-bold text-sm shrink-0 shadow-sm group-hover:scale-105 group-hover:ring-2 group-hover:ring-[#E4572E]/40 ${
                      isSuperAdmin 
                        ? 'bg-[#E4572E]' 
                        : hasRole 
                          ? 'bg-[#2F4B3A]' 
                          : 'bg-neutral-200 dark:bg-[#242424] text-[#78716A] dark:text-neutral-400 border border-[#E5DFD5] dark:border-[#333333]'
                    }`}>
                      {userInitial}
                    </div>
                    <div class="min-w-0">
                      <div class="font-semibold text-[#1F1B16] dark:text-white group-hover:text-[#E4572E] dark:group-hover:text-[#F2B134] transition-colors truncate">
                        {user.email}
                      </div>
                      <div class="text-xs text-[#78716A] dark:text-neutral-500 font-mono flex items-center gap-1.5 mt-0.5">
                        <span>ID:</span>
                        <span class="truncate max-w-[130px]" title={user.id}>{user.id}</span>
                      </div>
                    </div>
                  </div>
                </td>

                <!-- Date -->
                <td class="py-4 px-6 whitespace-nowrap">
                  <span class="text-[#1F1B16] dark:text-neutral-300 font-medium">{dateFormatted}</span>
                  <div class="text-xs text-[#78716A] dark:text-neutral-500">
                    {user.last_sign_in_at ? 'Conectado recientemente' : 'Sin inicio de sesión'}
                  </div>
                </td>

                <!-- Integrated Role Selector Column -->
                <td class="py-4 px-6 whitespace-nowrap">
                  <div class="relative w-56">
                    <select 
                      class="role-select w-full pl-3 pr-8 py-2 bg-white dark:bg-[#141414] border border-[#E5DFD5] dark:border-[#282828] hover:border-[#E4572E]/50 focus:border-[#E4572E] rounded-xl text-xs font-medium text-[#1F1B16] dark:text-neutral-200 focus:outline-none focus:ring-1 focus:ring-[#E4572E] cursor-pointer transition-all duration-150"
                      data-user-id={user.id}
                      data-user-email={user.email}
                      data-original-role={user.roleId || ''}
                    >
                      <option value="" class="bg-white dark:bg-[#181818] text-[#78716A] dark:text-neutral-400" selected={!user.roleId}>
                        Sin Rol Asignado
                      </option>
                      {roles.map((r) => (
                        <option 
                          value={r.id} 
                          selected={user.roleId === r.id}
                          class="bg-white dark:bg-[#181818] text-[#1F1B16] dark:text-white"
                        >
                          {r.name} {r.name === 'Super Administrador' ? '★' : ''}
                        </option>
                      ))}
                    </select>

                    <!-- Loading spinner on the select (hidden by default) -->
                    <div class="select-spinner hidden absolute right-2.5 top-2.5 pointer-events-none">
                      <span class="w-3.5 h-3.5 border-2 border-[#E4572E] border-t-transparent rounded-full animate-spin block"></span>
                    </div>
                  </div>
                </td>

                <!-- Module Access Summary Badges -->
                <td class="py-4 px-6 text-right whitespace-nowrap">
                  <div class="inline-flex items-center gap-1.5">
                    {isSuperAdmin ? (
                      <span class="px-2 py-0.5 rounded-md bg-[#E4572E]/15 text-[#E4572E] border border-[#E4572E]/30 text-xs font-bold">
                        Acceso Total Irrestricto
                      </span>
                    ) : user.permissions ? (
                      <>
                        <span 
                          class={`px-2 py-0.5 rounded-md text-xs font-semibold ${user.permissions.publicaciones?.read ? 'bg-[#F2B134]/15 text-[#966B0D] dark:text-[#F2B134] border border-[#F2B134]/30' : 'bg-[#FAF6F0] dark:bg-[#181818] text-red-500/70 border border-[#E5DFD5] dark:border-transparent'}`}
                          title="Permiso en Publicaciones"
                        >
                          {user.permissions.publicaciones?.read ? 'Pubs' : '✕ Pubs'}
                        </span>
                        <span 
                          class={`px-2 py-0.5 rounded-md text-xs font-semibold ${user.permissions.galeria?.read ? 'bg-[#2F4B3A]/10 text-[#2F4B3A] dark:bg-[#2F4B3A]/20 dark:text-[#A7C7B3] border border-[#2F4B3A]/30' : 'bg-[#FAF6F0] dark:bg-[#181818] text-red-500/70 border border-[#E5DFD5] dark:border-transparent'}`}
                          title="Permiso en Galería"
                        >
                          {user.permissions.galeria?.read ? 'Galería' : '✕ Galería'}
                        </span>
                        <span 
                          class={`px-2 py-0.5 rounded-md text-xs font-semibold ${user.permissions.usuarios?.read ? 'bg-[#E4572E]/15 text-[#E4572E] border border-[#E4572E]/30' : 'bg-[#FAF6F0] dark:bg-[#181818] text-red-500/70 border border-[#E5DFD5] dark:border-transparent'}`}
                          title="Permiso en Usuarios"
                        >
                          {user.permissions.usuarios?.read ? 'Usuarios' : '✕ Usuarios'}
                        </span>
                      </>
                    ) : (
                      <span class="text-[#78716A] dark:text-neutral-500 text-xs">Ninguno</span>
                    )}
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>

      <!-- Empty State -->
      <div id="noUsersState" class="hidden py-12 text-center text-neutral-400 text-xs">
        <svg class="w-8 h-8 mx-auto text-neutral-500 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <p class="font-medium text-neutral-300">No se encontraron usuarios coincidentes</p>
        <p class="text-[11px] text-neutral-400 mt-1">Ajusta los términos de búsqueda o selecciona otra pestaña.</p>
      </div>
    </div>
  </Card>

  <!-- INVITE USER MODAL -->
  <InviteUserModal roles={roles} />

  <!-- TOAST NOTIFICATION -->
  <div 
    id="userToastNotification" 
    class="fixed bottom-6 right-6 z-50 transform translate-y-10 opacity-0 pointer-events-none transition-all duration-300 flex items-center gap-3 px-4 py-3 rounded-xl bg-[#181818] border border-[#2F4B3A]/60 text-white shadow-xl"
  >
    <span class="w-2.5 h-2.5 rounded-full bg-[#2F4B3A]"></span>
    <span id="userToastMessage" class="text-xs font-medium text-neutral-200">Rol asignado exitosamente</span>
  </div>

</AdminLayout>

<script>
  const searchInput = document.getElementById('userSearchInput') as HTMLInputElement | null;
  const userRows = document.querySelectorAll('.user-row') as NodeListOf<HTMLTableRowElement>;
  const filterTabs = document.querySelectorAll('.user-tab-btn') as NodeListOf<HTMLButtonElement>;
  const noUsersState = document.getElementById('noUsersState');

  const countAllEl = document.getElementById('countAllUsers');
  const countWithRoleEl = document.getElementById('countWithRole');
  const countWithoutRoleEl = document.getElementById('countWithoutRole');

  const toastNotification = document.getElementById('userToastNotification');
  const toastMessage = document.getElementById('userToastMessage');

  let currentFilter = 'all';

  function showToast(message: string, isError = false) {
    if (!toastNotification || !toastMessage) return;
    toastMessage.textContent = message;

    if (isError) {
      toastNotification.className = 'fixed bottom-6 right-6 z-50 transform translate-y-0 opacity-100 transition-all duration-300 flex items-center gap-3 px-4 py-3 rounded-2xl bg-slate-900 border border-red-500/40 text-white shadow-xl shadow-slate-950/60';
    } else {
      toastNotification.className = 'fixed bottom-6 right-6 z-50 transform translate-y-0 opacity-100 transition-all duration-300 flex items-center gap-3 px-4 py-3 rounded-2xl bg-slate-900 border border-emerald-500/40 text-white shadow-xl shadow-slate-950/60';
    }

    setTimeout(() => {
      toastNotification.classList.remove('opacity-100', 'translate-y-0');
      toastNotification.classList.add('opacity-0', 'pointer-events-none', 'translate-y-10');
    }, 3500);
  }

  function updateUserCounts() {
    let withRole = 0;
    let withoutRole = 0;
    userRows.forEach((row) => {
      const hasRole = row.getAttribute('data-has-role') === 'true';
      if (hasRole) withRole++;
      else withoutRole++;
    });
    if (countAllEl) countAllEl.textContent = String(userRows.length);
    if (countWithRoleEl) countWithRoleEl.textContent = String(withRole);
    if (countWithoutRoleEl) countWithoutRoleEl.textContent = String(withoutRole);
  }

  function applyFilters() {
    const query = searchInput?.value.toLowerCase().trim() || '';
    let visibleCount = 0;

    userRows.forEach((row) => {
      const email = row.getAttribute('data-email') || '';
      const userId = row.getAttribute('data-user-id') || '';
      const hasRole = row.getAttribute('data-has-role') === 'true';

      const matchesSearch = !query || email.includes(query) || userId.includes(query);
      let matchesFilter = true;

      if (currentFilter === 'with-role') {
        matchesFilter = hasRole;
      } else if (currentFilter === 'without-role') {
        matchesFilter = !hasRole;
      }

      if (matchesSearch && matchesFilter) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    if (noUsersState) {
      if (visibleCount === 0) {
        noUsersState.classList.remove('hidden');
      } else {
        noUsersState.classList.add('hidden');
      }
    }
  }

  // Filter tab buttons
  filterTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      filterTabs.forEach((t) => {
        t.classList.remove('active', 'bg-[#E4572E]/15', 'border-[#E4572E]/30', 'text-[#E4572E]', 'font-semibold');
        t.classList.add('text-neutral-400', 'border-transparent', 'font-medium');
      });

      tab.classList.add('active', 'bg-[#E4572E]/15', 'border-[#E4572E]/30', 'text-[#E4572E]', 'font-semibold');
      tab.classList.remove('text-neutral-400', 'border-transparent', 'font-medium');

      currentFilter = tab.getAttribute('data-filter') || 'all';
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', applyFilters);

  // Role select change handler
  const roleSelects = document.querySelectorAll('.role-select') as NodeListOf<HTMLSelectElement>;

  roleSelects.forEach((select) => {
    select.addEventListener('change', async () => {
      const userId = select.getAttribute('data-user-id');
      const userEmail = select.getAttribute('data-user-email') || 'este usuario';
      const originalRoleId = select.getAttribute('data-original-role') || '';
      const newRoleId = select.value.trim() || null;

      // Add visual modified ring indicator immediately
      select.classList.add('ring-2', 'ring-amber-400/40');

      const row = select.closest('.user-row') as HTMLTableRowElement | null;
      const spinner = select.parentElement?.querySelector('.select-spinner');

      // Confirmation if assigning Super Admin
      const selectedOptionText = select.options[select.selectedIndex]?.text || '';
      if (selectedOptionText.includes('Super Administrador')) {
        const confirmed = confirm(`¿Estás seguro de que deseas otorgar permisos de «Super Administrador» a ${userEmail}? Tendrá acceso total e irrestricto.`);
        if (!confirmed) {
          select.value = originalRoleId;
          select.classList.remove('ring-2', 'ring-amber-400/40');
          return;
        }
      }

      // Show spinner and disable select during request
      select.disabled = true;
      spinner?.classList.remove('hidden');

      try {
        const res = await fetch('/api/admin/users/assign-role', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId, roleId: newRoleId }),
        });

        const data = await res.json();

        if (data.success) {
          // Update original role attribute
          select.setAttribute('data-original-role', newRoleId || '');
          // Clear modified indicator and show success ring briefly
          select.classList.remove('ring-2', 'ring-amber-400/40');
          select.classList.add('ring-2', 'ring-emerald-400/50');
          setTimeout(() => {
            select.classList.remove('ring-2', 'ring-emerald-400/50');
          }, 1500);

          if (data.role) {
            row?.setAttribute('data-has-role', 'true');
            row?.setAttribute('data-role-id', data.role.id);
          } else {
            row?.setAttribute('data-has-role', 'false');
            row?.setAttribute('data-role-id', '');
          }

          showToast(data.message || `Rol actualizado para ${userEmail}`);
          updateUserCounts();
          applyFilters();
        } else {
          alert('Error: ' + (data.message || 'No se pudo asignar el rol'));
          // Revert select value and clear indicator
          select.value = originalRoleId;
          select.classList.remove('ring-2', 'ring-amber-400/40');
        }
      } catch (err: any) {
        console.error('Error al asignar rol:', err);
        alert('Error al conectar con el servidor.');
        select.value = originalRoleId;
        select.classList.remove('ring-2', 'ring-amber-400/40');
      } finally {
        select.disabled = false;
        spinner?.classList.add('hidden');
      }
    });
  });

  // --- INVITE USER MODAL LOGIC ---
  const openInviteModalBtn = document.getElementById('openInviteUserModalBtn');
  const closeInviteModalBtn = document.getElementById('closeInviteModalBtn');
  const cancelInviteBtn = document.getElementById('cancelInviteBtn');
  const inviteModal = document.getElementById('inviteUserModal');
  const inviteModalCard = document.getElementById('inviteUserModalCard');
  const inviteUserForm = document.getElementById('inviteUserForm') as HTMLFormElement | null;
  const inviteEmailInput = document.getElementById('inviteEmailInput') as HTMLInputElement | null;
  const inviteRoleSelect = document.getElementById('inviteRoleSelect') as HTMLSelectElement | null;
  const submitInviteBtn = document.getElementById('submitInviteBtn') as HTMLButtonElement | null;
  const inviteBtnIcon = document.getElementById('inviteBtnIcon');
  const inviteBtnSpinner = document.getElementById('inviteBtnSpinner');
  const inviteBtnText = document.getElementById('inviteBtnText');
  const inviteModalError = document.getElementById('inviteModalError');
  const inviteModalErrorMsg = document.getElementById('inviteModalErrorMsg');

  function openInviteModal() {
    if (!inviteModal || !inviteModalCard) return;
    inviteModalError?.classList.add('hidden');
    inviteModal.classList.remove('opacity-0', 'pointer-events-none');
    inviteModal.classList.add('opacity-100', 'pointer-events-auto');
    inviteModalCard.classList.remove('scale-95');
    inviteModalCard.classList.add('scale-100');
    setTimeout(() => {
      inviteEmailInput?.focus();
    }, 100);
  }

  function closeInviteModal() {
    if (!inviteModal || !inviteModalCard) return;
    inviteModal.classList.remove('opacity-100', 'pointer-events-auto');
    inviteModal.classList.add('opacity-0', 'pointer-events-none');
    inviteModalCard.classList.remove('scale-100');
    inviteModalCard.classList.add('scale-95');
    inviteModalError?.classList.add('hidden');
    inviteUserForm?.reset();
  }

  openInviteModalBtn?.addEventListener('click', openInviteModal);
  closeInviteModalBtn?.addEventListener('click', closeInviteModal);
  cancelInviteBtn?.addEventListener('click', closeInviteModal);

  // Close on clicking backdrop
  inviteModal?.addEventListener('click', (e) => {
    if (e.target === inviteModal) {
      closeInviteModal();
    }
  });

  // Close on Escape key
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && inviteModal && !inviteModal.classList.contains('pointer-events-none')) {
      closeInviteModal();
    }
  });

  // Handle invitation form submission
  inviteUserForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const email = inviteEmailInput?.value.trim() || '';
    const roleId = inviteRoleSelect?.value.trim() || '';

    if (!email) {
      if (inviteModalError && inviteModalErrorMsg) {
        inviteModalErrorMsg.textContent = 'Por favor, introduce una dirección de correo válida.';
        inviteModalError.classList.remove('hidden');
      }
      inviteEmailInput?.focus();
      return;
    }

    // Set loading state
    if (submitInviteBtn) submitInviteBtn.disabled = true;
    if (inviteEmailInput) inviteEmailInput.disabled = true;
    if (inviteRoleSelect) inviteRoleSelect.disabled = true;
    inviteBtnIcon?.classList.add('hidden');
    inviteBtnSpinner?.classList.remove('hidden');
    if (inviteBtnText) inviteBtnText.textContent = 'Enviando...';
    inviteModalError?.classList.add('hidden');

    try {
      const response = await fetch('/api/admin/users/invite', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, roleId }),
      });

      const result = await response.json();

      if (response.ok && result.success) {
        // Close modal and reset
        closeInviteModal();

        const successMessage = result.message || `Invitación enviada exitosamente a ${email}`;
        showToast(successMessage);

        // Store toast in sessionStorage so it persists upon table refresh
        try {
          sessionStorage.setItem('pendingUserToast', successMessage);
        } catch {
          // ignore
        }

        // Refresh table to load fresh SSR data from Supabase Auth
        setTimeout(() => {
          window.location.reload();
        }, 1100);
      } else {
        // Display error inside modal
        if (inviteModalError && inviteModalErrorMsg) {
          inviteModalErrorMsg.textContent = result.message || 'Error al enviar la invitación.';
          inviteModalError.classList.remove('hidden');
        }
        inviteEmailInput?.focus();
      }
    } catch (err: any) {
      console.error('Error al procesar la invitación:', err);
      if (inviteModalError && inviteModalErrorMsg) {
        inviteModalErrorMsg.textContent = 'Error de conexión con el servidor. Inténtalo de nuevo.';
        inviteModalError.classList.remove('hidden');
      }
    } finally {
      // Restore button and inputs
      if (submitInviteBtn) submitInviteBtn.disabled = false;
      if (inviteEmailInput) inviteEmailInput.disabled = false;
      if (inviteRoleSelect) inviteRoleSelect.disabled = false;
      inviteBtnSpinner?.classList.add('hidden');
      inviteBtnIcon?.classList.remove('hidden');
      if (inviteBtnText) inviteBtnText.textContent = 'Enviar Invitación';
    }
  });

  // Check for persisted toast upon page reload
  try {
    const pendingToast = sessionStorage.getItem('pendingUserToast');
    if (pendingToast) {
      sessionStorage.removeItem('pendingUserToast');
      setTimeout(() => {
        showToast(pendingToast);
      }, 300);
    }
  } catch {
    // ignore
  }
</script>
