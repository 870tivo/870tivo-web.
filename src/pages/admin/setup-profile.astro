---
import '../../styles/global.css';
import ThemeToggle from '../../components/common/ThemeToggle';

const title = 'Bienvenido — Completa tu Perfil | Galería 870';
const fontsUrl = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap';
---

<!doctype html>
<html lang="es" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Bienvenido al equipo de Galería 870. Completa tu perfil y activa tu cuenta." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontsUrl} rel="stylesheet" />

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'dark';
      })();

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>

  <body class="min-h-screen bg-brand-bg text-brand-ink dark:bg-brand-ink dark:text-brand-darkInk font-sans antialiased flex flex-col justify-between selection:bg-brand-orange selection:text-white transition-colors duration-200">
    
    <!-- Top Utility Bar -->
    <header class="w-full px-6 py-4 flex items-center justify-between">
      <a href="/admin/login" class="flex items-center gap-2 text-xs uppercase tracking-widest text-brand-muted hover:text-brand-orange dark:hover:text-brand-bg transition-colors font-medium">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Ir a iniciar sesión</span>
      </a>

      <div class="flex items-center gap-3">
        <ThemeToggle client:load />
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 flex items-center justify-center px-4 py-8 sm:py-12">
      <div class="w-full max-w-md">
        
        <!-- Main Card -->
        <div class="bg-brand-card/70 dark:bg-brand-darkCard border border-brand-ink/10 dark:border-brand-darkCard/80 rounded-2xl p-8 sm:p-10 shadow-2xl backdrop-blur-md transition-all duration-300">
          
          <!-- Logo & Header -->
          <div class="text-center mb-8">
            <div class="inline-block relative mb-4">
              <img 
                src="/assets/logo/870.jpeg" 
                alt="Galería 870" 
                class="w-16 h-16 object-cover rounded-xl shadow-md mx-auto border border-brand-ink/10 dark:border-white/10 ring-4 ring-brand-orange/10"
              />
            </div>
            
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold tracking-wider uppercase bg-[#E4572E]/10 text-[#E4572E] border border-[#E4572E]/20 mb-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#E4572E] animate-pulse"></span>
              Activación de Cuenta
            </span>

            <h1 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-brand-ink dark:text-brand-darkInk mt-1">
              Bienvenido — Completa tu Perfil
            </h1>
            
            <p class="text-xs text-brand-muted mt-2 max-w-sm mx-auto leading-relaxed">
              Configura tu nombre de colaborador y establece tu contraseña personal para acceder al sistema.
            </p>

            <!-- Detected Account Badge (dynamically filled) -->
            <div id="accountPill" class="hidden mt-4 inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-black/5 dark:bg-white/5 border border-brand-ink/10 dark:border-white/10 text-xs text-brand-muted">
              <svg class="w-3.5 h-3.5 text-brand-orange shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
              </svg>
              <span class="truncate max-w-[240px] text-brand-ink dark:text-brand-darkInk font-medium" id="accountPillEmail"></span>
            </div>
          </div>

          <!-- Invalid/Expired Link Alert -->
          <div id="invalidSessionAlert" class="hidden mb-6 p-4 rounded-xl text-sm bg-amber-500/10 border border-amber-500/30 text-amber-800 dark:text-amber-300">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div class="flex-1 space-y-2">
                <p class="font-medium">Enlace de invitación no detectado o expirado</p>
                <p class="text-xs opacity-90 leading-relaxed">
                  Para activar tu perfil, debes ingresar utilizando el enlace exclusivo que recibiste por correo electrónico.
                </p>
                <a 
                  href="/admin/login" 
                  class="inline-block mt-1 text-xs font-semibold underline hover:text-brand-orange transition-colors"
                >
                  Ir a iniciar sesión &rarr;
                </a>
              </div>
            </div>
          </div>

          <!-- Error Alert Banner -->
          <div id="errorAlert" class="hidden mb-6 p-4 rounded-xl text-sm bg-red-500/10 border border-red-500/30 text-red-700 dark:text-red-400">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div class="flex-1">
                <p id="errorMessage" class="font-medium">Error al completar el perfil</p>
              </div>
            </div>
          </div>

          <!-- Success State -->
          <div id="successContainer" class="hidden space-y-6">
            <div class="p-5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-800 dark:text-emerald-300">
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 shrink-0 text-emerald-600 dark:text-emerald-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="space-y-1">
                  <h3 class="font-semibold text-sm">¡Perfil activado con éxito!</h3>
                  <p class="text-xs opacity-90 leading-relaxed">
                    Tu nombre y credenciales de acceso han sido registradas correctamente. Redirigiendo al panel de administración...
                  </p>
                </div>
              </div>
            </div>

            <a 
              href="/admin/dashboard" 
              class="block w-full py-3.5 px-4 rounded-xl text-center text-sm font-semibold text-white bg-brand-ink dark:bg-brand-orange hover:bg-brand-ink/90 dark:hover:bg-brand-orange/90 transition-all shadow-md hover:shadow-lg"
            >
              Ir al Panel de Administración &rarr;
            </a>
          </div>

          <!-- Setup Profile Form -->
          <form id="setupProfileForm" class="space-y-5" novalidate>
            <!-- Full Name Field -->
            <div>
              <label for="fullNameInput" class="block text-xs font-semibold uppercase tracking-wider text-brand-ink/80 dark:text-brand-darkInk/80 mb-2">
                Nombre Completo <span class="text-[#E4572E]">*</span>
              </label>
              <div class="relative">
                <input 
                  type="text" 
                  id="fullNameInput" 
                  name="fullName" 
                  required 
                  autocomplete="name"
                  placeholder="ej. Mariana Silva" 
                  class="w-full px-4 py-3 pl-11 text-sm rounded-xl bg-white/70 dark:bg-brand-ink/60 border border-brand-ink/15 dark:border-brand-darkCard/80 text-brand-ink dark:text-brand-darkInk placeholder:text-brand-muted/70 focus:outline-none focus:ring-2 focus:ring-brand-orange dark:focus:ring-brand-yellow focus:border-transparent transition-all"
                />
                <div class="absolute left-3.5 top-1/2 -translate-y-1/2 text-brand-muted pointer-events-none">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                </div>
              </div>
            </div>

            <!-- New Password Field -->
            <div>
              <label for="newPasswordInput" class="block text-xs font-semibold uppercase tracking-wider text-brand-ink/80 dark:text-brand-darkInk/80 mb-2">
                Nueva Contraseña <span class="text-[#E4572E]">*</span>
              </label>
              <div class="relative">
                <input 
                  type="password" 
                  id="newPasswordInput" 
                  name="newPassword" 
                  required 
                  minlength="6"
                  autocomplete="new-password"
                  placeholder="Mínimo 6 caracteres" 
                  class="w-full px-4 py-3 pl-11 pr-11 text-sm rounded-xl bg-white/70 dark:bg-brand-ink/60 border border-brand-ink/15 dark:border-brand-darkCard/80 text-brand-ink dark:text-brand-darkInk placeholder:text-brand-muted/70 focus:outline-none focus:ring-2 focus:ring-brand-orange dark:focus:ring-brand-yellow focus:border-transparent transition-all"
                />
                <div class="absolute left-3.5 top-1/2 -translate-y-1/2 text-brand-muted pointer-events-none">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                  </svg>
                </div>
                <button 
                  type="button" 
                  id="toggleNewPasswordBtn" 
                  aria-label="Mostrar u ocultar contraseña"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-brand-muted hover:text-brand-ink dark:hover:text-brand-darkInk transition-colors p-1"
                >
                  <svg id="eyeIcon1" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  <svg id="eyeOffIcon1" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a10.059 10.059 0 013.999-5.325m3.543-1.425A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.05 10.05 0 01-4.132 5.411m0 0L21 21M3 3l18 18" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Confirm Password Field -->
            <div>
              <label for="confirmPasswordInput" class="block text-xs font-semibold uppercase tracking-wider text-brand-ink/80 dark:text-brand-darkInk/80 mb-2">
                Confirmar Contraseña <span class="text-[#E4572E]">*</span>
              </label>
              <div class="relative">
                <input 
                  type="password" 
                  id="confirmPasswordInput" 
                  name="confirmPassword" 
                  required 
                  minlength="6"
                  autocomplete="new-password"
                  placeholder="Repite tu nueva contraseña" 
                  class="w-full px-4 py-3 pl-11 pr-11 text-sm rounded-xl bg-white/70 dark:bg-brand-ink/60 border border-brand-ink/15 dark:border-brand-darkCard/80 text-brand-ink dark:text-brand-darkInk placeholder:text-brand-muted/70 focus:outline-none focus:ring-2 focus:ring-brand-orange dark:focus:ring-brand-yellow focus:border-transparent transition-all"
                />
                <div class="absolute left-3.5 top-1/2 -translate-y-1/2 text-brand-muted pointer-events-none">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                </div>
                <button 
                  type="button" 
                  id="toggleConfirmPasswordBtn" 
                  aria-label="Mostrar u ocultar contraseña"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-brand-muted hover:text-brand-ink dark:hover:text-brand-darkInk transition-colors p-1"
                >
                  <svg id="eyeIcon2" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  <svg id="eyeOffIcon2" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a10.059 10.059 0 013.999-5.325m3.543-1.425A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.05 10.05 0 01-4.132 5.411m0 0L21 21M3 3l18 18" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              id="setupSubmitBtn" 
              class="w-full py-3.5 px-6 rounded-xl font-medium text-sm tracking-wide text-white bg-brand-ink dark:bg-brand-orange hover:bg-brand-ink/90 dark:hover:bg-brand-orange/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-orange dark:focus:ring-brand-yellow shadow-md hover:shadow-lg active:scale-[0.99] transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer mt-3"
            >
              <span id="btnText">Completar Perfil y Activar Cuenta</span>
              <svg id="btnSpinner" class="hidden animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </form>

        </div>

        <p class="text-center text-xs text-brand-muted mt-6">
          870tivo &mdash; Sistema Editorial y Galería de Arte
        </p>

      </div>
    </main>

    <footer class="py-4 text-center text-xs text-brand-muted/70">
      &copy; {new Date().getFullYear()} Galería 870. Todos los derechos reservados.
    </footer>

    <!-- Client-side Profile Activation Script -->
    <script>
      import { supabase, setAuthCookies } from '../../lib/supabase';

      const setupProfileForm = document.getElementById('setupProfileForm') as HTMLFormElement | null;
      const fullNameInput = document.getElementById('fullNameInput') as HTMLInputElement | null;
      const newPasswordInput = document.getElementById('newPasswordInput') as HTMLInputElement | null;
      const confirmPasswordInput = document.getElementById('confirmPasswordInput') as HTMLInputElement | null;
      const setupSubmitBtn = document.getElementById('setupSubmitBtn') as HTMLButtonElement | null;
      const btnText = document.getElementById('btnText');
      const btnSpinner = document.getElementById('btnSpinner');
      const errorAlert = document.getElementById('errorAlert');
      const errorMessage = document.getElementById('errorMessage');
      const successContainer = document.getElementById('successContainer');
      const invalidSessionAlert = document.getElementById('invalidSessionAlert');
      const accountPill = document.getElementById('accountPill');
      const accountPillEmail = document.getElementById('accountPillEmail');

      // Toggles for password visibility
      const toggleNewPasswordBtn = document.getElementById('toggleNewPasswordBtn');
      const eyeIcon1 = document.getElementById('eyeIcon1');
      const eyeOffIcon1 = document.getElementById('eyeOffIcon1');

      const toggleConfirmPasswordBtn = document.getElementById('toggleConfirmPasswordBtn');
      const eyeIcon2 = document.getElementById('eyeIcon2');
      const eyeOffIcon2 = document.getElementById('eyeOffIcon2');

      toggleNewPasswordBtn?.addEventListener('click', () => {
        if (!newPasswordInput) return;
        const isPassword = newPasswordInput.type === 'password';
        newPasswordInput.type = isPassword ? 'text' : 'password';
        eyeIcon1?.classList.toggle('hidden', isPassword);
        eyeOffIcon1?.classList.toggle('hidden', !isPassword);
      });

      toggleConfirmPasswordBtn?.addEventListener('click', () => {
        if (!confirmPasswordInput) return;
        const isPassword = confirmPasswordInput.type === 'password';
        confirmPasswordInput.type = isPassword ? 'text' : 'password';
        eyeIcon2?.classList.toggle('hidden', isPassword);
        eyeOffIcon2?.classList.toggle('hidden', !isPassword);
      });

      function showError(msg: string) {
        if (errorMessage) errorMessage.textContent = msg;
        if (errorAlert) errorAlert.classList.remove('hidden');
      }

      function hideError() {
        if (errorAlert) errorAlert.classList.add('hidden');
      }

      function setLoading(loading: boolean) {
        if (!setupSubmitBtn) return;
        setupSubmitBtn.disabled = loading;
        if (loading) {
          btnText?.classList.add('opacity-80');
          if (btnText) btnText.textContent = 'Guardando perfil...';
          btnSpinner?.classList.remove('hidden');
        } else {
          btnText?.classList.remove('opacity-80');
          if (btnText) btnText.textContent = 'Completar Perfil y Activar Cuenta';
          btnSpinner?.classList.add('hidden');
        }
      }

      function showAccountEmail(email: string) {
        if (accountPill && accountPillEmail && email) {
          accountPillEmail.textContent = email;
          accountPill.classList.remove('hidden');
        }
      }

      // Check invite session
      let hasValidSession = false;

      // Listen for auth events (e.g. SIGNED_IN from hash token, INITIAL_SESSION)
      supabase.auth.onAuthStateChange(async (_event, session) => {
        if (session) {
          hasValidSession = true;
          invalidSessionAlert?.classList.add('hidden');
          setAuthCookies(session);
          if (session.user?.email) {
            showAccountEmail(session.user.email);
          }
          if (session.user?.user_metadata?.full_name && fullNameInput && !fullNameInput.value) {
            fullNameInput.value = session.user.user_metadata.full_name;
          }
        }
      });

      // Verification fallback for hash tokens or existing session
      setTimeout(async () => {
        const { data: { session } } = await supabase.auth.getSession();
        const hash = window.location.hash || '';
        const search = window.location.search || '';
        const hasHashParams = hash && (hash.includes('access_token') || hash.includes('type=invite') || hash.includes('type=recovery'));
        const hasCodeParam = new URLSearchParams(search).has('code');

        if (session) {
          hasValidSession = true;
          invalidSessionAlert?.classList.add('hidden');
          setAuthCookies(session);
          if (session.user?.email) {
            showAccountEmail(session.user.email);
          }
          if (session.user?.user_metadata?.full_name && fullNameInput && !fullNameInput.value) {
            fullNameInput.value = session.user.user_metadata.full_name;
          }
        } else if (hasHashParams || hasCodeParam) {
          // Token is present in URL and being processed by Supabase client
          hasValidSession = true;
          invalidSessionAlert?.classList.add('hidden');
        } else if (!hasValidSession) {
          invalidSessionAlert?.classList.remove('hidden');
        }
      }, 700);

      // Handle form submission
      setupProfileForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideError();

        const fullName = fullNameInput?.value?.trim() || '';
        const newPassword = newPasswordInput?.value || '';
        const confirmPassword = confirmPasswordInput?.value || '';

        // Validation
        if (!fullName) {
          showError('Por favor ingresa tu nombre completo.');
          fullNameInput?.focus();
          return;
        }

        if (!newPassword || !confirmPassword) {
          showError('Por favor completa todos los campos de contraseña.');
          return;
        }

        if (newPassword.length < 6) {
          showError('La contraseña debe tener al menos 6 caracteres.');
          newPasswordInput?.focus();
          return;
        }

        if (newPassword !== confirmPassword) {
          showError('Las contraseñas no coinciden. Por favor verifícalas.');
          confirmPasswordInput?.focus();
          return;
        }

        setLoading(true);

        try {
          // 1. Update password and metadata in Supabase Auth
          const { data: updateUserData, error: updateUserErr } = await supabase.auth.updateUser({
            password: newPassword,
            data: {
              full_name: fullName,
              name: fullName,
            },
          });

          if (updateUserErr) {
            console.error('Error al actualizar contraseña en Supabase Auth:', updateUserErr);
            let friendlyMsg = 'No se pudo activar la cuenta.';
            if (updateUserErr.message.includes('Auth session missing') || updateUserErr.message.includes('jwt')) {
              friendlyMsg = 'El enlace de invitación ha expirado o no es válido. Por favor solicita una nueva invitación.';
            } else if (updateUserErr.message) {
              friendlyMsg = updateUserErr.message;
            }
            showError(friendlyMsg);
            setLoading(false);
            return;
          }

          // 2. Synchronize current session and cookies
          const { data: sessionData } = await supabase.auth.getSession();
          const currentSession = sessionData?.session;
          if (currentSession) {
            setAuthCookies(currentSession);
          }

          const accessToken = currentSession?.access_token || '';

          // 3. Update public.profiles via backend endpoint (bypasses RLS restrictions with Service Role)
          try {
            const profileResponse = await fetch('/api/admin/profile/update', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                ...(accessToken ? { 'Authorization': `Bearer ${accessToken}` } : {}),
              },
              body: JSON.stringify({
                full_name: fullName,
              }),
            });

            if (!profileResponse.ok) {
              console.warn('Endpoint /api/admin/profile/update devolvió status:', profileResponse.status);
            }
          } catch (profileApiErr) {
            console.warn('Error llamando /api/admin/profile/update, intentando fallback directo:', profileApiErr);
          }

          // 4. Fallback direct client upsert on public.profiles
          try {
            const activeUser = updateUserData?.user || currentSession?.user;
            if (activeUser?.id) {
              await supabase
                .from('profiles')
                .upsert({
                  id: activeUser.id,
                  full_name: fullName,
                  updated_at: new Date().toISOString(),
                }, { onConflict: 'id' });
            }
          } catch (directProfileErr) {
            console.warn('Fallback directo en profiles:', directProfileErr);
          }

          // 5. Success state and redirect to /admin/dashboard
          setupProfileForm.classList.add('hidden');
          successContainer?.classList.remove('hidden');

          setTimeout(() => {
            window.location.href = '/admin/dashboard';
          }, 1400);

        } catch (err: any) {
          console.error('Error inesperado al activar perfil:', err);
          showError('Ocurrió un error inesperado al activar tu cuenta.');
          setLoading(false);
        }
      });
    </script>
  </body>
</html>
