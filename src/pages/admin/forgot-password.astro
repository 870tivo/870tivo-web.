---
import '../../styles/global.css';
import ThemeToggle from '../../components/common/ThemeToggle';

const title = 'Recuperar Contraseña | Galería 870 - Administración';
const fontsUrl = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap';
---

<!doctype html>
<html lang="es" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Recuperación de contraseña administrativa de Galería 870" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontsUrl} rel="stylesheet" />

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'dark';
      })();

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>

  <body class="min-h-screen bg-brand-bg text-brand-ink dark:bg-brand-ink dark:text-brand-darkInk font-sans antialiased flex flex-col justify-between selection:bg-brand-orange selection:text-white transition-colors duration-200">
    
    <!-- Top Utility Bar -->
    <header class="w-full px-6 py-4 flex items-center justify-between">
      <a href="/admin/login" class="flex items-center gap-2 text-xs uppercase tracking-widest text-brand-muted hover:text-brand-orange dark:hover:text-brand-bg transition-colors font-medium">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Volver al inicio de sesión</span>
      </a>

      <div class="flex items-center gap-3">
        <ThemeToggle client:load />
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 flex items-center justify-center px-4 py-8">
      <div class="w-full max-w-md">
        
        <!-- Main Card -->
        <div class="bg-brand-card/70 dark:bg-brand-darkCard border border-brand-ink/10 dark:border-brand-darkCard/80 rounded-2xl p-8 sm:p-10 shadow-xl backdrop-blur-sm transition-all duration-300">
          
          <!-- Logo & Header -->
          <div class="text-center mb-8">
            <div class="inline-block relative mb-4">
              <img 
                src="/assets/logo/870.jpeg" 
                alt="Galería 870" 
                class="w-16 h-16 object-cover rounded-xl shadow-md mx-auto border border-brand-ink/10 dark:border-white/10"
              />
            </div>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-brand-ink dark:text-brand-darkInk">
              Recuperar Contraseña
            </h1>
            <p class="text-xs uppercase tracking-widest text-brand-orange dark:text-brand-bg font-semibold mt-1">
              Galería 870
            </p>
            <p class="text-xs text-brand-muted mt-2">
              Ingresa tu correo administrativo para recibir un enlace de restablecimiento
            </p>
          </div>

          <!-- Error Alert Banner -->
          <div id="errorAlert" class="hidden mb-6 p-4 rounded-xl text-sm bg-red-500/10 border border-red-500/30 text-red-700 dark:text-red-400">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div class="flex-1">
                <p id="errorMessage" class="font-medium">Error al enviar el correo</p>
              </div>
            </div>
          </div>

          <!-- Success Alert Container (shown after submission) -->
          <div id="successContainer" class="hidden space-y-6">
            <div class="p-5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-800 dark:text-emerald-300">
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="space-y-1">
                  <h3 class="font-semibold text-sm">Enlace enviado con éxito</h3>
                  <p class="text-xs opacity-90 leading-relaxed">
                    Hemos enviado las instrucciones de restablecimiento a:
                    <br />
                    <span id="targetEmailDisplay" class="font-bold underline"></span>
                  </p>
                  <p class="text-[11px] opacity-75 mt-2">
                    Si no lo ves en unos minutos, revisa tu carpeta de correo no deseado o spam.
                  </p>
                </div>
              </div>
            </div>

            <div class="space-y-3">
              <a 
                href="/admin/login" 
                class="block w-full py-3 px-4 rounded-xl text-center text-sm font-medium text-white bg-brand-ink dark:bg-brand-orange hover:bg-brand-ink/90 dark:hover:bg-brand-orange/90 transition-all shadow-md"
              >
                Volver a Iniciar Sesión
              </a>
              <button 
                type="button" 
                id="resetFormBtn" 
                class="block w-full py-2.5 px-4 rounded-xl text-center text-xs text-brand-muted hover:text-brand-ink dark:hover:text-brand-darkInk transition-colors"
              >
                Intentar con otro correo
              </button>
            </div>
          </div>

          <!-- Forgot Password Form -->
          <form id="forgotForm" class="space-y-5" novalidate>
            <div>
              <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-brand-ink/80 dark:text-brand-darkInk/80 mb-2">
                Correo Electrónico
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                autocomplete="email"
                placeholder="admin@galeria870.com" 
                class="w-full px-4 py-3 text-sm rounded-xl bg-white/70 dark:bg-brand-ink/60 border border-brand-ink/15 dark:border-brand-darkCard/80 text-brand-ink dark:text-brand-darkInk placeholder:text-brand-muted/70 focus:outline-none focus:ring-2 focus:ring-brand-orange dark:focus:ring-brand-yellow focus:border-transparent transition-all"
              />
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              id="submitBtn" 
              class="w-full py-3.5 px-6 rounded-xl font-medium text-sm tracking-wide text-white bg-brand-ink dark:bg-brand-orange hover:bg-brand-ink/90 dark:hover:bg-brand-orange/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-orange dark:focus:ring-brand-yellow shadow-md hover:shadow-lg active:scale-[0.99] transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer mt-2"
            >
              <span id="btnText">Enviar Enlace de Recuperación</span>
              <svg id="btnSpinner" class="hidden animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>

            <div class="text-center pt-2">
              <a 
                href="/admin/login" 
                class="text-xs text-brand-muted hover:text-brand-orange dark:hover:text-brand-bg transition-colors"
              >
                &larr; Volver al inicio de sesión
              </a>
            </div>
          </form>

        </div>

        <p class="text-center text-xs text-brand-muted mt-6">
          870tivo &mdash; Recuperación Segura de Acceso
        </p>

      </div>
    </main>

    <footer class="py-4 text-center text-xs text-brand-muted/70">
      &copy; {new Date().getFullYear()} Galería 870. Todos los derechos reservados.
    </footer>

    <!-- Client-side Recovery Script -->
    <script>
      import { supabase } from '../../lib/supabase';

      const forgotForm = document.getElementById('forgotForm') as HTMLFormElement | null;
      const emailInput = document.getElementById('email') as HTMLInputElement | null;
      const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
      const btnText = document.getElementById('btnText');
      const btnSpinner = document.getElementById('btnSpinner');
      const errorAlert = document.getElementById('errorAlert');
      const errorMessage = document.getElementById('errorMessage');
      const successContainer = document.getElementById('successContainer');
      const targetEmailDisplay = document.getElementById('targetEmailDisplay');
      const resetFormBtn = document.getElementById('resetFormBtn');

      function showError(msg: string) {
        if (errorMessage) errorMessage.textContent = msg;
        if (errorAlert) errorAlert.classList.remove('hidden');
      }

      function hideError() {
        if (errorAlert) errorAlert.classList.add('hidden');
      }

      function setLoading(loading: boolean) {
        if (!submitBtn) return;
        submitBtn.disabled = loading;
        if (loading) {
          btnText?.classList.add('opacity-80');
          if (btnText) btnText.textContent = 'Enviando...';
          btnSpinner?.classList.remove('hidden');
        } else {
          btnText?.classList.remove('opacity-80');
          if (btnText) btnText.textContent = 'Enviar Enlace de Recuperación';
          btnSpinner?.classList.add('hidden');
        }
      }

      forgotForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideError();

        const email = emailInput?.value.trim();

        if (!email) {
          showError('Por favor ingrese su correo electrónico.');
          return;
        }

        // Basic email syntax validation
        if (!email.includes('@') || !email.includes('.')) {
          showError('Por favor ingrese un correo electrónico válido.');
          return;
        }

        setLoading(true);

        try {
          // Configure redirect to the reset password page
          const redirectUrl = `${window.location.origin}/admin/reset-password`;

          const { error } = await supabase.auth.resetPasswordForEmail(email, {
            redirectTo: redirectUrl,
          });

          if (error) {
            let friendly = 'No se pudo enviar el correo de recuperación.';
            if (error.status === 429) {
              friendly = 'Demasiadas solicitudes. Por favor espere unos momentos antes de intentar nuevamente.';
            } else if (error.message) {
              friendly = error.message;
            }
            showError(friendly);
            setLoading(false);
            return;
          }

          // Show success state
          if (targetEmailDisplay) targetEmailDisplay.textContent = email;
          forgotForm.classList.add('hidden');
          successContainer?.classList.remove('hidden');
        } catch (err: any) {
          console.error('Error in resetPasswordForEmail:', err);
          showError('Ocurrió un error inesperado al procesar la solicitud.');
          setLoading(false);
        }
      });

      resetFormBtn?.addEventListener('click', () => {
        successContainer?.classList.add('hidden');
        forgotForm?.classList.remove('hidden');
        setLoading(false);
        if (emailInput) {
          emailInput.value = '';
          emailInput.focus();
        }
      });
    </script>
  </body>
</html>
