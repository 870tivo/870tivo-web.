---
/**
 * src/pages/admin/autores/index.astro
 * Módulo de Gestión de Autores y Redactores Editorial («Tierra y Energía» / Papel & Tinta).
 * Permite listar, buscar, crear, editar y eliminar autores con conteo de publicaciones vinculadas.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import CreateAuthorModal from '../../../components/admin/CreateAuthorModal.astro';
import Card from '../../../components/common/Card.astro';
import Button from '../../../components/common/Button.astro';
import SearchInput from '../../../components/common/SearchInput.astro';
import { supabaseAdmin } from '../../../lib/supabase';

// 1. Verificar sesión de usuario SSR
const user = Astro.locals.user;
if (!user?.id) {
  return Astro.redirect('/admin/login?redirect=/admin/autores');
}

// 2. Parámetros de búsqueda
const searchQuery = (Astro.url.searchParams.get('search') || Astro.url.searchParams.get('q') || '').trim();

// 3. Obtener posts para calcular cuántos artículos tiene cada autor
const { data: postsData } = await supabaseAdmin
  .from('posts')
  .select('author');

const authorPostCounts = new Map<string, number>();
if (postsData) {
  for (const post of postsData) {
    const aName = post.author?.trim();
    if (aName) {
      authorPostCounts.set(aName.toLowerCase(), (authorPostCounts.get(aName.toLowerCase()) || 0) + 1);
    }
  }
}

// 4. Intentar consultar desde la tabla `authors`
let authorsList: Array<{
  id: string;
  name: string;
  social_url: string | null;
  created_at: string;
  post_count: number;
}> = [];

try {
  let query = supabaseAdmin
    .from('authors')
    .select('*')
    .order('name', { ascending: true });

  if (searchQuery) {
    query = query.or(`name.ilike.%${searchQuery}%,social_url.ilike.%${searchQuery}%`);
  }

  const { data, error } = await query;

  if (error) {
    console.error('Error al consultar tabla authors:', error);
  } else if (data) {
    authorsList = data.map((a: any) => ({
      id: a.id,
      name: a.name,
      social_url: a.social_url,
      created_at: a.created_at || new Date().toISOString(),
      post_count: authorPostCounts.get(a.name.toLowerCase()) || 0,
    }));
  }
} catch (e) {
  console.error('Error al obtener autores:', e);
}

const totalAuthors = authorsList.length;

function getInitials(name: string): string {
  const parts = name.trim().split(/\s+/);
  if (parts.length >= 2) {
    return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  }
  return name.slice(0, 2).toUpperCase();
}

function formatDate(isoDate: string): string {
  try {
    return new Date(isoDate).toLocaleDateString('es-CO', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  } catch {
    return 'Reciente';
  }
}
---

<AdminLayout title="Gestión de Autores | 870tivo Control Studio" activeModule="autores">
  
  <div class="space-y-6 sm:space-y-8 max-w-7xl mx-auto">
    
    <!-- HEADER EDITORIAL -->
    <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 border-b border-[#E5DFD5] dark:border-[#282828]">
      <div class="space-y-1">
        <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#E4572E]">
          <span>Studio Editorial</span>
          <span class="text-[#78716A] dark:text-neutral-500">•</span>
          <span class="text-[#78716A] dark:text-neutral-400">Firmas & Colaboradores</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-serif font-bold text-[#1F1B16] dark:text-white tracking-tight">
          Gestión de Autores
        </h1>
        <p class="text-xs sm:text-sm text-[#78716A] dark:text-neutral-400 max-w-2xl">
          Administra las firmas editoriales, redactores y perfiles de redes sociales vinculados a las publicaciones de 870tivo.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <Button 
          id="openNewAuthorTopBtn"
          variant="primary" 
          size="md"
          class="shadow-sm"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
          Nuevo Autor
        </Button>
      </div>
    </header>

    <!-- BARRA DE BÚSQUEDA Y ESTADÍSTICAS -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
      <!-- Search Form -->
      <form id="authorSearchForm" class="w-full sm:max-w-md">
        <SearchInput 
          id="authorSearchInput"
          placeholder="Buscar autor por nombre o red social..."
          value={searchQuery}
        />
      </form>

      <!-- Badge de Conteo -->
      <div class="flex items-center gap-2 self-start sm:self-center">
        <span class="text-xs text-[#78716A] dark:text-neutral-400 font-medium">Total de autores:</span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-[#FAF6F0] dark:bg-[#1A1A1A] text-[#1F1B16] dark:text-white border border-[#E5DFD5] dark:border-[#282828]">
          {totalAuthors}
        </span>
      </div>
    </div>

    <!-- TABLA DE AUTORES -->
    <Card class="overflow-hidden border border-[#E5DFD5] dark:border-[#282828] bg-white dark:bg-[#141414] shadow-xs rounded-2xl p-0">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="border-b border-[#E5DFD5] dark:border-[#282828] bg-[#FAF6F0]/70 dark:bg-[#181818]/60 text-[11px] font-bold uppercase tracking-wider text-[#78716A] dark:text-neutral-400">
              <th scope="col" class="py-3.5 px-4 sm:px-6">Autor / Redactor</th>
              <th scope="col" class="py-3.5 px-4 sm:px-6">Enlace / Perfil Social</th>
              <th scope="col" class="py-3.5 px-4 sm:px-6 text-center">Artículos</th>
              <th scope="col" class="py-3.5 px-4 sm:px-6">Registrado</th>
              <th scope="col" class="py-3.5 px-4 sm:px-6 text-right">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#E5DFD5]/70 dark:divide-[#282828]/70">
            {authorsList.length === 0 ? (
              <tr>
                <td colspan="5" class="py-12 text-center">
                  <div class="flex flex-col items-center justify-center max-w-sm mx-auto text-center space-y-3">
                    <div class="w-12 h-12 rounded-2xl bg-[#E4572E]/10 border border-[#E4572E]/20 flex items-center justify-center text-[#E4572E]">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                    </div>
                    <div>
                      <h4 class="font-serif font-bold text-base text-[#1F1B16] dark:text-white">
                        {searchQuery ? 'Sin resultados para la búsqueda' : 'No hay autores registrados'}
                      </h4>
                      <p class="text-xs text-[#78716A] dark:text-neutral-400 mt-1">
                        {searchQuery 
                          ? `No encontramos autores que coincidan con «${searchQuery}».`
                          : 'Crea el primer redactor para vincularlo a las publicaciones de la revista.'}
                      </p>
                    </div>
                    {!searchQuery && (
                      <button 
                        type="button" 
                        class="open-new-author-inline-btn inline-flex items-center gap-1.5 px-4 py-2 bg-[#E4572E] text-white font-bold text-xs rounded-xl shadow-xs transition-colors cursor-pointer hover:bg-[#CF4821]"
                      >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Crear Primer Autor
                      </button>
                    )}
                  </div>
                </td>
              </tr>
            ) : (
              authorsList.map((author) => {
                const initials = getInitials(author.name);
                return (
                  <tr 
                    class="author-row hover:bg-[#FAF6F0]/40 dark:hover:bg-[#181818]/40 transition-colors"
                    data-id={author.id}
                    data-name={author.name}
                    data-social={author.social_url || ''}
                  >
                    <!-- Nombre y Avatar -->
                    <td class="py-3.5 px-4 sm:px-6">
                      <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-[#FAF6F0] dark:bg-[#1E1E1E] border border-[#E5DFD5] dark:border-[#282828] flex items-center justify-center font-serif font-bold text-xs text-[#E4572E] shadow-2xs shrink-0">
                          {initials}
                        </div>
                        <div class="min-w-0">
                          <span class="font-medium text-[#1F1B16] dark:text-white block truncate">
                            {author.name}
                          </span>
                          <span class="text-[10px] text-[#78716A] dark:text-neutral-400">
                            Firma Editorial
                          </span>
                        </div>
                      </div>
                    </td>

                    <!-- Enlace Social -->
                    <td class="py-3.5 px-4 sm:px-6">
                      {author.social_url ? (
                        <a 
                          href={author.social_url} 
                          target="_blank" 
                          rel="noopener noreferrer" 
                          class="inline-flex items-center gap-1.5 text-xs text-[#E4572E] hover:text-[#CF4821] hover:underline underline-offset-2 transition-colors max-w-xs truncate"
                        >
                          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                          </svg>
                          <span class="truncate">{author.social_url.replace(/^https?:\/\/(www\.)?/, '')}</span>
                        </a>
                      ) : (
                        <span class="text-xs text-[#A8A29E] dark:text-neutral-500 italic">
                          Sin enlace social
                        </span>
                      )}
                    </td>

                    <!-- Conteo de Artículos -->
                    <td class="py-3.5 px-4 sm:px-6 text-center">
                      <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold ${
                        author.post_count > 0 
                          ? 'bg-[#2F4B3A]/10 text-[#2F4B3A] dark:text-[#A7C7B3] border border-[#2F4B3A]/20'
                          : 'bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400'
                      }`}>
                        {author.post_count} {author.post_count === 1 ? 'artículo' : 'artículos'}
                      </span>
                    </td>

                    <!-- Fecha de Registro -->
                    <td class="py-3.5 px-4 sm:px-6 text-xs text-[#78716A] dark:text-neutral-400 font-mono">
                      {formatDate(author.created_at)}
                    </td>

                    <!-- Acciones -->
                    <td class="py-3.5 px-4 sm:px-6 text-right">
                      <div class="inline-flex items-center gap-1.5 justify-end">
                        <button 
                          type="button" 
                          class="edit-author-btn p-1.5 text-[#78716A] hover:text-[#1F1B16] dark:text-neutral-400 dark:hover:text-white rounded-lg hover:bg-[#FAF6F0] dark:hover:bg-[#222222] transition-colors cursor-pointer"
                          title="Editar autor"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                          </svg>
                        </button>
                        <button 
                          type="button" 
                          class="delete-author-btn p-1.5 text-red-500 hover:text-red-700 dark:hover:text-red-400 rounded-lg hover:bg-red-500/10 transition-colors cursor-pointer"
                          title="Eliminar autor"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </Card>

  </div>

  <!-- MODAL INDEPENDIENTE PARA CREAR O EDITAR AUTOR -->
  <CreateAuthorModal />

  <!-- MODAL DE CONFIRMACIÓN PARA ELIMINAR AUTOR -->
  <div 
    id="deleteAuthorModal" 
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300"
    role="dialog"
    aria-modal="true"
  >
    <div 
      id="deleteAuthorCard"
      class="relative w-full max-w-sm rounded-2xl bg-white dark:bg-[#141414] border border-[#E5DFD5] dark:border-[#282828] p-6 shadow-2xl transform scale-95 transition-all duration-300 text-center"
    >
      <div class="w-12 h-12 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-500 flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </div>
      <h3 class="font-serif font-bold text-base text-[#1F1B16] dark:text-white mb-1.5">
        ¿Eliminar este autor?
      </h3>
      <p id="deleteAuthorModalMessage" class="text-xs text-[#78716A] dark:text-neutral-400 mb-6 leading-relaxed">
        Esta acción quitará al autor de la lista editorial.
      </p>
      <div class="flex items-center justify-center gap-3">
        <button 
          type="button" 
          id="cancelDeleteAuthorBtn"
          class="px-4 py-2 text-xs font-semibold text-[#78716A] hover:text-[#1F1B16] dark:text-neutral-400 dark:hover:text-white rounded-xl transition-colors cursor-pointer"
        >
          Cancelar
        </button>
        <button 
          type="button" 
          id="confirmDeleteAuthorBtn"
          class="px-5 py-2 bg-red-600 hover:bg-red-700 text-white font-bold text-xs rounded-xl shadow-xs transition-colors cursor-pointer"
        >
          Sí, Eliminar
        </button>
      </div>
    </div>
  </div>

  <!-- TOAST NOTIFICATION -->
  <div 
    id="toastNotification" 
    class="fixed bottom-6 right-6 z-50 transform translate-y-10 opacity-0 pointer-events-none transition-all duration-300 flex items-center gap-3 px-4 py-3 rounded-xl bg-[#181818] border border-[#2F4B3A]/60 text-white shadow-xl"
  >
    <span class="w-2.5 h-2.5 rounded-full bg-[#2F4B3A]"></span>
    <span id="toastMessage" class="text-xs font-medium text-neutral-200">Operación exitosa</span>
  </div>

</AdminLayout>

<script>
  // Elements
  const topNewAuthorBtn = document.getElementById('openNewAuthorTopBtn');
  const inlineNewAuthorBtn = document.querySelector('.open-new-author-inline-btn');
  const editButtons = document.querySelectorAll('.edit-author-btn') as NodeListOf<HTMLButtonElement>;
  const deleteButtons = document.querySelectorAll('.delete-author-btn') as NodeListOf<HTMLButtonElement>;

  // Delete modal elements
  const deleteModal = document.getElementById('deleteAuthorModal') as HTMLElement;
  const deleteCard = document.getElementById('deleteAuthorCard') as HTMLElement;
  const deleteMessage = document.getElementById('deleteAuthorModalMessage') as HTMLElement;
  const cancelDeleteBtn = document.getElementById('cancelDeleteAuthorBtn') as HTMLButtonElement;
  const confirmDeleteBtn = document.getElementById('confirmDeleteAuthorBtn') as HTMLButtonElement;

  let authorToDelete: { id: string; name: string } | null = null;

  // Abrir modal de creación
  function openCreateModal() {
    if (typeof (window as any).__openCreateAuthorModal === 'function') {
      (window as any).__openCreateAuthorModal();
    }
  }

  topNewAuthorBtn?.addEventListener('click', openCreateModal);
  inlineNewAuthorBtn?.addEventListener('click', openCreateModal);

  // Botón "Editar" en cada fila
  editButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const row = btn.closest('.author-row') as HTMLTableRowElement | null;
      if (!row) return;

      const id = row.getAttribute('data-id') || '';
      const name = row.getAttribute('data-name') || '';
      const socialUrl = row.getAttribute('data-social') || '';

      if (typeof (window as any).__openCreateAuthorModal === 'function') {
        (window as any).__openCreateAuthorModal({ id, name, socialUrl });
      }
    });
  });

  // Botón "Eliminar" en cada fila
  deleteButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const row = btn.closest('.author-row') as HTMLTableRowElement | null;
      if (!row) return;

      const id = row.getAttribute('data-id') || '';
      const name = row.getAttribute('data-name') || 'este autor';

      authorToDelete = { id, name };
      if (deleteMessage) {
        deleteMessage.textContent = `¿Estás seguro de que deseas eliminar al autor «${name}»?`;
      }

      openDeleteModal();
    });
  });

  function openDeleteModal() {
    deleteModal.classList.remove('opacity-0', 'pointer-events-none');
    deleteModal.classList.add('opacity-100');
    deleteCard.classList.remove('scale-95');
    deleteCard.classList.add('scale-100');
  }

  function closeDeleteModal() {
    deleteModal.classList.add('opacity-0', 'pointer-events-none');
    deleteModal.classList.remove('opacity-100');
    deleteCard.classList.add('scale-95');
    deleteCard.classList.remove('scale-100');
    authorToDelete = null;
  }

  cancelDeleteBtn?.addEventListener('click', closeDeleteModal);
  deleteModal?.addEventListener('click', (e) => {
    if (e.target === deleteModal) closeDeleteModal();
  });

  // Confirmar eliminación
  confirmDeleteBtn?.addEventListener('click', async () => {
    if (!authorToDelete || !authorToDelete.id) return;

    confirmDeleteBtn.disabled = true;
    confirmDeleteBtn.textContent = 'Eliminando...';

    try {
      const res = await fetch('/api/admin/authors/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: authorToDelete.id }),
      });

      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.message || 'Error al eliminar el autor.');
      }

      closeDeleteModal();
      window.location.reload();
    } catch (err: any) {
      alert(err.message || 'Error al eliminar el autor.');
    } finally {
      confirmDeleteBtn.disabled = false;
      confirmDeleteBtn.textContent = 'Sí, Eliminar';
    }
  });

  // Escuchar cuando se crea o edita un autor desde el modal
  window.addEventListener('author-created', () => {
    setTimeout(() => {
      window.location.reload();
    }, 600);
  });
</script>
