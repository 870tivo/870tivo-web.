---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Static pages: Nosotros, Redes, Contacto
export const prerender = true;

import { staticPages } from '../../lib/pages';

export function getStaticPaths() {
  return staticPages.map((page) => ({
    params: { slug: page.slug },
    props: {
      title: page.title,
      description: page.description,
      content: page.content,
    },
  }));
}

interface Props {
  title: string;
  description: string;
  content: string;
}

const { slug } = Astro.params;
const pageData = Astro.props.title ? Astro.props : staticPages.find((p) => p.slug === slug);

if (!pageData) {
  return Astro.redirect('/');
}

const { title, description, content } = pageData;
---

<BaseLayout title={`${title} - 870tivo`} description={description}>
  <main class="flex-grow container mx-auto px-4 md:px-6 py-20 max-w-3xl">
    <div class="mb-10 pb-6 border-b border-brand-ink/10 dark:border-white/10">
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-brand-ink dark:text-white tracking-tighter mb-4">{title}</h1>
      <div class="w-12 h-1 bg-brand-orange dark:bg-brand-bg"></div>
    </div>
    <p class="text-brand-ink/80 dark:text-neutral-300 text-lg md:text-xl leading-relaxed font-medium">{content}</p>
  </main>
</BaseLayout>
