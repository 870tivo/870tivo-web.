---
/**
 * src/pages/blog/[slug].astro
 * Detalle del Artículo Público con Server-Side Rendering (SSR).
 * Consulta Supabase 'public.posts' por { slug, status: 'publicado' }.
 * Si no existe, muestra vista 404 elegante propia de 870 sin romper la URL.
 */
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import CommentSection from '../../components/post/CommentSection';
import { supabaseAdmin } from '../../lib/supabase';
import { marked } from 'marked';

const { slug } = Astro.params;

// ── 1. Consultar el post publicado en Supabase ──────────────────────────────
const { data: post, error: postError } = await supabaseAdmin
  .from('posts')
  .select(`
    id, title, slug, subtitle, category, author, author_social_url,
    author_id, cover_image, content, read_time, status,
    created_at, updated_at, views, likes
  `)
  .eq('slug', slug ?? '')
  .eq('status', 'publicado')
  .maybeSingle();

// Manejo de estado 404 elegante si no existe
const isNotFound = !post || Boolean(postError);
if (isNotFound) {
  Astro.response.status = 404;
}

// ── 2. Datos complementarios si el post existe ──────────────────────────────
let authorSlug: string | null = null;
let authorHandle: string = '';
let formattedContent = '';
let recommendedPosts: Array<{
  id: string;
  title: string;
  slug: string;
  subtitle: string | null;
  category: string;
  author: string;
  cover_image: string | null;
  read_time: string | null;
  created_at: string;
}> = [];

if (post) {
  // Incrementar vistas en Supabase
  supabaseAdmin.rpc('increment_post_views', { post_slug: post.slug }).then(() => {});

  // Buscar autor en tabla `authors`
  if (post.author_id) {
    const { data: authorData } = await supabaseAdmin
      .from('authors')
      .select('slug, social_url')
      .eq('id', post.author_id)
      .maybeSingle();

    if (authorData) {
      authorSlug = authorData.slug;
      const sUrl = authorData.social_url || post.author_social_url || '';
      const match = sUrl.match(/instagram\.com\/([^/?#]+)/i);
      authorHandle = match ? match[1] : (post.author || '').replace(/\s+/g, '').toLowerCase();
    }
  } else if (post.author) {
    const { data: authorData } = await supabaseAdmin
      .from('authors')
      .select('slug, social_url')
      .ilike('name', post.author)
      .maybeSingle();

    if (authorData) {
      authorSlug = authorData.slug;
      const sUrl = authorData.social_url || post.author_social_url || '';
      const match = sUrl.match(/instagram\.com\/([^/?#]+)/i);
      authorHandle = match ? match[1] : (post.author || '').replace(/\s+/g, '').toLowerCase();
    } else if (post.author_social_url) {
      const match = post.author_social_url.match(/instagram\.com\/([^/?#]+)/i);
      authorHandle = match ? match[1] : (post.author || '').replace(/\s+/g, '').toLowerCase();
    }
  }

  // Parsear contenido Markdown o HTML con marcado responsivo para videos
  if (post.content) {
    try {
      const parsed = await marked.parse(post.content);
      formattedContent = parsed.replace(
        /<iframe\s+([^>]*src=["']https?:\/\/(?:www\.)?(?:youtube\.com|youtu\.be)[^"']*["'][^>]*)><\/iframe>/gi,
        (_, attrs) => {
          return `<div class="my-8 aspect-video rounded-sm overflow-hidden border border-zinc-800 shadow-2xl bg-black"><iframe ${attrs} class="w-full h-full" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>`;
        }
      );
    } catch {
      formattedContent = post.content;
    }
  }

  // Buscar 2 lecturas recomendadas
  const { data: recData } = await supabaseAdmin
    .from('posts')
    .select('id, title, slug, subtitle, category, author, cover_image, read_time, created_at')
    .eq('status', 'publicado')
    .neq('slug', post.slug)
    .order('created_at', { ascending: false })
    .limit(2);

  recommendedPosts = recData ?? [];
}

// ── Formato de fecha ─────────────────────────────────────────────────────────
const formattedDate = post?.created_at
  ? new Intl.DateTimeFormat('es-CO', {
      day: '2-digit',
      month: 'long',
      year: 'numeric',
    }).format(new Date(post.created_at))
  : '';

// ── SEO ──────────────────────────────────────────────────────────────────────
const pageTitle = post ? `${post.title} — 870tivo` : 'Publicación no encontrada (404) — 870tivo';
const seoDescription =
  post?.subtitle ||
  (post?.content ? post.content.replace(/<[^>]+>/g, '').slice(0, 160) + '…' : '870tivo - Encuentro Inmaterial');
---

<BaseLayout title={pageTitle} description={seoDescription}>
  {post && (
    <Fragment slot="head">
      {post.cover_image && <meta property="og:image" content={post.cover_image} />}
      <meta property="og:type" content="article" />
      <meta property="article:published_time" content={post.created_at} />
      <meta property="article:author" content={post.author} />
    </Fragment>
  )}

  <main class="flex-grow flex flex-col bg-[#111111] text-slate-100 -mt-[72px]" data-post-slug={post?.slug}>

    {post && (
      <>
        {/*  ---
             HERO — Portada Editorial
             ---  */}
        <header class="w-full relative mb-12 lg:mb-16">
          <div class="h-[65vh] min-h-[420px] w-full relative overflow-hidden">
            {post.cover_image ? (
              <img
                src={post.cover_image}
                alt={post.title}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-[3s] ease-out hover:scale-105"
                loading="eager"
              />
            ) : (
              <div class="absolute inset-0 bg-gradient-to-br from-zinc-900 via-zinc-800 to-zinc-900" />
            )}
            {/*  Gradiente editorial oscuro  */}
            <div class="absolute inset-0 bg-gradient-to-t from-[#111111] via-[#111111]/70 to-transparent z-10" />
            <div class="absolute inset-0 bg-gradient-to-b from-[#111111]/40 to-transparent z-10" />
          </div>

          {/*  Metadatos sobre la imagen  */}
          <div class="container mx-auto px-4 md:px-8 relative z-20 -mt-52 md:-mt-60">
            <div class="max-w-4xl mx-auto">

              {/*  Categoría / breadcrumb  */}
              <div class="flex items-center gap-2 mb-4">
                <a
                  href="/blog"
                  class="text-[#E4572E] text-xs font-sans font-bold uppercase tracking-[0.2em] hover:text-[#F2B134] transition-colors"
                >
                  Bitácora
                </a>
                <span class="text-zinc-600">/</span>
                {post.category && (
                  <span class="text-zinc-400 text-xs font-sans uppercase tracking-widest">
                    {post.category}
                  </span>
                )}
              </div>

              {/*  Título principal — Serif editorial  */}
              <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight tracking-tight text-balance mb-5">
                {post.title}
              </h1>

              {/*  Subtítulo  */}
              {post.subtitle && (
                <p class="font-sans text-lg md:text-xl text-zinc-400 leading-relaxed mb-6 max-w-2xl">
                  {post.subtitle}
                </p>
              )}

              {/*  Metadatos del artículo  */}
              <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-sans text-zinc-400 uppercase tracking-widest pt-2">
                <span>
                  <span class="text-[#E4572E] font-bold text-sm normal-case tracking-normal">por {post.author}</span>
                </span>
                {formattedDate && (
                  <>
                    <span class="text-zinc-700">·</span>
                    <span>{formattedDate}</span>
                  </>
                )}
                {post.read_time && (
                  <>
                    <span class="text-zinc-700">·</span>
                    <span>{post.read_time}</span>
                  </>
                )}
                <span class="text-zinc-700">·</span>
                <span class="flex items-center gap-1.5 text-zinc-400">
                  <svg class="w-3.5 h-3.5 text-[#E4572E]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.641 0-8.574-3.007-9.964-7.178Z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                  </svg>
                  {(post.views ?? 0).toLocaleString('es-CO')} lecturas
                </span>
              </div>

              {/*  Separador terracota  */}
              <div class="mt-8 w-16 h-[2px] bg-[#E4572E] rounded-full" />
            </div>
          </div>
        </header>

        {/*  ---
             BARRA DE ACCIONES RÁPIDAS (Compartir)
             ---  */}
        <div class="max-w-3xl mx-auto px-4 md:px-6 w-full mb-10">
          <div class="flex items-center justify-between border-y border-zinc-800 py-3 text-xs font-sans">
            <span class="text-zinc-500 uppercase tracking-widest text-[11px] font-semibold">
              Compartir este ensayo
            </span>
            <div class="flex items-center gap-3">
              <button
                type="button"
                id="copyPostLinkBtn"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-sm bg-zinc-900 border border-zinc-800 text-zinc-300 hover:text-white hover:border-[#E4572E] transition-all"
                title="Copiar enlace"
              >
                <svg class="w-3.5 h-3.5 text-[#E4572E]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"/>
                </svg>
                <span id="copyPostLinkText">Copiar enlace</span>
              </button>
              <a
                id="shareTwitterBtn"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="p-1.5 rounded-sm bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-700 transition-colors"
                title="Compartir en X / Twitter"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
              <a
                id="shareWhatsappBtn"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="p-1.5 rounded-sm bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-emerald-400 hover:border-zinc-700 transition-colors"
                title="Compartir en WhatsApp"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        {/*  ---
             CUERPO DEL ARTÍCULO — Tipografía Editorial
             ---  */}
        <article class="max-w-3xl mx-auto px-4 md:px-6 w-full pb-16">
          {formattedContent ? (
            <div
              class="prose prose-invert prose-lg md:prose-xl
                prose-p:font-sans prose-p:text-zinc-300 prose-p:leading-relaxed prose-p:font-normal
                prose-headings:font-serif prose-headings:text-white prose-headings:font-bold
                prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-4
                prose-h3:text-2xl prose-h3:mt-10 prose-h3:mb-3
                prose-a:text-[#E4572E] prose-a:no-underline hover:prose-a:underline
                prose-strong:text-white prose-strong:font-bold
                prose-em:text-zinc-300 prose-em:italic
                prose-blockquote:border-l-[#E4572E] prose-blockquote:border-l-4 prose-blockquote:pl-6
                prose-blockquote:text-zinc-400 prose-blockquote:not-italic prose-blockquote:font-serif prose-blockquote:text-xl
                prose-hr:border-zinc-800
                prose-img:rounded-sm prose-img:border prose-img:border-zinc-800
                max-w-none"
              set:html={formattedContent}
            />
          ) : (
            <p class="font-sans text-zinc-500 text-sm italic text-center py-16">
              Este artículo no tiene contenido disponible aún.
            </p>
          )}
        </article>

        {/*  ---
             TARJETA DEL AUTOR
             ---  */}
        <div class="max-w-3xl mx-auto px-4 md:px-6 w-full pb-16">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pt-10 border-t border-zinc-800">
            <div class="text-center sm:text-left">
              <h4 class="font-serif text-xl font-bold text-white mb-1">
                {authorSlug ? (
                  <a href={`/autores/${authorSlug}`} class="hover:text-[#E4572E] transition-colors">
                    {post.author}
                  </a>
                ) : (
                  post.author
                )}
              </h4>
              <div class="flex items-center justify-center sm:justify-start gap-3">
                <span class="text-xs uppercase tracking-[0.2em] text-zinc-500 font-sans font-medium">
                  Colaborador 870tivo
                </span>
                {authorSlug && (
                  <>
                    <span class="text-zinc-700">•</span>
                    <a
                      href={`/autores/${authorSlug}`}
                      class="text-xs font-sans font-bold uppercase tracking-wider text-[#E4572E] hover:text-white transition-colors"
                    >
                      Ver ficha completa →
                    </a>
                  </>
                )}
              </div>
            </div>

            {authorHandle && (
              <a
                href={`https://instagram.com/${authorHandle.replace(/^@/, '')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 bg-[#181818] text-white text-xs font-sans font-bold uppercase tracking-widest px-6 py-3 rounded-sm border border-zinc-800 hover:border-[#E4572E] hover:text-[#E4572E] transition-all w-full sm:w-auto"
              >
                @{authorHandle.replace(/^@/, '')}
              </a>
            )}
          </div>
        </div>

        {/*  ---
             LECTURAS RECOMENDADAS
             ---  */}
        {recommendedPosts.length > 0 && (
          <section class="max-w-4xl mx-auto px-4 md:px-6 w-full pb-16">
            <div class="border-t border-zinc-800 pt-12 pb-8">
              <div class="flex items-center gap-3 mb-8">
                <div class="w-2.5 h-2.5 bg-[#E4572E] rounded-full" />
                <h3 class="font-serif text-2xl font-bold text-white">
                  Otras lecturas de la bitácora
                </h3>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {recommendedPosts.map((rec) => (
                  <a
                    href={`/blog/${rec.slug}`}
                    class="group flex flex-col p-6 rounded-sm bg-[#181818] border border-zinc-800 hover:border-[#E4572E]/50 transition-all"
                  >
                    <span class="text-[#E4572E] text-[10px] font-sans font-bold uppercase tracking-widest mb-2">
                      {rec.category}
                    </span>
                    <h4 class="font-serif text-xl font-bold text-white group-hover:text-[#E4572E] transition-colors mb-2 leading-snug">
                      {rec.title}
                    </h4>
                    {rec.subtitle && (
                      <p class="font-sans text-xs text-zinc-400 line-clamp-2 leading-relaxed mb-4">
                        {rec.subtitle}
                      </p>
                    )}
                    <div class="mt-auto pt-4 border-t border-zinc-800/60 flex items-center justify-between text-[11px] font-sans text-zinc-500">
                      <span>por {rec.author}</span>
                      <span class="text-[#E4572E] font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                        Leer ensayo →
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </section>
        )}

        {/*  ---
             COMENTARIOS Y LIKES
             ---  */}
        <div class="max-w-3xl mx-auto px-4 md:px-6 w-full pb-24">
          <CommentSection
            client:visible
            postId={post.id}
            postSlug={post.slug}
            initialLikes={post.likes ?? 0}
          />
        </div>

        {/*  ---
             FOOTER NAVEGACIÓN
             ---  */}
        <div class="border-t border-zinc-800 py-10">
          <div class="max-w-4xl mx-auto px-4 md:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
            <a
              href="/blog"
              class="inline-flex items-center gap-2 text-xs font-sans font-bold uppercase tracking-widest text-zinc-400 hover:text-[#E4572E] transition-colors group"
            >
              <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
              </svg>
              Volver a la bitácora
            </a>
            <a
              href="/"
              class="inline-flex flex-col items-center gap-1 group"
            >
              <div class="w-10 h-10 bg-[#E4572E] flex items-center justify-center font-bold text-white text-sm uppercase tracking-tighter rounded-sm group-hover:brightness-110 transition-all">
                870
              </div>
              <span class="text-[10px] text-zinc-600 group-hover:text-[#E4572E] transition-colors uppercase tracking-widest font-sans">
                Inicio
              </span>
            </a>
          </div>
        </div>
      </>
    )}

    {!post && (
      <section class="max-w-3xl mx-auto px-4 py-28 text-center flex flex-col items-center justify-center flex-grow">
        <div class="select-none font-serif font-bold text-8xl md:text-9xl text-zinc-900 leading-none mb-2">
          404
        </div>

        <div class="w-12 h-[2px] bg-[#E4572E] rounded-full mx-auto mb-6" />

        <span class="text-xs font-sans font-bold uppercase tracking-[0.25em] text-[#E4572E] mb-3">
          Ensayo no disponible
        </span>

        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-5 tracking-tight leading-tight max-w-xl">
          La publicación que buscas no existe o fue despublicada
        </h1>

        <p class="font-sans text-zinc-400 text-sm sm:text-base max-w-lg mb-10 leading-relaxed">
          El artículo con el identificador &laquo;<span class="text-white font-mono text-xs">{slug}</span>&raquo; no se encuentra registrado en el archivo público de la plataforma cultural 870.
        </p>

        <div class="flex flex-col sm:flex-row items-center gap-4">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-sm bg-[#E4572E] hover:brightness-110 text-white font-sans font-bold text-xs uppercase tracking-[0.2em] shadow-lg shadow-[#E4572E]/20 transition-all hover:scale-105 active:scale-95"
          >
            <span>Explorar Bitácora</span>
          </a>
          <a
            href="/"
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-sm bg-transparent border border-zinc-700 hover:border-zinc-500 text-zinc-300 hover:text-white font-sans font-bold text-xs uppercase tracking-[0.2em] transition-all"
          >
            <span>&larr; Volver al Inicio</span>
          </a>
        </div>

        <div class="mt-16 flex flex-col items-center gap-2 opacity-30">
          <div class="w-8 h-8 bg-zinc-600 flex items-center justify-center font-bold text-white text-xs uppercase tracking-tighter rounded-sm">
            870
          </div>
          <span class="text-[10px] text-zinc-600 uppercase tracking-widest font-sans">870tivo</span>
        </div>
      </section>
    )}

  </main>
</BaseLayout>

<script>
  // ── Script de cliente: Compartir y Registro de Vista ─────────────────────
  if (typeof window !== 'undefined') {
    const copyBtn = document.getElementById('copyPostLinkBtn');
    const copyText = document.getElementById('copyPostLinkText');

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (copyText) copyText.textContent = '¡Enlace copiado!';
        copyBtn.classList.add('border-emerald-500/50', 'text-emerald-400');
        setTimeout(() => {
          if (copyText) copyText.textContent = 'Copiar enlace';
          copyBtn.classList.remove('border-emerald-500/50', 'text-emerald-400');
        }, 2500);
      } catch (err) {
        console.error('Error al copiar al portapapeles:', err);
      }
    });

    const twitterBtn = document.getElementById('shareTwitterBtn') as HTMLAnchorElement | null;
    const whatsappBtn = document.getElementById('shareWhatsappBtn') as HTMLAnchorElement | null;
    const currentUrl = window.location.href;
    const title = document.title;

    if (twitterBtn) {
      twitterBtn.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(currentUrl)}`;
    }
    if (whatsappBtn) {
      whatsappBtn.href = `https://api.whatsapp.com/send?text=${encodeURIComponent(`${title} — ${currentUrl}`)}`;
    }
  }
</script>
