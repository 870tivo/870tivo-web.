---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ChevronLeft, ChevronRight, Maximize2 } from 'lucide-astro';
---

<BaseLayout title="Galería 870 - 870tivo">
  <main class="flex-grow flex flex-col bg-brand-bg dark:bg-brand-ink relative transition-colors">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-card/60 dark:from-neutral-900 to-brand-bg dark:to-brand-ink z-0 pointer-events-none opacity-50"></div>
    
    <div class="container mx-auto px-4 md:px-6 pt-8 pb-16 flex-grow flex flex-col items-center justify-center relative z-10 w-full min-h-[85vh]">
      <div class="text-center mb-8">
        <span class="text-brand-orange dark:text-brand-turquoise text-xs font-bold uppercase tracking-[0.3em] mb-4 block">Exposición Virtual</span>
        <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold text-brand-ink dark:text-white mb-2 tracking-tighter">
          Hacer de tripas corazón
        </h1>
        <p class="text-brand-ink/70 dark:text-brand-muted font-medium max-w-sm mx-auto text-sm">
          Un collage interactivo explorando la angustia, la existencia y las emociones viscerales.
        </p>
      </div>

      <div class="relative w-full max-w-4xl aspect-[3/4] md:aspect-video bg-brand-ink rounded-sm p-1.5 md:p-3 border border-brand-ink/20 dark:border-white/5 flex items-center justify-center group overflow-hidden shadow-2xl">
        <button class="absolute left-2 md:left-6 z-30 w-10 h-10 md:w-14 md:h-14 bg-black/60 backdrop-blur-md rounded-full flex items-center justify-center text-white border border-white/10 hover:bg-brand-orange hover:text-white transition-colors duration-300 opacity-100 lg:opacity-0 lg:group-hover:opacity-100 translate-x-0 lg:-translate-x-4 lg:group-hover:translate-x-0 shadow-lg" aria-label="Anterior">
          <ChevronLeft class="w-6 h-6 mr-1" />
        </button>
        <button class="absolute right-2 md:right-6 z-30 w-10 h-10 md:w-14 md:h-14 bg-black/60 backdrop-blur-md rounded-full flex items-center justify-center text-white border border-white/10 hover:bg-brand-orange hover:text-white transition-colors duration-300 opacity-100 lg:opacity-0 lg:group-hover:opacity-100 translate-x-0 lg:translate-x-4 lg:group-hover:translate-x-0 shadow-lg" aria-label="Siguiente">
          <ChevronRight class="w-6 h-6 ml-1" />
        </button>
        <button class="absolute top-4 right-4 md:top-6 md:right-6 z-30 w-8 h-8 md:w-10 md:h-10 bg-black/60 backdrop-blur-md rounded-full flex items-center justify-center text-white border border-white/10 hover:bg-white hover:text-black transition-colors duration-300 opacity-100 lg:opacity-0 lg:group-hover:opacity-100" aria-label="Pantalla completa">
          <Maximize2 class="w-4 h-4 md:w-5 md:h-5" />
        </button>

        <div class="relative z-20 w-full h-full bg-brand-ink group-hover:scale-105 transition-transform duration-[3s] ease-out origin-center overflow-hidden flex items-center justify-center">
           <div class="absolute inset-0 bg-gradient-to-tr from-brand-ink via-zinc-900 to-brand-ink opacity-80 mix-blend-multiply"></div>
           <div class="absolute inset-0 border border-white/10 m-4"></div>
           <span class="text-brand-darkInk/40 font-serif text-3xl rotate-[-5deg] mix-blend-overlay">«Collage Principal»</span>
        </div>
      </div>
      
      <div class="flex gap-4 mt-8 overflow-x-auto w-full max-w-4xl snap-x pb-4 py-2 px-1">
        {[1,2,3,4,5,6].map((i) => (
          <div class={`shrink-0 w-20 h-20 md:w-28 md:h-28 rounded-sm overflow-hidden cursor-pointer snap-start transition-all duration-300 ${i === 1 ? 'ring-2 ring-brand-orange dark:ring-brand-bg ring-offset-2 ring-offset-brand-bg dark:ring-offset-brand-ink opacity-100 shadow-md' : 'border border-brand-ink/20 dark:border-white/10 opacity-50 hover:opacity-100'}`}>
            <div class="w-full h-full bg-brand-card/80 dark:bg-neutral-800 flex items-center justify-center">
              <span class="text-[10px] font-bold text-brand-ink/40 dark:text-white/20 select-none">{i}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
