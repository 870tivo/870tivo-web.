---
import '../styles/global.css';
import AdminSidebar from '../components/admin/AdminSidebar.astro';
import AdminHeader from '../components/admin/AdminHeader.astro';
import AdminSessionGuard from '../components/admin/AdminSessionGuard.astro';
import { FONTS_URL } from '../config/fonts';

interface Props {
  title?: string;
  headerTitle?: string;
  activeModule?: 'dashboard' | 'publicaciones' | string;
  /** Cuando es true: oculta el sidebar y elimina el padding-left compensatorio.
   *  Retrocompatible: todas las páginas existentes que no pasen esta prop
   *  siguen funcionando con sidebar exactamente igual que antes. */
  noSidebar?: boolean;
  /** Cuando es true: permite que el contenido utilice el 100% del ancho sin max-w-7xl */
  fullWidth?: boolean;
}

const { 
  title = 'Panel de Administración | 870tivo',
  headerTitle = 'Panel de Control',
  activeModule = 'dashboard',
  noSidebar = false,
  fullWidth = false,
} = Astro.props;

// SSR session retrieval from middleware
const user = Astro.locals.user;
const userEmail = user?.email || '';
const userFullName = Astro.locals.userFullName || '';
---

<!doctype html>
<html lang="es" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Panel privado de administración de Galería 870tivo" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={FONTS_URL} rel="stylesheet" />

    <!-- Anti-flicker Theme & Sidebar State Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'dark';
      })();

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
      }
      window.localStorage.setItem('theme', theme);

      // Estado persistente del Sidebar (Icon-Rail Colapsable)
      try {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('admin_sidebar_collapsed') === 'true') {
          document.documentElement.classList.add('sidebar-collapsed');
        }
      } catch (e) {}
    </script>

    <style is:global>
      /* Ensure admin theme follows the active dark/light mode */
      body.admin-body {
        background-color: var(--admin-bg, #111111) !important;
        color: var(--admin-ink, #FAF6F0) !important;
        transition: background-color 0.2s ease, color 0.2s ease;
      }
      /* Custom scrollbars for admin */
      .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
      }
      .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb {
        background: var(--admin-border, #282828);
        border-radius: 9999px;
        transition: background 0.15s ease;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: var(--admin-surface-subtle, #3a3a3a);
      }

      /* Transiciones fluidas del Sidebar colapsable (Icon-Rail) */
      #adminSidebar {
        transition: width 300ms cubic-bezier(0.4, 0, 0.2, 1), transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
      }
      #adminMainContent {
        transition: padding-left 300ms cubic-bezier(0.4, 0, 0.2, 1);
      }

      /* Reglas aplicadas cuando el Sidebar está en estado Colapsado (Icon-Rail) */
      @media (min-width: 1024px) {
        html.sidebar-collapsed #adminSidebar {
          width: 5rem !important; /* 80px (w-20) */
        }
        html.sidebar-collapsed #adminMainContent {
          padding-left: 5rem !important; /* 80px (pl-20) */
        }
        html.sidebar-collapsed .sidebar-label,
        html.sidebar-collapsed .sidebar-brand-text,
        html.sidebar-collapsed .sidebar-heading-text,
        html.sidebar-collapsed .sidebar-user-details,
        html.sidebar-collapsed .sidebar-active-dot {
          display: none !important;
        }
        html.sidebar-collapsed .sidebar-heading-divider {
          display: block !important;
        }
        html.sidebar-collapsed .sidebar-link {
          justify-content: center !important;
          padding-left: 0.5rem !important;
          padding-right: 0.5rem !important;
        }
        html.sidebar-collapsed .sidebar-header-inner {
          justify-content: center !important;
          padding-left: 0.5rem !important;
          padding-right: 0.5rem !important;
        }
        html.sidebar-collapsed .sidebar-header-toggle {
          display: none !important;
        }
        html.sidebar-collapsed .sidebar-collapse-icon {
          transform: rotate(180deg);
        }
        html.sidebar-collapsed .sidebar-user-card {
          flex-direction: column !important;
          align-items: center !important;
          padding: 0.5rem 0.25rem !important;
          gap: 0.5rem !important;
        }
        html.sidebar-collapsed .sidebar-rail-btn {
          justify-content: center !important;
          padding-left: 0.5rem !important;
          padding-right: 0.5rem !important;
        }
      }
    </style>
  </head>

  <body class="admin-body min-h-screen font-sans antialiased flex text-[#1F1B16] dark:text-[#FAF6F0] selection:bg-[#E4572E] selection:text-white">

    <!-- Navigation Sidebar: se omite cuando noSidebar=true -->
    {!noSidebar && (
      <AdminSidebar 
        activeModule={activeModule}
        userEmail={userEmail}
        userFullName={userFullName}
      />
    )}

    <!-- Main Content Area: con transition-all fluida -->
    <div id="adminMainContent" class={`flex-1 flex flex-col min-h-screen min-w-0 bg-[#FAF6F0] dark:bg-[#111111] transition-all duration-300 ease-in-out ${!noSidebar ? 'lg:pl-72' : ''}`}>
      
      <!-- Top Sticky Header -->
      <AdminHeader 
        title={headerTitle}
        activeModule={activeModule}
        userEmail={userEmail}
        userFullName={userFullName}
      />

      <!-- Content Container: full-width cuando fullWidth o noSidebar son true -->
      <main class={`flex-1 w-full px-4 sm:px-6 lg:px-8 py-8 sm:py-10 ${(!noSidebar && !fullWidth) ? 'max-w-7xl mx-auto' : ''}`}>
        <slot />
      </main>

      <!-- Admin Footer -->
      <footer class="border-t border-[#E5DFD5] dark:border-[#282828] bg-white dark:bg-[#141414] py-6 px-4 sm:px-6 lg:px-8 text-xs text-[#78716A] dark:text-neutral-400 transition-colors duration-200">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#2F4B3A]"></span>
            <span>&copy; {new Date().getFullYear()} <strong>870tivo Control Studio</strong> &mdash; Plataforma Administrativa Privada</span>
          </div>
          <div class="flex items-center gap-4 text-[#78716A] dark:text-neutral-400 text-xs">
            <span>Protegido con Supabase Auth & Astro SSR</span>
            <span>&bull;</span>
            <a href="/" target="_blank" class="hover:text-[#E4572E] transition-colors">Portal Web</a>
          </div>
        </div>
      </footer>

    </div>

    <!-- Defense-in-depth Client Auth Guard + Auto-Logout por Inactividad -->
    <AdminSessionGuard />

    <!-- NOTA: La validación de sesión es 100% SSR (Middleware).
         El script cliente de double-check fue eliminado porque:
         1. supabase.auth.getSession() lee sessionStorage (vacío en SSR),
            por lo que siempre devuelve null aunque las cookies sean válidas.
         2. Eso provoca clearAuthCookies() + redirect al login en cada carga,
            creando un bucle de autenticación infinito.
         El Middleware ya validó sb-access-token antes de renderizar esta página. -->
  </body>
</html>
