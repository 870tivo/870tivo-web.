---
import '../styles/global.css';
import AdminSidebar from '../components/admin/AdminSidebar.astro';
import AdminHeader from '../components/admin/AdminHeader.astro';

interface Props {
  title?: string;
  headerTitle?: string;
  activeModule?: 'dashboard' | 'publicaciones' | string;
}

const { 
  title = 'Panel de Administración | 870tivo',
  headerTitle = 'Panel de Control',
  activeModule = 'dashboard'
} = Astro.props;

// SSR session retrieval from middleware
const user = Astro.locals.user;
const userEmail = user?.email || '';
const fontsUrl = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap';
---

<!doctype html>
<html lang="es" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Panel privado de administración de Galería 870tivo" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontsUrl} rel="stylesheet" />

    <!-- Anti-flicker Theme Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'dark';
      })();

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>

    <style is:global>
      /* Ensure admin theme follows the active dark/light mode */
      body.admin-body {
        background-color: var(--admin-bg, #111111) !important;
        color: var(--admin-ink, #FAF6F0) !important;
        transition: background-color 0.2s ease, color 0.2s ease;
      }
      /* Custom scrollbars for admin */
      .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
      }
      .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb {
        background: var(--admin-border, #282828);
        border-radius: 9999px;
        transition: background 0.15s ease;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: var(--admin-surface-subtle, #3a3a3a);
      }
    </style>
  </head>

  <body class="admin-body min-h-screen font-sans antialiased flex text-[#1F1B16] dark:text-[#FAF6F0] selection:bg-[#E4572E] selection:text-white">

    <!-- Navigation Sidebar -->
    <AdminSidebar 
      activeModule={activeModule}
      userEmail={userEmail}
    />

    <!-- Main Content Area with offset for Sidebar -->
    <div class="flex-1 lg:pl-72 flex flex-col min-h-screen min-w-0 bg-[#FAF6F0] dark:bg-[#111111] transition-colors duration-200">
      
      <!-- Top Sticky Header -->
      <AdminHeader 
        title={headerTitle}
        activeModule={activeModule}
        userEmail={userEmail}
      />

      <!-- Content Container -->
      <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
        <slot />
      </main>

      <!-- Admin Footer -->
      <footer class="border-t border-[#E5DFD5] dark:border-[#282828] bg-white dark:bg-[#141414] py-6 px-4 sm:px-6 lg:px-8 text-xs text-[#78716A] dark:text-neutral-400 transition-colors duration-200">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#2F4B3A]"></span>
            <span>&copy; {new Date().getFullYear()} <strong>870tivo Control Studio</strong> &mdash; Plataforma Administrativa Privada</span>
          </div>
          <div class="flex items-center gap-4 text-[#78716A] dark:text-neutral-400 text-xs">
            <span>Protegido con Supabase Auth & Astro SSR</span>
            <span>&bull;</span>
            <a href="/" target="_blank" class="hover:text-[#E4572E] transition-colors">Portal Web</a>
          </div>
        </div>
      </footer>

    </div>

    <!-- Defense-in-depth Client Auth Guard -->
    <script>
      import { supabase, clearAuthCookies } from '../lib/supabase';

      // Check user session actively in client
      supabase.auth.getSession().then(({ data: { session }, error }) => {
        if (!session || error) {
          clearAuthCookies();
          window.location.href = '/admin/login';
        }
      });
    </script>
  </body>
</html>
