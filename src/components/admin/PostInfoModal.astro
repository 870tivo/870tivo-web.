---
/**
 * src/components/admin/PostInfoModal.astro
 * Modal de Detalle para el botón "Ver" de cada publicación.
 * Visualiza cabecera compacta, contador de vistas, lista de comentarios con opción de eliminación y enlace público.
 */
---

<div 
  id="postInfoModal" 
  class="fixed inset-0 z-[60] flex items-center justify-center p-3 sm:p-4 md:p-6 bg-black/80 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="postInfoModalTitle"
>
  <div 
    id="postInfoModalCard"
    class="relative w-full max-w-2xl max-h-[90vh] flex flex-col rounded-3xl bg-white dark:bg-[#141414] border border-[#E5DFD5] dark:border-[#282828] shadow-2xl transform scale-95 transition-all duration-300 overflow-hidden text-[#1F1B16] dark:text-[#FAF6F0]"
  >
    <!-- MODAL TOP BAR -->
    <div class="px-5 sm:px-7 py-4 border-b border-[#E5DFD5] dark:border-[#282828] bg-[#FAF6F0]/80 dark:bg-[#181818] flex items-center justify-between gap-3 shrink-0">
      <div class="flex items-center gap-2.5 min-w-0">
        <span class="w-2.5 h-2.5 rounded-full bg-[#E4572E] shrink-0"></span>
        <span class="admin-table-head text-[#78716A] dark:text-neutral-400">
          Detalle &bull; Publicación
        </span>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <!-- Enlace discreto a la web pública -->
        <a 
          id="postInfoPublicLink" 
          href="#" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#78716A] hover:text-[#E4572E] dark:text-neutral-400 dark:hover:text-[#F2B134] transition-colors group"
          title="Abrir este artículo en una nueva pestaña"
        >
          <span>Abrir artículo público</span>
          <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>

        <!-- Botón Cerrar -->
        <button 
          type="button" 
          id="closePostInfoModalBtn"
          class="p-1.5 text-[#78716A] hover:text-[#1F1B16] dark:text-neutral-400 dark:hover:text-white rounded-xl hover:bg-[#EAE4D9] dark:hover:bg-[#222222] transition-colors cursor-pointer"
          aria-label="Cerrar modal de detalle"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- MODAL BODY CON SCROLL -->
    <div class="p-5 sm:p-7 space-y-6 overflow-y-auto custom-scrollbar flex-1 bg-white dark:bg-[#141414]">
      
      <!-- 1. CABECERA COMPACTA DE LA PUBLICACIÓN -->
      <div class="p-4 sm:p-5 rounded-2xl bg-[#FAF6F0] dark:bg-[#181818] border border-[#E5DFD5] dark:border-[#282828] flex flex-col sm:flex-row items-start gap-4">
        <!-- Portada en miniatura -->
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl overflow-hidden bg-neutral-200 dark:bg-neutral-800 border border-[#E5DFD5] dark:border-[#282828] shrink-0 shadow-sm">
          <img 
            id="postInfoCover"
            src="/assets/logo/870.jpeg" 
            alt="Portada" 
            class="w-full h-full object-cover"
          />
        </div>

        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2 flex-wrap mb-1.5">
            <span id="postInfoCategory" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-[#F2B134]/15 text-[#966B0D] dark:text-[#F2B134] border border-[#F2B134]/30">
              EDITORIAL
            </span>
            <span id="postInfoStatusPill" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold border">
              <span id="postInfoStatusDot" class="w-1.5 h-1.5 rounded-full"></span>
              <span id="postInfoStatusText">Estado</span>
            </span>
          </div>

          <h3 id="postInfoTitle" class="admin-section-title text-base sm:text-lg text-[#1F1B16] dark:text-white line-clamp-2">
            Título de la publicación
          </h3>

          <div class="flex items-center gap-3 text-xs text-[#78716A] dark:text-neutral-400 mt-2 flex-wrap">
            <span class="inline-flex items-center gap-1.5 font-medium text-[#1F1B16] dark:text-neutral-200">
              <svg class="w-3.5 h-3.5 text-[#E4572E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span id="postInfoAuthor">Autor</span>
            </span>
            <span>&bull;</span>
            <span id="postInfoDate">Fecha</span>
          </div>
        </div>
      </div>

      <!-- 2. MÉTRICAS DESTACADAS: VISTAS Y ME GUSTA -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <!-- Contador de Vistas -->
        <div class="p-4 sm:p-5 rounded-2xl bg-[#FAF6F0] dark:bg-[#181818] border border-[#E5DFD5] dark:border-[#282828] flex items-center justify-between gap-3">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-[#2F4B3A]/10 dark:bg-[#2F4B3A]/25 border border-[#2F4B3A]/30 text-[#2F4B3A] dark:text-[#A7C7B3] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
            <div class="min-w-0">
              <div class="admin-kpi-label text-[#78716A] dark:text-neutral-400 truncate">
                Vistas Totales
              </div>
              <p class="text-[10px] sm:text-[11px] text-[#78716A] dark:text-neutral-400 mt-0.5 truncate">
                Lecturas por sesión
              </p>
            </div>
          </div>

          <div class="text-right shrink-0">
            <span id="postInfoViewsCount" class="font-sans text-2xl sm:text-3xl font-bold text-[#1F1B16] dark:text-white tracking-tight tabular-nums">
              0
            </span>
            <span class="block text-[9px] sm:text-[10px] text-[#78716A] dark:text-neutral-400 font-semibold uppercase tracking-widest">
              vistas
            </span>
          </div>
        </div>

        <!-- Contador de Me Gusta -->
        <div class="p-4 sm:p-5 rounded-2xl bg-[#FAF6F0] dark:bg-[#181818] border border-[#E5DFD5] dark:border-[#282828] flex items-center justify-between gap-3">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-[#E4572E]/10 dark:bg-[#E4572E]/20 border border-[#E4572E]/30 text-[#E4572E] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 sm:w-6 sm:h-6 fill-current" viewBox="0 0 24 24">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
              </svg>
            </div>
            <div class="min-w-0">
              <div class="admin-kpi-label text-[#78716A] dark:text-neutral-400 truncate">
                Me Gusta
              </div>
              <p class="text-[10px] sm:text-[11px] text-[#78716A] dark:text-neutral-400 mt-0.5 truncate">
                Aprecios del público
              </p>
            </div>
          </div>

          <div class="text-right shrink-0">
            <span id="postInfoLikesCount" class="font-sans text-2xl sm:text-3xl font-bold text-[#1F1B16] dark:text-white tracking-tight tabular-nums">
              0
            </span>
            <span class="block text-[9px] sm:text-[10px] text-[#78716A] dark:text-neutral-400 font-semibold uppercase tracking-widest">
              reacciones
            </span>
          </div>
        </div>
      </div>

      <!-- 3. COMENTARIOS RECIBIDOS -->
      <div class="space-y-3">
        <div class="flex items-center justify-between gap-2 border-b border-[#E5DFD5] dark:border-[#282828] pb-2.5">
          <div class="flex items-center gap-2">
            <h4 class="admin-section-title text-[#1F1B16] dark:text-white">
              Comentarios Recibidos
            </h4>
            <span id="postInfoCommentsCountBadge" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#E4572E]/10 text-[#E4572E] border border-[#E4572E]/30">
              0
            </span>
          </div>
          <span class="text-[11px] text-[#78716A] dark:text-neutral-400">
            Moderación en tiempo real
          </span>
        </div>

        <!-- Estado de carga -->
        <div id="postInfoCommentsLoading" class="py-8 text-center text-xs text-[#78716A] dark:text-neutral-400 hidden">
          <div class="w-6 h-6 border-2 border-[#E4572E] border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
          <span>Cargando comentarios...</span>
        </div>

        <!-- Estado vacío -->
        <div id="postInfoCommentsEmpty" class="py-8 text-center text-xs text-[#78716A] dark:text-neutral-400 hidden">
          <div class="w-10 h-10 rounded-xl bg-[#FAF6F0] dark:bg-[#181818] border border-[#E5DFD5] dark:border-[#282828] flex items-center justify-center mx-auto mb-2 text-[#78716A] dark:text-neutral-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </div>
          <p class="admin-empty-title text-[#1F1B16] dark:text-white">Aún no hay comentarios</p>
          <p class="admin-empty-description text-[#78716A] dark:text-neutral-400 mt-0.5">Esta publicación no ha recibido comentarios del público.</p>
        </div>

        <!-- Lista de comentarios -->
        <div id="postInfoCommentsList" class="space-y-2.5 max-h-60 overflow-y-auto custom-scrollbar pr-1">
          <!-- Inyectado dinámicamente -->
        </div>
      </div>

    </div>

    <!-- MODAL FOOTER -->
    <div class="px-5 sm:px-7 py-3.5 border-t border-[#E5DFD5] dark:border-[#282828] bg-[#FAF6F0]/80 dark:bg-[#181818] flex items-center justify-end">
      <button 
        type="button" 
        id="closePostInfoModalFooterBtn"
        class="px-4 py-2 rounded-xl border border-[#E5DFD5] dark:border-[#282828] bg-white dark:bg-[#222222] hover:bg-[#EAE4D9] dark:hover:bg-[#2a2a2a] text-[#1F1B16] dark:text-neutral-300 text-xs font-semibold transition-colors cursor-pointer"
      >
        Cerrar
      </button>
    </div>
  </div>
</div>

