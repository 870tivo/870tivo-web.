---
import AdminThemeToggle from './AdminThemeToggle.astro';

interface Props {
  title?: string;
  subtitle?: string;
  userEmail?: string;
  activeModule?: 'dashboard' | 'publicaciones' | string;
}

const { title = 'Dashboard', userEmail = '' } = Astro.props;
---

<header class="sticky top-0 z-30 bg-white/95 dark:bg-[#141414]/95 backdrop-blur border-b border-[#E5DFD5] dark:border-[#282828] px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between transition-colors duration-200">
  
  <!-- Left: Mobile Menu Trigger + Clean Horizontal Breadcrumb -->
  <div class="flex items-center gap-3 sm:gap-4 min-w-0">
    <!-- Hamburger button for mobile -->
    <button 
      type="button" 
      id="openSidebarBtn"
      class="lg:hidden p-2 -ml-1 text-[#78716A] hover:text-[#1F1B16] hover:bg-[#F5EFE6] dark:text-neutral-400 dark:hover:text-white dark:hover:bg-[#222222] rounded-xl transition-colors cursor-pointer"
      aria-label="Abrir menú de navegación"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Clean Horizontal Breadcrumb -->
    <nav aria-label="Ruta de navegación" class="flex items-center gap-2 text-xs sm:text-sm min-w-0">
      <span class="text-[#78716A] dark:text-neutral-400 font-medium">Panel</span>
      <svg class="w-3.5 h-3.5 text-[#A8A29E] dark:text-neutral-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-[#1F1B16] dark:text-white font-semibold tracking-tight truncate">
        {title}
      </span>
    </nav>
  </div>

  <!-- Right: Theme Toggle + Divider + User Chip / Logout -->
  <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
    
    <!-- Theme Toggle (Light / Dark Mode Icon) -->
    <AdminThemeToggle variant="icon" />

    <!-- Subtle Vertical Divider -->
    <div class="h-5 w-px bg-[#E5DFD5] dark:bg-[#282828]" aria-hidden="true"></div>

    <!-- Active User & Quick Logout Chip -->
    <div class="flex items-center gap-2 pl-1 pr-1.5 py-1 rounded-xl bg-white dark:bg-[#181818] border border-[#E5DFD5] dark:border-[#282828] shadow-xs">
      <!-- User Avatar -->
      <a 
        href="/admin/profile" 
        class="w-7 h-7 rounded-lg bg-[#E4572E] text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-xs hover:opacity-90 transition-opacity"
        id="headerUserAvatar"
        title="Ver mi perfil"
      >
        {(userEmail?.[0] || 'A').toUpperCase()}
      </a>

      <!-- User Email & Status -->
      <a 
        href="/admin/profile" 
        class="hidden sm:flex flex-col min-w-0 pr-1 hover:opacity-80 transition-opacity"
        title="Ver mi perfil"
      >
        <span class="text-xs font-semibold text-[#1F1B16] dark:text-neutral-200 truncate max-w-[130px] md:max-w-[170px]" id="headerUserEmail">
          {userEmail || 'Administrador'}
        </span>
        <span class="text-[10px] text-[#2F4B3A] dark:text-[#A7C7B3] font-medium flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-[#2F4B3A]"></span>
          En línea
        </span>
      </a>

      <!-- Quick Logout Button inside chip -->
      <button 
        type="button" 
        id="headerLogoutBtn"
        class="p-1.5 text-[#78716A] dark:text-neutral-400 hover:text-red-500 hover:bg-red-500/10 rounded-lg transition-colors cursor-pointer"
        title="Cerrar sesión segura"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
      </button>
    </div>

  </div>
</header>

<script>
  import { supabase, clearAuthCookies } from '../../lib/supabase';

  const openBtn = document.getElementById('openSidebarBtn');
  const sidebar = document.getElementById('adminSidebar');
  const backdrop = document.getElementById('sidebarBackdrop');
  const headerLogoutBtn = document.getElementById('headerLogoutBtn');

  // Open sidebar on mobile
  openBtn?.addEventListener('click', () => {
    sidebar?.classList.remove('-translate-x-full');
    backdrop?.classList.remove('hidden');
  });

  // Sync session email in header if present
  supabase.auth.getSession().then(({ data: { session } }) => {
    if (session?.user?.email) {
      const emailEl = document.getElementById('headerUserEmail');
      const avatarEl = document.getElementById('headerUserAvatar');
      if (emailEl) {
        emailEl.textContent = session.user.email;
        emailEl.title = session.user.email;
      }
      if (avatarEl) {
        avatarEl.textContent = session.user.email[0].toUpperCase();
      }
    }
  });

  // Handle Logout
  headerLogoutBtn?.addEventListener('click', async () => {
    try {
      headerLogoutBtn.classList.add('opacity-50', 'pointer-events-none');
      await supabase.auth.signOut();
      clearAuthCookies();
      window.location.href = '/admin/login';
    } catch (err) {
      console.error('Error al cerrar sesión:', err);
      clearAuthCookies();
      window.location.href = '/admin/login';
    }
  });
</script>
