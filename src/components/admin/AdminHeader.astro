---
interface Props {
  title?: string;
  subtitle?: string;
  userEmail?: string;
  activeModule?: 'dashboard' | 'publicaciones' | string;
}

const { title = 'Dashboard', activeModule = 'dashboard' } = Astro.props;
---

<header class="sticky top-0 z-30 bg-slate-950/80 backdrop-blur-md border-b border-slate-800/80 px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between">
  
  <!-- Left: Mobile Menu Trigger + Breadcrumb / Title -->
  <div class="flex items-center gap-3 sm:gap-4 min-w-0">
    <!-- Hamburger button for mobile -->
    <button 
      type="button" 
      id="openSidebarBtn"
      class="lg:hidden p-2 -ml-1 text-slate-400 hover:text-white rounded-xl hover:bg-slate-850/80 transition-colors"
      aria-label="Abrir menú de navegación"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Breadcrumb & Module Indicator -->
    <div class="flex flex-col min-w-0">
      <div class="flex items-center gap-1.5 text-[11px] text-slate-400 font-medium">
        <span>870tivo</span>
        <svg class="w-3 h-3 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-cyan-400 capitalize">{activeModule}</span>
      </div>
      <h1 class="text-base sm:text-lg font-semibold text-white tracking-tight truncate">
        {title}
      </h1>
    </div>
  </div>

  <!-- Right: Badges, Actions & Session Info -->
  <div class="flex items-center gap-2.5 sm:gap-4 shrink-0">
    
    <!-- Environment Shield Badge -->
    <div class="hidden md:flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-800 text-xs text-slate-300">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="font-medium text-[11px]">Panel Protegido</span>
    </div>

    <!-- Quick Link: Visit Public Site -->
    <a 
      href="/" 
      target="_blank" 
      rel="noopener noreferrer"
      class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-300 hover:text-white bg-slate-900/80 hover:bg-slate-850 rounded-xl border border-slate-800 hover:border-slate-700 transition-all"
      title="Ver sitio web de cara al público"
    >
      <span>Ver Sitio</span>
      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>

    <!-- Action Button: Create Post Shortcut -->
    <a 
      href="/admin/publicaciones#crear"
      class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-black bg-gradient-to-r from-amber-400 via-amber-300 to-amber-400 hover:from-amber-300 hover:to-amber-200 rounded-xl shadow-sm shadow-amber-500/20 hover:shadow-amber-500/30 transition-all duration-200"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
      </svg>
      <span class="hidden xs:inline">Nueva</span> Publicación
    </a>

    <!-- Quick Top Logout Button -->
    <button 
      type="button" 
      id="headerLogoutBtn"
      class="p-2 text-slate-400 hover:text-red-400 hover:bg-red-500/10 rounded-xl border border-transparent hover:border-red-500/20 transition-all cursor-pointer"
      title="Cerrar sesión segura"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
    </button>

  </div>
</header>

<script>
  import { supabase, clearAuthCookies } from '../../lib/supabase';

  const openBtn = document.getElementById('openSidebarBtn');
  const sidebar = document.getElementById('adminSidebar');
  const backdrop = document.getElementById('sidebarBackdrop');
  const headerLogoutBtn = document.getElementById('headerLogoutBtn');

  // Open sidebar on mobile
  openBtn?.addEventListener('click', () => {
    sidebar?.classList.remove('-translate-x-full');
    backdrop?.classList.remove('hidden');
  });

  // Handle Logout
  headerLogoutBtn?.addEventListener('click', async () => {
    try {
      headerLogoutBtn.classList.add('opacity-50', 'pointer-events-none');
      await supabase.auth.signOut();
      clearAuthCookies();
      window.location.href = '/admin/login';
    } catch (err) {
      console.error('Error al cerrar sesión:', err);
      clearAuthCookies();
      window.location.href = '/admin/login';
    }
  });
</script>
