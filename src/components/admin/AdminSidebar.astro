---
interface Props {
  currentPath?: string;
  activeModule?: 'dashboard' | 'publicaciones' | string;
  userEmail?: string;
}

const { currentPath = '/admin/dashboard', activeModule = 'dashboard', userEmail = '' } = Astro.props;
---

<aside 
  id="adminSidebar"
  class="fixed inset-y-0 left-0 z-50 w-72 bg-slate-950/95 border-r border-slate-800/80 backdrop-blur-xl flex flex-col justify-between transition-transform duration-300 ease-in-out -translate-x-full lg:translate-x-0"
  aria-label="Barra lateral de administración"
>
  <!-- Top: Logo & Branding -->
  <div class="p-6 border-b border-slate-800/60">
    <div class="flex items-center justify-between">
      <a href="/admin/dashboard" class="flex items-center gap-3.5 group">
        <div class="relative">
          <img 
            src="/assets/logo/870.jpeg" 
            alt="870tivo Logo" 
            class="w-10 h-10 object-cover rounded-xl shadow-md border border-slate-700/80 group-hover:border-cyan-400/60 transition-all duration-300"
          />
          <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-500 border-2 border-slate-950 rounded-full"></span>
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-2">
            <span class="font-serif font-bold text-lg leading-tight tracking-tight text-white group-hover:text-cyan-300 transition-colors">
              870tivo
            </span>
            <span class="text-[10px] font-semibold uppercase px-1.5 py-0.5 rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
              Admin
            </span>
          </div>
          <span class="text-[11px] text-slate-400 font-medium tracking-wide">
            Panel de Control
          </span>
        </div>
      </a>

      <!-- Mobile Close Button -->
      <button 
        type="button" 
        id="closeSidebarBtn"
        class="lg:hidden p-1.5 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800/60 transition-colors"
        aria-label="Cerrar menú"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Middle: Navigation Links -->
  <div class="flex-1 overflow-y-auto px-4 py-6 space-y-7 custom-scrollbar">
    
    <!-- Primary App Modules -->
    <div>
      <div class="px-3 mb-2 flex items-center justify-between">
        <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400">
          Módulos Principales
        </span>
      </div>
      <nav class="space-y-1.5">
        <!-- Dashboard Link -->
        <a 
          href="/admin/dashboard" 
          class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all group ${
            activeModule === 'dashboard'
              ? 'bg-gradient-to-r from-cyan-500/20 to-teal-500/10 text-cyan-300 border border-cyan-500/30 shadow-sm shadow-cyan-950/50'
              : 'text-slate-300 hover:text-white hover:bg-slate-900/80 border border-transparent'
          }`}
        >
          <div class="flex items-center gap-3">
            <svg class={`w-5 h-5 transition-colors ${activeModule === 'dashboard' ? 'text-cyan-400' : 'text-slate-400 group-hover:text-slate-200'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            <span>Dashboard</span>
          </div>
          {activeModule === 'dashboard' && (
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 shadow-sm shadow-cyan-400"></span>
          )}
        </a>

        <!-- Publicaciones Link -->
        <a 
          href="/admin/publicaciones" 
          class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all group ${
            activeModule === 'publicaciones'
              ? 'bg-gradient-to-r from-amber-500/20 to-orange-500/10 text-amber-300 border border-amber-500/30 shadow-sm shadow-amber-950/50'
              : 'text-slate-300 hover:text-white hover:bg-slate-900/80 border border-transparent'
          }`}
        >
          <div class="flex items-center gap-3">
            <svg class={`w-5 h-5 transition-colors ${activeModule === 'publicaciones' ? 'text-amber-400' : 'text-slate-400 group-hover:text-slate-200'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
            <span>Publicaciones</span>
          </div>
          <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-300 border border-amber-500/20">
            Editor
          </span>
        </a>
      </nav>
    </div>

    <!-- Secciones del Sitio (Visualización & Enlaces directos) -->
    <div>
      <div class="px-3 mb-2 flex items-center justify-between">
        <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400">
          Secciones de la Página
        </span>
        <span class="text-[10px] text-slate-500">Público</span>
      </div>
      <nav class="space-y-1">
        <a 
          href="/galeria" 
          target="_blank" 
          class="flex items-center justify-between px-3.5 py-2 rounded-xl text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-900/60 transition-colors group"
        >
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-cyan-400/80 group-hover:text-cyan-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>Galería 870</span>
          </div>
          <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-slate-300 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>

        <a 
          href="/cine-club" 
          target="_blank" 
          class="flex items-center justify-between px-3.5 py-2 rounded-xl text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-900/60 transition-colors group"
        >
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-amber-400/80 group-hover:text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
            </svg>
            <span>Cine Club</span>
          </div>
          <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-slate-300 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>

        <a 
          href="/redes" 
          target="_blank" 
          class="flex items-center justify-between px-3.5 py-2 rounded-xl text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-900/60 transition-colors group"
        >
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-pink-400/80 group-hover:text-pink-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
            <span>Redes & Archivo</span>
          </div>
          <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-slate-300 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>

        <a 
          href="/paginas/nosotros" 
          target="_blank" 
          class="flex items-center justify-between px-3.5 py-2 rounded-xl text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-900/60 transition-colors group"
        >
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-emerald-400/80 group-hover:text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span>Nosotros & Manifiesto</span>
          </div>
          <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-slate-300 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </nav>
    </div>

    <!-- Seguridad & Ajustes -->
    <div>
      <div class="px-3 mb-2 flex items-center justify-between">
        <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400">
          Seguridad & Cuenta
        </span>
      </div>
      <nav class="space-y-1">
        <a 
          href="/admin/reset-password" 
          class="flex items-center gap-2.5 px-3.5 py-2 rounded-xl text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-900/60 transition-colors group"
        >
          <svg class="w-4 h-4 text-slate-400 group-hover:text-cyan-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
          </svg>
          <span>Cambiar Contraseña</span>
        </a>

        <a 
          href="/" 
          target="_blank" 
          class="flex items-center justify-between px-3.5 py-2 rounded-xl text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-900/60 transition-colors group"
        >
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-slate-400 group-hover:text-amber-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
            <span>Ver Portal Público</span>
          </div>
          <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-slate-300 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </nav>
    </div>

  </div>

  <!-- Bottom: User Account Card & Logout -->
  <div class="p-4 border-t border-slate-800/80 bg-slate-950/80">
    <div class="p-3 rounded-2xl bg-slate-900/80 border border-slate-800 flex items-center justify-between gap-3">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-cyan-600 to-teal-400 flex items-center justify-center text-white font-bold text-sm shadow-inner shrink-0">
          {(userEmail?.[0] || 'A').toUpperCase()}
        </div>
        <div class="flex flex-col min-w-0">
          <span class="text-xs font-semibold text-white truncate max-w-[120px]" id="sidebarUserEmail" title={userEmail || 'Administrador'}>
            {userEmail || 'Administrador'}
          </span>
          <span class="text-[10px] text-emerald-400 flex items-center gap-1 font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            En línea (Supabase)
          </span>
        </div>
      </div>

      <button 
        type="button" 
        id="sidebarLogoutBtn"
        class="p-2 rounded-xl text-slate-400 hover:text-red-400 hover:bg-red-500/10 border border-transparent hover:border-red-500/20 transition-all duration-200 cursor-pointer shrink-0"
        title="Cerrar sesión de forma segura"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
      </button>
    </div>
  </div>
</aside>

<!-- Backdrop Overlay for Mobile -->
<div 
  id="sidebarBackdrop" 
  class="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm lg:hidden hidden transition-opacity duration-300"
  aria-hidden="true"
></div>

<script>
  import { supabase, clearAuthCookies } from '../../lib/supabase';

  const sidebar = document.getElementById('adminSidebar');
  const backdrop = document.getElementById('sidebarBackdrop');
  const closeBtn = document.getElementById('closeSidebarBtn');
  const sidebarLogoutBtn = document.getElementById('sidebarLogoutBtn');
  const sidebarUserEmail = document.getElementById('sidebarUserEmail');

  // Close sidebar on mobile
  function closeMobileSidebar() {
    sidebar?.classList.add('-translate-x-full');
    backdrop?.classList.add('hidden');
  }

  closeBtn?.addEventListener('click', closeMobileSidebar);
  backdrop?.addEventListener('click', closeMobileSidebar);

  // Sync session email if present
  supabase.auth.getSession().then(({ data: { session } }) => {
    if (session?.user?.email && sidebarUserEmail) {
      sidebarUserEmail.textContent = session.user.email;
      sidebarUserEmail.title = session.user.email;
    }
  });

  // Logout handler
  sidebarLogoutBtn?.addEventListener('click', async () => {
    try {
      sidebarLogoutBtn.classList.add('opacity-50', 'pointer-events-none');
      await supabase.auth.signOut();
      clearAuthCookies();
      window.location.href = '/admin/login';
    } catch (e) {
      console.error('Error al cerrar sesión:', e);
      clearAuthCookies();
      window.location.href = '/admin/login';
    }
  });
</script>
