---
/**
 * DashKpis.astro
 * Bloque de 4 KPIs con datos reales de Supabase.
 * Se renderiza 100% en SSR — sin carga cliente, sin parpadeos.
 *
 * KPI 1: Lecturas del Mes  → SUM(views) de posts publicados en los últimos 30 días
 * KPI 2: Publicación Estrella → post con más views en 30 días
 * KPI 3: Engagement Global → SUM(likes) + COUNT(comments) total en BD
 * KPI 4: Pulso de Actividades → actividades vigentes desglosadas por categoría
 */

import { supabaseAdmin } from '../../../lib/supabase';

// ── Tipos ──────────────────────────────────────────────────────
interface Post {
  id: string;
  title: string;
  slug: string;
  views: number;
  likes: number;
  status: string;
  created_at: string;
}

interface Activity {
  id: string;
  title: string;
  category: 'ciclos-cine' | 'club-lectura' | 'talleres' | 'encuentros';
  event_date: string;
  status: string;
}

// ── Helpers de fecha ───────────────────────────────────────────
const now = new Date();
const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1).toISOString();

// ══════════════════════════════════════════════════════════════
//  KPI 1 — LECTURAS DEL MES
//  SUM de views de todos los posts publicados
//  + comparativa con el mes anterior para calcular % de crecimiento
// ══════════════════════════════════════════════════════════════
let viewsThisMonth = 0;
let viewsLastMonth = 0;
let viewsGrowthPct = 0;

try {
  // Posts publicados este mes
  const { data: postsThisMonth } = await supabaseAdmin
    .from('posts')
    .select('views')
    .eq('status', 'publicado')
    .gte('created_at', startOfMonth);

  // Posts publicados el mes pasado
  const startOfLastMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1).toISOString();
  const { data: postsLastMonth } = await supabaseAdmin
    .from('posts')
    .select('views')
    .eq('status', 'publicado')
    .gte('created_at', startOfLastMonth)
    .lt('created_at', startOfMonth);

  viewsThisMonth = (postsThisMonth ?? []).reduce((acc: number, p: { views: number }) => acc + (p.views ?? 0), 0);
  viewsLastMonth = (postsLastMonth ?? []).reduce((acc: number, p: { views: number }) => acc + (p.views ?? 0), 0);

  if (viewsLastMonth > 0) {
    viewsGrowthPct = Math.round(((viewsThisMonth - viewsLastMonth) / viewsLastMonth) * 100);
  } else if (viewsThisMonth > 0) {
    viewsGrowthPct = 100; // primer mes con datos
  }
} catch {
  // fallback: valores en 0
}

// ══════════════════════════════════════════════════════════════
//  KPI 2 — PUBLICACIÓN ESTRELLA DEL MES
//  Post con más views en los últimos 30 días
// ══════════════════════════════════════════════════════════════
let topPost: { title: string; slug: string; views: number; pct: number } | null = null;

try {
  const { data: allPublished } = await supabaseAdmin
    .from('posts')
    .select('id, title, slug, views, status')
    .eq('status', 'publicado')
    .order('views', { ascending: false })
    .limit(10);

  if (allPublished && allPublished.length > 0) {
    const totalViews = (allPublished as Post[]).reduce((acc, p) => acc + (p.views ?? 0), 0);
    const best = allPublished[0] as Post;
    const pct = totalViews > 0 ? Math.round(((best.views ?? 0) / totalViews) * 100) : 0;
    topPost = {
      title: best.title,
      slug: best.slug,
      views: best.views ?? 0,
      pct,
    };
  }
} catch {
  // fallback: null
}

// ══════════════════════════════════════════════════════════════
//  KPI 3 — ENGAGEMENT GLOBAL
//  SUM(likes) de posts + COUNT de comments en tabla
// ══════════════════════════════════════════════════════════════
let totalLikes = 0;
let totalComments = 0;

try {
  const { data: likesPosts } = await supabaseAdmin
    .from('posts')
    .select('likes');

  totalLikes = (likesPosts ?? []).reduce((acc: number, p: { likes: number }) => acc + (p.likes ?? 0), 0);
} catch {
  // ok
}

try {
  const { count } = await supabaseAdmin
    .from('comments')
    .select('id', { count: 'exact', head: true });

  totalComments = count ?? 0;
} catch {
  // ok
}

// ══════════════════════════════════════════════════════════════
//  KPI 4 — PULSO DE ACTIVIDADES
//  Actividades vigentes (publicadas y con event_date futuro)
//  desglosadas por categoría
// ══════════════════════════════════════════════════════════════
interface ActivityCounts {
  'ciclos-cine': number;
  'club-lectura': number;
  talleres: number;
  encuentros: number;
}

let activityCounts: ActivityCounts = { 'ciclos-cine': 0, 'club-lectura': 0, talleres: 0, encuentros: 0 };
let totalActiveActivities = 0;
let nextActivityDate: string | null = null;
let nextActivityTitle: string | null = null;

try {
  const { data: activities } = await supabaseAdmin
    .from('activities')
    .select('id, title, category, event_date, status')
    .eq('status', 'publicado')
    .eq('is_published', true)
    .gte('event_date', now.toISOString())
    .order('event_date', { ascending: true });

  if (activities && activities.length > 0) {
    totalActiveActivities = activities.length;

    for (const act of activities as Activity[]) {
      if (act.category in activityCounts) {
        activityCounts[act.category as keyof ActivityCounts]++;
      }
    }

    // La más próxima
    const next = activities[0] as Activity;
    nextActivityDate = new Date(next.event_date).toLocaleDateString('es-CO', {
      day: 'numeric',
      month: 'short',
    });
    nextActivityTitle = next.title;
  }
} catch {
  // ok
}

// ── Helpers de formato ─────────────────────────────────────────
function formatNumber(n: number): string {
  if (n >= 1000) return `${(n / 1000).toFixed(1)}k`;
  return String(n);
}

const growthIsPositive = viewsGrowthPct >= 0;
const growthLabel = growthIsPositive ? `+${viewsGrowthPct}%` : `${viewsGrowthPct}%`;

// Labels de categorías para el Pulso
const categoryLabels: Record<keyof ActivityCounts, string> = {
  'ciclos-cine':  'Cine',
  'club-lectura': 'Lectura',
  talleres:       'Talleres',
  encuentros:     'Encuentros',
};
---

<!-- ════════════════════════════════════════════════════════════
     BLOQUE KPIs — 4 tarjetas en grid
════════════════════════════════════════════════════════════ -->
<section
  class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4"
  aria-label="Indicadores clave del mes"
>

  <!-- ── KPI 1: Lecturas del Mes ───────────────────────────── -->
  <article class="group relative flex flex-col justify-between gap-4 p-5 rounded-2xl bg-[#181818] border border-zinc-800 hover:border-[#E4572E]/40 transition-colors overflow-hidden">
    <!-- Brillo decorativo de fondo -->
    <div class="absolute -top-10 -right-10 w-32 h-32 rounded-full bg-[#E4572E]/5 blur-2xl pointer-events-none" aria-hidden="true"></div>

    <!-- Cabecera de tarjeta -->
    <div class="flex items-start justify-between gap-2 relative">
      <!-- Icono -->
      <span class="flex-shrink-0 w-9 h-9 rounded-xl bg-[#E4572E]/10 border border-[#E4572E]/20 flex items-center justify-center text-[#E4572E]">
        <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
      </span>
      <!-- Etiqueta del periodo -->
      <span class="font-sans text-[10px] font-bold uppercase tracking-wider text-zinc-600 mt-0.5">
        Este mes
      </span>
    </div>

    <!-- Métrica principal -->
    <div class="relative">
      <div class="text-4xl font-sans font-bold text-slate-100 tracking-tight leading-none tabular-nums">
        {formatNumber(viewsThisMonth)}
      </div>
      <div class="text-xs font-semibold text-slate-400 mt-1.5 font-sans">
        Lecturas del Mes
      </div>
    </div>

    <!-- Indicador de crecimiento -->
    <div class="flex items-center gap-2 relative">
      <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold ${
        growthIsPositive
          ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
          : 'bg-red-500/10 text-red-400 border border-red-500/20'
      }`}>
        {growthIsPositive
          ? <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 15l7-7 7 7"/></svg>
          : <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"/></svg>
        }
        {growthLabel}
      </span>
      <span class="text-[11px] text-zinc-600">vs. mes anterior</span>
    </div>
  </article>


  <!-- ── KPI 2: Publicación Estrella del Mes ──────────────── -->
  <article class="group relative flex flex-col justify-between gap-4 p-5 rounded-2xl bg-[#181818] border border-zinc-800 hover:border-[#F2B134]/40 transition-colors overflow-hidden">
    <div class="absolute -top-10 -right-10 w-32 h-32 rounded-full bg-[#F2B134]/5 blur-2xl pointer-events-none" aria-hidden="true"></div>

    <div class="flex items-start justify-between gap-2 relative">
      <span class="flex-shrink-0 w-9 h-9 rounded-xl bg-[#F2B134]/10 border border-[#F2B134]/20 flex items-center justify-center text-[#F2B134]">
        <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
        </svg>
      </span>
      <span class="font-sans text-[10px] font-bold uppercase tracking-wider text-zinc-600 mt-0.5">
        Top 30 días
      </span>
    </div>

    <div class="relative flex-1">
      {topPost ? (
        <>
          <!-- Título truncado a 2 líneas -->
          <p class="admin-item-title text-slate-100 line-clamp-2 mb-1" title={topPost.title}>
            {topPost.title}
          </p>
          <div class="flex items-center gap-2 mt-2">
            <span class="font-sans text-2xl font-bold text-[#F2B134] tabular-nums">
              {formatNumber(topPost.views)}
            </span>
            <span class="text-xs text-zinc-500 font-sans">vistas</span>
          </div>
        </>
      ) : (
        <p class="text-sm text-zinc-600 italic">Sin datos suficientes aún</p>
      )}
    </div>

    <!-- % del tráfico total -->
    {topPost && (
      <div class="relative">
        <!-- Barra de porcentaje -->
        <div class="flex items-center justify-between mb-1">
          <span class="text-[11px] text-zinc-500 font-sans">Participación en tráfico</span>
          <span class="text-[11px] font-sans font-bold text-[#F2B134] tabular-nums">{topPost.pct}%</span>
        </div>
        <div class="h-1.5 w-full rounded-full bg-zinc-800 overflow-hidden">
          <div
            class="h-full rounded-full bg-gradient-to-r from-[#F2B134] to-[#E4572E] transition-all duration-700"
            style={`width: ${topPost.pct}%`}
            role="progressbar"
            aria-valuenow={topPost.pct}
            aria-valuemin={0}
            aria-valuemax={100}
          ></div>
        </div>
      </div>
    )}
  </article>


  <!-- ── KPI 3: Engagement Global ─────────────────────────── -->
  <article class="group relative flex flex-col justify-between gap-4 p-5 rounded-2xl bg-[#181818] border border-zinc-800 hover:border-purple-500/30 transition-colors overflow-hidden">
    <div class="absolute -top-10 -right-10 w-32 h-32 rounded-full bg-purple-500/5 blur-2xl pointer-events-none" aria-hidden="true"></div>

    <div class="flex items-start justify-between gap-2 relative">
      <span class="flex-shrink-0 w-9 h-9 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400">
        <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
        </svg>
      </span>
      <span class="font-sans text-[10px] font-bold uppercase tracking-wider text-zinc-600 mt-0.5">
        Acumulado
      </span>
    </div>

    <!-- Métricas dobles -->
    <div class="relative grid grid-cols-2 gap-3">
      <!-- Likes -->
      <div>
        <div class="text-3xl font-sans font-bold text-slate-100 tabular-nums leading-none">
          {formatNumber(totalLikes)}
        </div>
        <div class="flex items-center gap-1 mt-1.5 font-sans">
          <svg class="w-3 h-3 text-[#E4572E]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
          <span class="text-[11px] text-zinc-500">Me gustas</span>
        </div>
      </div>
      <!-- Comentarios -->
      <div>
        <div class="text-3xl font-sans font-bold text-slate-100 tabular-nums leading-none">
          {formatNumber(totalComments)}
        </div>
        <div class="flex items-center gap-1 mt-1.5 font-sans">
          <svg class="w-3 h-3 text-[#F2B134]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
          </svg>
          <span class="text-[11px] text-zinc-500">Comentarios</span>
        </div>
      </div>
    </div>

    <!-- Engagement total combinado -->
    <div class="relative pt-3 border-t border-zinc-800">
      <div class="text-[11px] text-zinc-500 font-sans">
        Total de interacciones:
        <span class="font-sans font-bold text-purple-400 tabular-nums ml-1">{formatNumber(totalLikes + totalComments)}</span>
      </div>
    </div>
  </article>


  <!-- ── KPI 4: Pulso de Actividades ──────────────────────── -->
  <article class="group relative flex flex-col justify-between gap-4 p-5 rounded-2xl bg-[#181818] border border-zinc-800 hover:border-emerald-500/30 transition-colors overflow-hidden">
    <div class="absolute -top-10 -right-10 w-32 h-32 rounded-full bg-emerald-500/5 blur-2xl pointer-events-none" aria-hidden="true"></div>

    <div class="flex items-start justify-between gap-2 relative">
      <span class="flex-shrink-0 w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
        <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
      </span>
      <span class={`font-sans text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full border ${
        totalActiveActivities > 0
          ? 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20'
          : 'text-zinc-600 bg-zinc-800 border-zinc-700'
      }`}>
        {totalActiveActivities > 0 ? 'Vigentes' : 'Sin prog.'}
      </span>
    </div>

    <!-- Contador total grande -->
    <div class="relative">
      <div class="text-4xl font-sans font-bold text-slate-100 tabular-nums leading-none">
        {totalActiveActivities}
      </div>
      <div class="text-xs font-semibold text-slate-400 mt-1.5 font-sans">
        Actividades programadas
      </div>
    </div>

    <!-- Desglose por categoría -->
    <div class="relative space-y-1.5 font-sans">
      {(Object.entries(activityCounts) as [keyof ActivityCounts, number][]).map(([cat, count]) => (
        <div class="flex items-center justify-between">
          <span class="text-[11px] text-zinc-500">{categoryLabels[cat]}</span>
          <div class="flex items-center gap-2">
            <!-- Mini barra -->
            <div class="w-16 h-1 rounded-full bg-zinc-800 overflow-hidden">
              <div
                class="h-full rounded-full bg-emerald-500/60"
                style={`width: ${totalActiveActivities > 0 ? Math.round((count / totalActiveActivities) * 100) : 0}%`}
              ></div>
            </div>
            <span class="font-sans text-[11px] font-semibold text-slate-400 w-3 text-right tabular-nums">{count}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Próxima fecha -->
    {nextActivityDate && (
      <div class="relative pt-3 border-t border-zinc-800">
        <div class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse flex-shrink-0"></span>
          <span class="text-[11px] text-zinc-500 truncate">
            Próx.: <span class="text-emerald-400 font-semibold">{nextActivityDate}</span>
            {nextActivityTitle && <span class="text-zinc-600"> · {nextActivityTitle.substring(0, 24)}{nextActivityTitle.length > 24 ? '…' : ''}</span>}
          </span>
        </div>
      </div>
    )}
  </article>

</section>
