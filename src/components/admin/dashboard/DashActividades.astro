---
/**
 * DashActividades.astro
 * Columna Derecha del Bloque Central del Dashboard:
 * Módulo Integral de Actividades Culturales (Ciclos de Cine, Club de Lectura, Talleres, Encuentros).
 *
 * - SSR con Supabase (tabla `activities`).
 * - Filtros rápidos interactivos por categoría (client-side sin recargar).
 * - Toggle directo de estado (publicado/borrador) vía `/api/admin/activities/toggle-status`.
 * - Acciones de gestión y enlace a crear nueva jornada.
 */

import { supabaseAdmin } from '../../../lib/supabase';
import type { ActivityCategory } from '../../../types/database';

interface Props {
  adminBase?: string;
}

const { adminBase = '/2416f50b-da02-4a5b-86a8-61ae470ed3bd' } = Astro.props;

interface ActivityItem {
  id: string;
  slug: string;
  title: string;
  category: ActivityCategory;
  event_date: string;
  location: string;
  status: string;
  is_published: boolean;
}

let activitiesList: ActivityItem[] = [];

try {
  const { data, error } = await supabaseAdmin
    .from('activities')
    .select('id, slug, title, category, event_date, location, status, is_published')
    .order('event_date', { ascending: true })
    .limit(10);

  if (!error && data && data.length > 0) {
    activitiesList = data as ActivityItem[];
  } else {
    // Semillas de respaldo
    activitiesList = [
      {
        id: 'act-1',
        slug: 'ciclo-cine-la-vendedora-de-rosas',
        title: 'Ciclo de Cine: La Vendedora de Rosas',
        category: 'ciclos-cine',
        event_date: new Date(Date.now() + 5 * 24 * 60 * 60 * 1000).toISOString(),
        location: 'Sala Audiovisual 870',
        status: 'publicado',
        is_published: true,
      },
      {
        id: 'act-2',
        slug: 'club-lectura-voces-memoria',
        title: 'Club de Lectura: Voces de la Memoria',
        category: 'club-lectura',
        event_date: new Date(Date.now() + 10 * 24 * 60 * 60 * 1000).toISOString(),
        location: 'Biblioteca Comunitaria',
        status: 'publicado',
        is_published: true,
      },
      {
        id: 'act-3',
        slug: 'taller-serigrafia-cartelismo',
        title: 'Taller Práctico: Serigrafía Popular',
        category: 'talleres',
        event_date: new Date(Date.now() + 14 * 24 * 60 * 60 * 1000).toISOString(),
        location: 'Taller de Gráfica 870',
        status: 'borrador',
        is_published: false,
      },
      {
        id: 'act-4',
        slug: 'encuentro-dialogos-inmateriales',
        title: 'Encuentro Abierto: Diálogos Inmateriales',
        category: 'encuentros',
        event_date: new Date(Date.now() + 21 * 24 * 60 * 60 * 1000).toISOString(),
        location: 'Patio Central 870',
        status: 'publicado',
        is_published: true,
      },
    ];
  }
} catch {
  activitiesList = [];
}

// Configuración visual por categoría
const categoryMeta: Record<
  ActivityCategory,
  { label: string; badgeClass: string; dotClass: string }
> = {
  'ciclos-cine': {
    label: 'Cine',
    badgeClass: 'bg-indigo-500/10 text-indigo-400 border-indigo-500/25',
    dotClass: 'bg-indigo-400',
  },
  'club-lectura': {
    label: 'Lectura',
    badgeClass: 'bg-[#F2B134]/10 text-[#F2B134] border-[#F2B134]/25',
    dotClass: 'bg-[#F2B134]',
  },
  talleres: {
    label: 'Taller',
    badgeClass: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/25',
    dotClass: 'bg-emerald-400',
  },
  encuentros: {
    label: 'Encuentro',
    badgeClass: 'bg-[#E4572E]/10 text-[#E4572E] border-[#E4572E]/25',
    dotClass: 'bg-[#E4572E]',
  },
};

function formatEventDate(dateStr: string): string {
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('es-CO', {
      day: 'numeric',
      month: 'short',
      hour: '2-digit',
      minute: '2-digit',
    });
  } catch {
    return dateStr;
  }
}
---

<div class="h-full flex flex-col rounded-2xl bg-[#181818] border border-zinc-800 shadow-sm overflow-hidden" id="dashActividadesCard">
  <!-- Cabecera de la Tarjeta -->
  <div class="p-4 sm:p-5 border-b border-zinc-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-[#151515]/80">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <div>
        <h3 class="text-sm sm:text-base font-bold font-serif text-slate-100 tracking-tight leading-none">
          Programación Cultural
        </h3>
        <p class="text-[11px] text-slate-400 mt-1">
          Cartelera activa de ciclos, talleres y jornadas
        </p>
      </div>
    </div>

    <!-- Botón Nueva Actividad -->
    <a
      href={`${adminBase}/actividades?new=1`}
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-slate-100 border border-zinc-700 hover:border-zinc-600 text-xs font-semibold transition-all self-start sm:self-auto cursor-pointer"
      title="Crear nueva jornada o evento cultural"
    >
      <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
      </svg>
      <span>Nueva Jornada</span>
    </a>
  </div>

  <!-- Filtro Rápido de Categorías (Pills) -->
  <div class="px-4 py-2.5 bg-zinc-900/40 border-b border-zinc-800/80 flex items-center gap-1.5 overflow-x-auto text-xs no-scrollbar">
    <span class="text-[11px] text-slate-500 font-medium mr-1 uppercase tracking-wider shrink-0">Filtro:</span>
    <button
      type="button"
      data-filter="all"
      class="filter-act-btn active-filter px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-zinc-800 text-slate-100 border border-zinc-700 transition-all cursor-pointer shrink-0"
    >
      Todas ({activitiesList.length})
    </button>
    <button
      type="button"
      data-filter="ciclos-cine"
      class="filter-act-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold text-slate-400 hover:text-slate-200 transition-all cursor-pointer shrink-0"
    >
      Cine
    </button>
    <button
      type="button"
      data-filter="club-lectura"
      class="filter-act-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold text-slate-400 hover:text-slate-200 transition-all cursor-pointer shrink-0"
    >
      Lectura
    </button>
    <button
      type="button"
      data-filter="talleres"
      class="filter-act-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold text-slate-400 hover:text-slate-200 transition-all cursor-pointer shrink-0"
    >
      Talleres
    </button>
    <button
      type="button"
      data-filter="encuentros"
      class="filter-act-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold text-slate-400 hover:text-slate-200 transition-all cursor-pointer shrink-0"
    >
      Encuentros
    </button>
  </div>

  <!-- Lista Compacta de Actividades -->
  <div class="flex-1 overflow-y-auto divide-y divide-zinc-800/50 max-h-[380px] custom-scrollbar" id="activitiesListContainer">
    {activitiesList.length === 0 ? (
      <div class="py-12 text-center text-slate-500 text-xs italic">
        No hay actividades programadas.
      </div>
    ) : (
      activitiesList.map((act) => {
        const meta = categoryMeta[act.category] || {
          label: act.category,
          badgeClass: 'bg-zinc-800 text-slate-400 border-zinc-700',
          dotClass: 'bg-slate-400',
        };
        const isPub = act.status === 'publicado' || act.is_published;

        return (
          <div
            class="activity-item p-3.5 sm:px-4 hover:bg-zinc-800/30 transition-colors flex items-center justify-between gap-3 group"
            data-category={act.category}
            data-activity-id={act.id}
          >
            <!-- Lado Izquierdo: Categoría, Título y Metadatos -->
            <div class="flex items-start gap-3 min-w-0 flex-1">
              <!-- Pill de Categoría -->
              <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-semibold border shrink-0 mt-0.5 ${meta.badgeClass}`}>
                <span class={`w-1.5 h-1.5 rounded-full ${meta.dotClass}`}></span>
                {meta.label}
              </span>

              <!-- Título & Fecha/Lugar -->
              <div class="min-w-0 flex-1">
                <a
                  href={`${adminBase}/actividades?edit=${act.slug}`}
                  class="font-semibold text-slate-200 group-hover:text-emerald-400 transition-colors truncate block text-xs"
                  title={act.title}
                >
                  {act.title}
                </a>
                <div class="flex flex-wrap items-center gap-2 mt-1 text-[11px] text-slate-500 font-mono">
                  <span class="text-slate-400 flex items-center gap-1">
                    <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    {formatEventDate(act.event_date)}
                  </span>
                  <span>·</span>
                  <span class="truncate max-w-[120px]">{act.location || 'Sede 870'}</span>
                </div>
              </div>
            </div>

            <!-- Lado Derecho: Badge de Estado y Botones de Acción -->
            <div class="flex items-center gap-2 shrink-0">
              <!-- Badge de Estado -->
              <span
                class={`status-badge-act inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold border ${
                  isPub
                    ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20'
                    : 'bg-amber-500/10 text-amber-400 border-amber-500/20'
                }`}
              >
                <span class={`status-dot w-1.5 h-1.5 rounded-full ${isPub ? 'bg-emerald-400' : 'bg-amber-400'}`}></span>
                <span class="status-label">{isPub ? 'Activo' : 'Borrador'}</span>
              </span>

              <!-- Toggle Estado Rápido -->
              <button
                type="button"
                class="toggle-act-btn p-1.5 rounded-lg border border-zinc-700/60 bg-zinc-800 hover:bg-zinc-700 text-slate-300 hover:text-white transition-colors cursor-pointer"
                data-id={act.id}
                data-published={isPub ? 'true' : 'false'}
                title={isPub ? 'Ocultar jornada de la cartelera' : 'Publicar jornada en la cartelera'}
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </button>

              <!-- Editar -->
              <a
                href={`${adminBase}/actividades?edit=${act.slug}`}
                class="p-1.5 rounded-lg border border-zinc-700/60 bg-zinc-800 hover:bg-zinc-700 text-slate-300 hover:text-white transition-colors"
                title="Editar actividad completa"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                </svg>
              </a>
            </div>
          </div>
        );
      })
    )}
  </div>

  <!-- Pie de la Tarjeta -->
  <div class="p-3 bg-zinc-900/30 border-t border-zinc-800 flex items-center justify-between text-xs text-slate-400">
    <div class="flex items-center gap-1.5 text-[11px]">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Cartelera sincronizada en vivo</span>
    </div>
    <a
      href={`${adminBase}/actividades`}
      class="hover:text-slate-200 transition-colors inline-flex items-center gap-1 text-[11px] font-semibold text-[#E4572E]"
    >
      <span>Ver toda la cartelera</span>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>

<script>
  function setupActivitiesInteractive() {
    const card = document.getElementById('dashActividadesCard');
    if (!card) return;

    // 1. Filtrado dinámico por categoría
    const filterBtns = card.querySelectorAll<HTMLButtonElement>('.filter-act-btn');
    const items = card.querySelectorAll<HTMLElement>('.activity-item');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;
        if (!filter) return;

        // Actualizar estados visuales de los botones
        filterBtns.forEach((b) => {
          b.classList.remove('bg-zinc-800', 'text-slate-100', 'border', 'border-zinc-700');
          b.classList.add('text-slate-400');
        });

        btn.classList.add('bg-zinc-800', 'text-slate-100', 'border', 'border-zinc-700');
        btn.classList.remove('text-slate-400');

        // Filtrar elementos
        items.forEach((item) => {
          const itemCat = item.dataset.category;
          if (filter === 'all' || itemCat === filter) {
            item.classList.remove('hidden');
            item.classList.add('flex');
          } else {
            item.classList.add('hidden');
            item.classList.remove('flex');
          }
        });
      });
    });

    // 2. Toggle rápido de visibilidad de actividad
    const toggleBtns = card.querySelectorAll<HTMLButtonElement>('.toggle-act-btn');
    toggleBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        const currentPub = btn.dataset.published === 'true';
        const nextPub = !currentPub;
        const nextStatus = nextPub ? 'publicado' : 'borrador';

        btn.disabled = true;
        btn.classList.add('opacity-50');

        try {
          const res = await fetch('/api/admin/activities/toggle-status', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              id,
              is_published: nextPub,
              status: nextStatus,
            }),
          });

          const result = await res.json();
          if (res.ok && result.success) {
            btn.dataset.published = String(nextPub);
            btn.title = nextPub ? 'Ocultar jornada de la cartelera' : 'Publicar jornada en la cartelera';

            const row = btn.closest('.activity-item');
            const badge = row?.querySelector('.status-badge-act');
            const dot = row?.querySelector('.status-dot');
            const label = row?.querySelector('.status-label');

            if (badge && dot && label) {
              if (nextPub) {
                badge.className = 'status-badge-act inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold border bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
                dot.className = 'status-dot w-1.5 h-1.5 rounded-full bg-emerald-400';
                label.textContent = 'Activo';
              } else {
                badge.className = 'status-badge-act inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold border bg-amber-500/10 text-amber-400 border-amber-500/20';
                dot.className = 'status-dot w-1.5 h-1.5 rounded-full bg-amber-400';
                label.textContent = 'Borrador';
              }
            }
          } else {
            alert(result.message || 'Error al cambiar estado de la actividad.');
          }
        } catch (e) {
          console.error('Error toggling activity:', e);
          alert('Error de conexión.');
        } finally {
          btn.disabled = false;
          btn.classList.remove('opacity-50');
        }
      });
    });
  }

  setupActivitiesInteractive();
  document.addEventListener('astro:page-load', setupActivitiesInteractive);
  document.addEventListener('astro:after-swap', setupActivitiesInteractive);
</script>

