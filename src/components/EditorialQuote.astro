<section class="py-20 md:py-32 border-y border-brand-ink/10 dark:border-white/5 my-12 md:my-20 relative overflow-hidden transition-colors">
  <!-- Decorative background elements -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-lg h-full bg-brand-bg/20 dark:bg-brand-bg/5 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-4xl mx-auto text-center px-4 relative z-10">
    <div class="w-12 h-1 bg-brand-orange dark:bg-brand-bg mx-auto mb-12 opacity-80"></div>
    
    <blockquote class="font-serif text-3xl md:text-5xl lg:text-6xl font-normal leading-tight md:leading-[1.15] tracking-[0.01em] text-brand-ink dark:text-white mb-10 text-balance">
      «El cine y la palabra no registran la realidad:<br class="hidden md:block"/> <span class="text-brand-orange dark:text-brand-bg font-bold italic">fabrican la única resistencia inmaterial</span><br class="hidden md:block"/> frente al olvido.»
    </blockquote>
    
    <div class="w-8 h-8 border border-brand-orange/40 dark:border-brand-bg/40 rotate-45 mx-auto flex items-center justify-center mt-12 mb-4">
      <div class="w-1.5 h-1.5 bg-brand-orange dark:bg-brand-bg"></div>
    </div>
  </div>
</section>
