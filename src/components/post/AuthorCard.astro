---
/**
 * src/components/post/AuthorCard.astro
 * Tarjeta de pie de artículo que presenta la firma del autor,
 * enlace a su perfil individual en el colectivo y su handle social.
 */
interface Props {
  author: string;
  authorHandle: string;
  authorSlug?: string | null;
}

const { author, authorHandle, authorSlug } = Astro.props;
const profileUrl = authorSlug ? `/autores/${authorSlug}` : null;
---

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 mb-16 relative pt-10 border-t border-brand-ink/10 dark:border-white/10">
  <div class="text-center sm:text-left">
    <h4 class="font-serif text-xl font-bold text-brand-ink dark:text-white mb-1">
      {profileUrl ? (
        <a href={profileUrl} class="hover:text-brand-orange dark:hover:text-brand-orange transition-colors">
          {author}
        </a>
      ) : (
        author
      )}
    </h4>
    <div class="flex items-center justify-center sm:justify-start gap-3">
      <span class="text-xs uppercase tracking-[0.2em] text-brand-muted font-medium">
        Colaborador 870tivo
      </span>
      {profileUrl && (
        <>
          <span class="text-brand-muted/40">•</span>
          <a
            href={profileUrl}
            class="text-xs font-bold uppercase tracking-wider text-brand-orange hover:text-brand-ink dark:hover:text-white transition-colors"
          >
            Ver ficha completa &rarr;
          </a>
        </>
      )}
    </div>
  </div>

  <a
    href={`https://instagram.com/${authorHandle.replace(/^@/, '')}`}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center gap-2 bg-brand-card dark:bg-brand-darkCard text-brand-ink dark:text-white text-xs font-bold uppercase tracking-widest px-6 py-3 rounded-full border border-brand-ink/10 dark:border-white/10 hover:border-brand-orange dark:hover:border-brand-bg hover:text-brand-orange dark:hover:text-brand-bg transition-all w-full sm:w-auto shadow-sm"
  >
    @{authorHandle.replace(/^@/, '')}
  </a>
</div>
