---
interface Props {
  title: string;
  author: string;
  date: string;
}
const { title, author, date } = Astro.props;
---
<header class="w-full relative mb-12 lg:mb-16">
  <div class="h-[60vh] min-h-[400px] w-full bg-brand-ink relative overflow-hidden border-b border-brand-ink/10 dark:border-white/5">
    <div class="absolute inset-0 bg-neutral-900 transition-transform duration-[2s] ease-out hover:scale-105">
      <div class="absolute inset-0 bg-gradient-to-t from-brand-bg dark:from-brand-ink via-brand-bg/60 dark:via-brand-ink/60 to-transparent z-20"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-neutral-800 to-black mix-blend-multiply opacity-80 z-10"></div>
    </div>
  </div>
  
  <div class="container mx-auto px-4 md:px-6 relative z-30 -mt-32 md:-mt-40">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="font-serif text-4xl md:text-5xl lg:text-7xl font-bold text-brand-ink dark:text-white mb-6 leading-tight tracking-tight text-balance">
        {title}
      </h1>
      <p class="text-brand-ink/70 dark:text-brand-muted font-medium text-sm md:text-base uppercase tracking-[0.2em] mb-10 flex flex-col items-center gap-3">
        <span class="text-brand-orange dark:text-brand-bg font-bold">por {author}</span>
        <span class="text-[10px] md:text-xs text-brand-ink/50 dark:text-white/50">{date}</span>
      </p>
      
      <a href="/" class="inline-flex flex-col items-center gap-4 group">
        <div class="w-16 h-16 bg-brand-orange dark:bg-brand-bg flex items-center justify-center font-bold text-white dark:text-brand-ink text-lg uppercase tracking-tighter rounded-sm group-hover:brightness-110 transition-all duration-300 shadow-lg">
          870
        </div>
        <span class="text-[10px] text-brand-ink/60 dark:text-brand-muted/70 group-hover:text-brand-orange dark:group-hover:text-white transition-colors duration-300 uppercase tracking-widest">(Volver al inicio)</span>
      </a>
    </div>
  </div>
</header>
