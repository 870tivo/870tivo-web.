---
import BentoCardFeatured from './BentoCardFeatured.astro';
import BentoCardStandard from './BentoCardStandard.astro';
import type { SupabasePost } from '../../types/posts';

interface Props {
  posts?: SupabasePost[];
}

const { posts = [] } = Astro.props;

const featured = posts[0] ?? null;
const secondary = posts.slice(1, 4);
---
<section class="mt-8 pt-8 border-t border-brand-ink/10 dark:border-white/10">
  <div class="mb-10">
    <div class="flex items-center gap-3 mb-3">
      <span class="inline-block w-3 h-3 bg-brand-orange rounded-full"></span>
      <span class="text-xs uppercase tracking-[0.25em] font-bold text-brand-ink/70 dark:text-brand-turquoise">Colección Editorial</span>
    </div>
    <h1 class="font-serif text-4xl md:text-5xl lg:text-7xl font-bold tracking-[-0.02em] text-brand-ink dark:text-white mb-4">
      Encuentros Inmateriales
    </h1>
    <p class="text-brand-ink/80 dark:text-brand-muted max-w-2xl text-lg md:text-xl font-medium">
      Explorando las intersecciones entre la literatura, el cine y las artes visuales contemporáneas.
    </p>
  </div>

  {posts.length === 0 ? (
    <div class="py-16 text-center rounded-2xl bg-brand-card/40 dark:bg-neutral-900/40 border border-brand-ink/10 dark:border-white/5">
      <p class="font-serif text-lg text-brand-muted">Próximamente nuevas publicaciones editoriales.</p>
      <p class="text-xs text-brand-muted/60 mt-1">Vuelve pronto.</p>
    </div>
  ) : (
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 md:gap-5 auto-rows-[250px] md:auto-rows-[300px]">
      {featured && (
        <BentoCardFeatured
          title={featured.title}
          excerpt={featured.subtitle ?? (featured.content?.slice(0, 160) + '…')}
          author={featured.author}
          badge={featured.category}
          link={`/blog/${featured.slug}`}
          image={featured.cover_image ?? undefined}
        />
      )}
      {secondary.map((post) => (
        <BentoCardStandard
          title={post.title}
          category={post.category}
          author={post.author}
          link={`/blog/${post.slug}`}
        />
      ))}
    </div>
  )}
</section>
