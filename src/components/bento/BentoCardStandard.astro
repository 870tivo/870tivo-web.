---
interface Props {
  title: string;
  category: string;
  author: string;
  isWide?: boolean;
}
const { title, category, author, isWide = false } = Astro.props;
---
<article class={`relative rounded-xl overflow-hidden group bg-brand-card dark:bg-brand-darkCard flex flex-col justify-end p-6 md:p-8 border border-brand-ink/10 dark:border-white/5 shadow-lg ${isWide ? 'lg:col-span-2' : ''}`}>
  <div class="absolute inset-0 bg-brand-card/40 dark:bg-neutral-900 transition-transform duration-700 group-hover:scale-105">
    <div class="absolute inset-0 bg-gradient-to-t from-brand-card dark:from-brand-ink via-brand-card/70 dark:via-brand-ink/50 to-transparent z-10"></div>
    {isWide && (
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-neutral-800 to-black opacity-30 dark:opacity-60"></div>
    )}
  </div>
  
  <div class={`relative z-20 flex ${isWide ? 'flex-col sm:flex-row sm:items-center justify-between gap-6 h-full' : 'flex-col justify-end h-full'}`}>
    <div class={isWide ? "max-w-md" : ""}>
      <span class="text-brand-orange dark:text-brand-turquoise text-[10px] font-bold uppercase tracking-[0.2em] block mb-3">{category}</span>
      <h3 class={`font-serif font-bold mb-3 leading-snug group-hover:text-brand-orange dark:group-hover:text-brand-bg transition-colors text-brand-ink dark:text-white ${isWide ? 'text-2xl md:text-3xl' : 'text-xl md:text-2xl'}`}>
        {title}
      </h3>
      <span class="text-[10px] md:text-xs font-semibold text-brand-ink/60 dark:text-white/50 uppercase tracking-widest">por {author}</span>
    </div>
    
    {isWide && (
      <button class="w-16 h-16 rounded-full bg-brand-orange/10 dark:bg-brand-darkCard/80 backdrop-blur-sm border border-brand-orange/30 dark:border-white/10 flex items-center justify-center text-brand-orange dark:text-white hover:bg-brand-orange hover:text-white dark:hover:bg-brand-bg dark:hover:text-brand-ink transition-all duration-300 shrink-0 group-hover:scale-110 shadow-lg" aria-label="Reproducir">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
      </button>
    )}
  </div>
</article>
