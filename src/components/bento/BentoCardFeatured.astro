---
interface Props {
  title: string;
  excerpt: string;
  author: string;
  badge?: string;
  link?: string;
  image?: string;
}
const { title, excerpt, author, badge = "Ensayo de Portada", link = "#", image } = Astro.props;
---
<article class="lg:col-span-2 lg:row-span-2 relative rounded-xl overflow-hidden group bg-brand-ink flex flex-col justify-end p-6 md:p-10 border border-brand-ink/10 dark:border-white/5 shadow-2xl">
  <!-- Background Image -->
  <div class="absolute inset-0 bg-neutral-900 transition-transform duration-700 ease-out group-hover:scale-[1.02]">
    <div class="absolute inset-0 bg-gradient-to-t from-brand-ink via-brand-ink/80 to-transparent z-10"></div>
    {image ? (
      <img src={image} alt={title} class="w-full h-full object-cover opacity-80" />
    ) : (
      <div class="w-full h-full bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-neutral-800 to-black opacity-80"></div>
    )}
  </div>
  
  <div class="relative z-20 flex flex-col h-full justify-end">
    <div>
      <span class="inline-block bg-brand-bg text-brand-ink text-[10px] sm:text-xs font-bold uppercase tracking-[0.2em] px-4 py-1.5 mb-5 rounded-sm shadow">
        {badge}
      </span>
      <h2 class="font-serif text-3xl md:text-5xl lg:text-6xl font-bold mb-4 leading-[1.1] text-white group-hover:text-brand-bg transition-colors duration-300">
        {title}
      </h2>
      <p class="text-neutral-200 font-medium mb-8 line-clamp-3 text-sm md:text-base lg:text-lg max-w-lg leading-relaxed">
        {excerpt}
      </p>
    </div>
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-6 border-t border-white/10 mt-auto">
      <span class="text-xs md:text-sm font-semibold text-white/70 uppercase tracking-widest">por {author}</span>
      <a href={link} class="inline-flex items-center justify-center gap-2 bg-brand-orange hover:bg-brand-bg text-white hover:text-brand-ink font-bold text-xs md:text-sm uppercase tracking-widest px-6 py-3.5 rounded-sm transition-all hover:translate-x-1 duration-300 shadow-md">
        Leer Ensayo Completo 
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
    </div>
  </div>
</article>
