---
export interface Props {
  currentPage: number;
  totalPages: number;
  totalItems: number;
  pageSize?: number;
  itemLabelSingular?: string;
  itemLabelPlural?: string;
  searchQuery?: string;
  getPageUrl: (page: number) => string;
  class?: string;
}

const {
  currentPage,
  totalPages,
  totalItems,
  pageSize = 5,
  itemLabelSingular = 'elemento',
  itemLabelPlural = 'elementos',
  searchQuery = '',
  getPageUrl,
  class: className = '',
} = Astro.props;

const from = totalItems > 0 ? (currentPage - 1) * pageSize + 1 : 0;
const to = Math.min((currentPage - 1) * pageSize + pageSize, totalItems);
const label = totalItems === 1 ? itemLabelSingular : itemLabelPlural;
---

<div class={`px-6 py-4 border-t border-[#E5DFD5] dark:border-[#282828] bg-[#FAF6F0]/80 dark:bg-[#141414] flex flex-col sm:flex-row items-center justify-between gap-4 ${className}`.trim()}>
  <!-- Info de registros -->
  <div class="text-xs text-neutral-600 dark:text-neutral-400">
    Mostrando <span class="text-[#1F1B16] dark:text-white font-semibold">{from}</span> a <span class="text-[#1F1B16] dark:text-white font-semibold">{to}</span> de <span class="text-[#1F1B16] dark:text-white font-semibold">{totalItems}</span> {label}
    {searchQuery && (
      <span class="ml-2 text-[#E4572E] dark:text-[#F2B134] font-medium">(Filtro activo: "{searchQuery}")</span>
    )}
  </div>

  <!-- Controles de Navegación -->
  <div class="flex items-center gap-2">
    <!-- Botón Anterior -->
    {currentPage > 1 ? (
      <a
        href={getPageUrl(currentPage - 1)}
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-white dark:bg-[#1C1C1C] hover:bg-neutral-100 dark:hover:bg-[#252525] text-neutral-700 dark:text-neutral-200 hover:text-[#1F1B16] dark:hover:text-white border border-[#E5DFD5] dark:border-[#2E2E2E] hover:border-[#E4572E]/50 text-xs font-semibold transition-all shadow-sm"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>Anterior</span>
      </a>
    ) : (
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-neutral-100 dark:bg-[#181818]/60 text-neutral-400 dark:text-neutral-600 border border-[#E5DFD5] dark:border-[#222222] text-xs font-medium cursor-not-allowed">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>Anterior</span>
      </span>
    )}

    <!-- Indicador de Página -->
    <div class="px-3.5 py-1.5 rounded-xl bg-white dark:bg-[#181818] border border-[#E5DFD5] dark:border-[#282828] text-xs font-semibold text-neutral-700 dark:text-neutral-300 flex items-center gap-1.5 shadow-sm">
      <span class="text-[#E4572E] font-bold">Página {currentPage}</span>
      <span class="text-neutral-400">de</span>
      <span>{totalPages}</span>
    </div>

    <!-- Botón Siguiente -->
    {currentPage < totalPages ? (
      <a
        href={getPageUrl(currentPage + 1)}
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-white dark:bg-[#1C1C1C] hover:bg-neutral-100 dark:hover:bg-[#252525] text-neutral-700 dark:text-neutral-200 hover:text-[#1F1B16] dark:hover:text-white border border-[#E5DFD5] dark:border-[#2E2E2E] hover:border-[#E4572E]/50 text-xs font-semibold transition-all shadow-sm"
      >
        <span>Siguiente</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    ) : (
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-neutral-100 dark:bg-[#181818]/60 text-neutral-400 dark:text-neutral-600 border border-[#E5DFD5] dark:border-[#222222] text-xs font-medium cursor-not-allowed">
        <span>Siguiente</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    )}
  </div>
</div>
