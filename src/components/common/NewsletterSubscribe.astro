---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`flex flex-col gap-5 ${className}`}>
  <div>
    <span class="text-[10px] font-sans font-bold uppercase tracking-[0.3em] text-brand-orange block mb-3">
      Publicaciones
    </span>
    <h2 class="font-serif text-2xl md:text-3xl font-bold tracking-tight text-brand-ink dark:text-white leading-snug">
      Recibe un aviso por correo<br class="hidden sm:block" /> en cada nueva publicación
    </h2>
    <p class="mt-2 text-sm font-sans text-brand-muted max-w-xs">
      Sin spam. Solo cuando algo nuevo aparece en 870tivo.
    </p>
  </div>

  <!-- Formulario de suscripción -->
  <form
    id="form-suscripcion-boletin"
    class="flex flex-col sm:flex-row items-stretch gap-2 max-w-sm relative"
    novalidate
  >
    <!-- Campo trampa Honeypot (Oculto para humanos, detectable por bots) -->
    <div
      style="position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none;"
      aria-hidden="true"
    >
      <label for="input-hp-token">Ignora este campo</label>
      <input
        id="input-hp-token"
        name="hp_token"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <!-- Input de correo principal -->
    <label for="input-suscripcion-correo" class="sr-only">Tu correo electrónico</label>
    <input
      id="input-suscripcion-correo"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="tu@correo.com"
      class="
        flex-1 min-w-0 px-4 py-3
        text-sm font-sans font-medium
        bg-brand-bg dark:bg-brand-ink
        text-brand-ink dark:text-white
        placeholder:text-brand-muted/60
        border border-brand-ink/20 dark:border-white/10
        rounded-sm
        focus:outline-none focus:ring-2 focus:ring-brand-orange/50
        transition-colors
      "
    />

    <!-- Botón de acción -->
    <button
      type="submit"
      id="btn-suscripcion-submit"
      class="
        shrink-0 px-6 py-3
        bg-brand-ink dark:bg-brand-bg
        text-brand-bg dark:text-brand-ink
        text-xs font-sans font-bold uppercase tracking-[0.2em]
        rounded-sm
        hover:bg-brand-orange dark:hover:bg-brand-orange
        hover:text-white dark:hover:text-white
        transition-all duration-200
        disabled:opacity-50 disabled:cursor-not-allowed
        flex items-center justify-center gap-2
      "
    >
      <span class="btn-suscripcion-text">Avisarme</span>
      <span class="btn-suscripcion-spinner hidden w-3 h-3 border-2 border-current border-t-transparent rounded-full animate-spin"></span>
    </button>
  </form>

  <!-- Estado visual de feedback -->
  <p
    id="msg-suscripcion-feedback"
    role="status"
    aria-live="polite"
    class="text-xs font-sans font-medium hidden"
  ></p>
</div>

<script>
  function setupNewsletterForm() {
    const form = document.getElementById('form-suscripcion-boletin') as HTMLFormElement | null;
    const inputEmail = document.getElementById('input-suscripcion-correo') as HTMLInputElement | null;
    const inputHp = document.getElementById('input-hp-token') as HTMLInputElement | null;
    const btn = document.getElementById('btn-suscripcion-submit') as HTMLButtonElement | null;
    const btnText = btn?.querySelector('.btn-suscripcion-text') as HTMLSpanElement | null;
    const btnSpinner = btn?.querySelector('.btn-suscripcion-spinner') as HTMLSpanElement | null;
    const msgEl = document.getElementById('msg-suscripcion-feedback') as HTMLParagraphElement | null;

    if (!form || !inputEmail || !btn || !msgEl) return;

    type FeedbackType = 'success' | 'error' | 'duplicate';

    function setVisualState(type: FeedbackType, text: string) {
      if (!msgEl) return;
      msgEl.textContent = text;
      msgEl.classList.remove(
        'hidden',
        'text-emerald-600',
        'dark:text-emerald-400',
        'text-red-500',
        'dark:text-red-400',
        'text-brand-muted'
      );

      if (type === 'success') {
        msgEl.classList.add('text-emerald-600', 'dark:text-emerald-400');
      } else if (type === 'duplicate') {
        msgEl.classList.add('text-brand-muted');
      } else {
        msgEl.classList.add('text-red-500', 'dark:text-red-400');
      }
    }

    function setLoading(loading: boolean) {
      if (!btn || !inputEmail) return;
      btn.disabled = loading;
      inputEmail.disabled = loading;

      if (loading) {
        if (btnText) btnText.textContent = 'Suscribiendo...';
        btnSpinner?.classList.remove('hidden');
      } else {
        if (btnText) btnText.textContent = 'Avisarme';
        btnSpinner?.classList.add('hidden');
      }
    }

    form.addEventListener('submit', async (e: SubmitEvent) => {
      e.preventDefault();

      const email = inputEmail.value.trim();
      const hp_token = inputHp ? inputHp.value.trim() : '';

      if (!email) {
        setVisualState('error', 'Por favor, ingresa tu correo electrónico.');
        inputEmail.focus();
        return;
      }

      setLoading(true);
      msgEl.classList.add('hidden');

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ email, hp_token }),
        });

        const data = await response.json();

        if (response.status === 201 || response.status === 200) {
          setVisualState('success', data.message || '¡Te has suscrito correctamente a 870!');
          inputEmail.value = '';
        } else if (response.status === 409) {
          setVisualState('duplicate', data.message || 'Este correo ya se encuentra en nuestra lista de aviso.');
        } else {
          setVisualState('error', data.message || 'No se pudo registrar el correo. Intenta nuevamente.');
        }
      } catch (err) {
        setVisualState('error', 'Error al conectar con el servidor. Intenta de nuevo más tarde.');
      } finally {
        setLoading(false);
      }
    });
  }

  // Ejecutar en carga inicial y tras navegación Astro
  setupNewsletterForm();
  document.addEventListener('astro:page-load', setupNewsletterForm);
</script>

