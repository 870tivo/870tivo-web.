---
import ThemeToggle from './ThemeToggle';
import SearchModal from './SearchModal';

/**
 * Menú de actividades del colectivo.
 * Agrupa los encuentros culturales periódicos de 870tivo.
 */
const actividadesItems = [
  { label: 'Ciclos de Cine', href: '/cine-club', description: 'Proyecciones y conversaciones' },
  { label: 'Club de Lectura', href: '/club-de-lectura', description: 'Lecturas y diálogos literarios' },
  { label: 'Talleres', href: '/talleres', description: 'Formación creativa y técnica' },
  { label: 'Encuentros', href: '/encuentros', description: 'Eventos y jornadas diversas' },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-brand-bg/90 dark:bg-brand-ink/90 border-b border-brand-ink/10 dark:border-brand-darkCard/80 transition-colors"
>
  <div class="container mx-auto px-4 md:px-6 h-[72px] flex items-center justify-between">

    <!-- ── Logotipo ── -->
    <a href="/" class="flex items-center gap-4 group shrink-0">
      <img
        src="/assets/logo/870.jpeg"
        alt="870tivo Logo"
        class="w-12 h-12 object-cover shrink-0 rounded-sm group-hover:brightness-110 shadow-sm transition-all cursor-pointer"
        title="870tivo"
      />
      <div class="hidden sm:flex flex-col">
        <span class="font-serif font-bold text-xl leading-tight tracking-wide text-brand-ink dark:text-brand-darkInk">
          870tivo
        </span>
        <span class="text-[10px] text-brand-orange dark:text-brand-bg tracking-widest uppercase font-semibold">
          Encuentro Inmaterial
        </span>
      </div>
    </a>

    <!-- ── Navegación central (desktop) ── -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium" aria-label="Navegación principal">

      <!-- Galería -->
      <a
        href="/galeria"
        class="text-brand-ink/90 dark:text-brand-darkInk/90 hover:text-brand-orange dark:hover:text-brand-bg transition-colors"
      >
        Galería
      </a>

      <!-- Actividades (dropdown) -->
      <div class="relative group/act" id="nav-actividades">
        <button
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="dropdown-actividades"
          class="flex items-center gap-1 text-brand-ink/90 dark:text-brand-darkInk/90 hover:text-brand-orange dark:hover:text-brand-bg transition-colors cursor-pointer select-none"
          id="btn-actividades"
        >
          Actividades
          <!-- Chevron -->
          <svg
            class="w-3.5 h-3.5 mt-px transition-transform duration-200 group-hover/act:rotate-180"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <!-- Dropdown panel -->
        <div
          id="dropdown-actividades"
          role="menu"
          aria-labelledby="btn-actividades"
          class="
            absolute top-full left-1/2 -translate-x-1/2 mt-3 w-56
            bg-brand-bg dark:bg-brand-darkCard
            border border-brand-ink/10 dark:border-white/8
            rounded-sm shadow-xl shadow-brand-ink/10 dark:shadow-black/40
            opacity-0 invisible translate-y-1
            group-hover/act:opacity-100 group-hover/act:visible group-hover/act:translate-y-0
            transition-all duration-200 ease-out
            pointer-events-none group-hover/act:pointer-events-auto
          "
        >
          <!-- Triángulo decorativo -->
          <div class="absolute -top-1.5 left-1/2 -translate-x-1/2 w-3 h-3 bg-brand-bg dark:bg-brand-darkCard border-t border-l border-brand-ink/10 dark:border-white/8 rotate-45"></div>

          <ul class="py-2">
            {actividadesItems.map((item) => (
              <li role="none">
                <a
                  href={item.href}
                  role="menuitem"
                  class="
                    flex flex-col px-4 py-3
                    hover:bg-brand-ink/5 dark:hover:bg-white/5
                    transition-colors group/item
                  "
                >
                  <span class="text-sm font-semibold text-brand-ink dark:text-brand-darkInk group-hover/item:text-brand-orange dark:group-hover/item:text-brand-bg transition-colors">
                    {item.label}
                  </span>
                  <span class="text-[11px] text-brand-muted mt-0.5">
                    {item.description}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Blog -->
      <a
        href="/blog/pajaro-muerto"
        class="text-brand-ink/90 dark:text-brand-darkInk/90 hover:text-brand-orange dark:hover:text-brand-bg transition-colors"
      >
        Blog
      </a>

      <!-- Autores -->
      <a
        href="/autores"
        class="text-brand-ink/90 dark:text-brand-darkInk/90 hover:text-brand-orange dark:hover:text-brand-bg transition-colors"
      >
        Autores
      </a>

    </nav>

    <!-- ── Acciones (derecha) ── -->
    <div class="flex items-center gap-3 md:gap-4">
      <!-- React Islands -->
      <SearchModal client:load />
      <ThemeToggle client:load />

      <!-- Hamburguesa (mobile) -->
      <button
        id="btn-mobile-menu"
        type="button"
        class="md:hidden text-brand-ink dark:text-brand-darkInk hover:text-brand-orange dark:hover:text-brand-bg transition-colors p-1"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <!-- Ícono hamburguesa -->
        <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <!-- Ícono cerrar -->
        <svg id="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="hidden">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

  </div>

  <!-- ── Menú mobile ── -->
  <div
    id="mobile-menu"
    aria-hidden="true"
    class="
      md:hidden overflow-hidden
      max-h-0 opacity-0
      transition-[max-height,opacity] duration-300 ease-in-out
      bg-brand-bg/95 dark:bg-brand-ink/95 backdrop-blur-md
      border-t border-brand-ink/10 dark:border-white/5
    "
  >
    <nav class="container mx-auto px-4 py-4 flex flex-col gap-1" aria-label="Menú móvil">
      <a href="/galeria" class="mobile-nav-link">Galería</a>

      <!-- Actividades (acordeón mobile) -->
      <div>
        <button
          type="button"
          id="btn-mobile-actividades"
          aria-expanded="false"
          aria-controls="mobile-actividades"
          class="mobile-nav-link w-full flex items-center justify-between"
        >
          <span>Actividades</span>
          <svg id="chevron-actividades" class="w-4 h-4 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div
          id="mobile-actividades"
          class="overflow-hidden max-h-0 transition-[max-height] duration-200 ease-in-out pl-4 border-l border-brand-ink/10 dark:border-white/10 ml-2"
          aria-hidden="true"
        >
          {actividadesItems.map((item) => (
            <a href={item.href} class="mobile-nav-link text-sm text-brand-muted">
              {item.label}
            </a>
          ))}
        </div>
      </div>

      <a href="/blog/pajaro-muerto" class="mobile-nav-link">Blog</a>
      <a href="/autores" class="mobile-nav-link">Autores</a>
    </nav>
  </div>
</header>

<style>
  .mobile-nav-link {
    @apply block px-2 py-3 text-sm font-medium text-brand-ink/90 dark:text-brand-darkInk/90
           hover:text-brand-orange dark:hover:text-brand-bg
           border-b border-brand-ink/5 dark:border-white/5
           transition-colors;
  }
</style>

<script>
  // ── Menú hamburguesa (mobile) ──────────────────────────────────────────────
  const btnMobile    = document.getElementById('btn-mobile-menu') as HTMLButtonElement | null;
  const mobileMenu   = document.getElementById('mobile-menu') as HTMLDivElement | null;
  const iconOpen     = document.getElementById('icon-open') as SVGElement | null;
  const iconClose    = document.getElementById('icon-close') as SVGElement | null;

  function toggleMobileMenu(open: boolean): void {
    if (!btnMobile || !mobileMenu || !iconOpen || !iconClose) return;
    btnMobile.setAttribute('aria-expanded', String(open));
    mobileMenu.setAttribute('aria-hidden', String(!open));
    if (open) {
      mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
      mobileMenu.style.opacity   = '1';
    } else {
      mobileMenu.style.maxHeight = '0px';
      mobileMenu.style.opacity   = '0';
    }
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
  }

  btnMobile?.addEventListener('click', () => {
    const isOpen = btnMobile.getAttribute('aria-expanded') === 'true';
    toggleMobileMenu(!isOpen);
  });

  // Cierra al hacer clic fuera
  document.addEventListener('click', (e: MouseEvent) => {
    const header = document.getElementById('site-header');
    if (header && !header.contains(e.target as Node)) {
      toggleMobileMenu(false);
    }
  });

  // ── Acordeón "Actividades" en mobile ──────────────────────────────────────
  const btnAct      = document.getElementById('btn-mobile-actividades') as HTMLButtonElement | null;
  const actPanel    = document.getElementById('mobile-actividades') as HTMLDivElement | null;
  const chevronAct  = document.getElementById('chevron-actividades') as SVGElement | null;

  btnAct?.addEventListener('click', () => {
    if (!actPanel || !btnAct || !chevronAct) return;
    const isOpen = btnAct.getAttribute('aria-expanded') === 'true';
    btnAct.setAttribute('aria-expanded', String(!isOpen));
    actPanel.setAttribute('aria-hidden', String(isOpen));
    actPanel.style.maxHeight = isOpen ? '0px' : actPanel.scrollHeight + 'px';
    chevronAct.style.transform = isOpen ? '' : 'rotate(180deg)';
    // Recalcula alto del menú padre tras expandir
    if (mobileMenu && mobileMenu.style.maxHeight !== '0px') {
      mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
    }
  });
</script>
