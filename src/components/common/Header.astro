---
import ThemeToggle from './ThemeToggle';
import SearchModal from './SearchModal';
---

<header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-brand-bg/90 dark:bg-brand-ink/90 border-b border-brand-ink/10 dark:border-brand-darkCard/80 transition-colors">
  <div class="container mx-auto px-4 md:px-6 h-[72px] flex items-center justify-between">
    
    <!-- Left side -->
    <a href="/" class="flex items-center gap-4 group">
      <img src="/assets/logo/870.jpeg" alt="870tivo Logo" class="w-12 h-12 object-cover shrink-0 rounded-sm group-hover:brightness-110 shadow-sm transition-all cursor-pointer" title="870tivo" />
      <div class="hidden sm:flex flex-col">
        <span class="font-serif font-bold text-xl leading-tight tracking-wide text-brand-ink dark:text-brand-darkInk">870tivo</span>
        <span class="text-[10px] text-brand-orange dark:text-brand-bg tracking-widest uppercase font-semibold">Encuentro Inmaterial</span>
      </div>
    </a>

    <!-- Center Navigation -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
      <a href="/cine-club" class="text-brand-ink/90 dark:text-brand-darkInk/90 hover:text-brand-orange dark:hover:text-brand-bg transition-colors">Cine Club</a>
      <a href="/galeria" class="text-brand-ink/90 dark:text-brand-darkInk/90 hover:text-brand-orange dark:hover:text-brand-bg transition-colors">Galería 870</a>
      <a href="/blog/pajaro-muerto" class="text-brand-ink/90 dark:text-brand-darkInk/90 hover:text-brand-orange dark:hover:text-brand-bg transition-colors">Blog</a>
      <a href="/redes" class="text-brand-ink/90 dark:text-brand-darkInk/90 hover:text-brand-orange dark:hover:text-brand-bg transition-colors">Redes</a>
    </nav>

    <!-- Right side -->
    <div class="flex items-center gap-4 md:gap-6">
      <div class="hidden lg:flex items-center gap-3 text-xs text-brand-muted font-medium">
        <a href="https://instagram.com/870tivo" target="_blank" rel="noopener noreferrer" class="hover:text-brand-ink dark:hover:text-brand-darkInk transition-colors">@870tivo</a>
        <a href="https://instagram.com/870raw" target="_blank" rel="noopener noreferrer" class="hover:text-brand-ink dark:hover:text-brand-darkInk transition-colors">@870raw</a>
      </div>
      
      <!-- React Islands -->
      <SearchModal client:load />
      <ThemeToggle client:load />
      
      <button class="md:hidden text-brand-ink dark:text-brand-darkInk hover:text-brand-orange dark:hover:text-brand-bg transition-colors" aria-label="Menú">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>

  </div>
</header>
