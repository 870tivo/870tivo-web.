---
/**
 * src/components/autores/AuthorWorksGrid.astro
 * Grilla y listado de textos, ensayos y obras asociadas al autor.
 * Mantiene la línea estética editorial del colectivo: tipografía Playfair Display,
 * badges con tracking espaciado, tarjetas limpias y modo oscuro nativo.
 */
import type { SupabasePost } from '../../types/posts';
import { formatPostDate } from '../../types/posts';
import { Clock, ArrowRight, BookOpen } from 'lucide-astro';

interface Props {
  posts: SupabasePost[];
  authorName: string;
}

const { posts = [], authorName } = Astro.props;
---

<section class="w-full">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 pb-4 border-b border-brand-ink/10 dark:border-white/10">
    <div class="flex items-center gap-3">
      <div class="w-3.5 h-3.5 bg-brand-orange rounded-xs shrink-0" aria-hidden="true"></div>
      <h2 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-brand-ink dark:text-white">
        Obras & Publicaciones
      </h2>
    </div>

    {posts.length > 0 && (
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-muted">
        {posts.length} {posts.length === 1 ? 'artículo en archivo' : 'artículos en archivo'}
      </span>
    )}
  </div>

  {posts.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {posts.map((post) => (
        <article class="group flex flex-col bg-brand-card dark:bg-brand-darkCard border border-brand-ink/10 dark:border-white/10 rounded-xl overflow-hidden hover:border-brand-orange/40 dark:hover:border-brand-orange/40 transition-all duration-300 shadow-sm hover:shadow-md">
          <a href={`/blog/${post.slug}`} class="block aspect-[16/10] overflow-hidden relative bg-neutral-900 shrink-0">
            {post.cover_image ? (
              <img
                src={post.cover_image}
                alt={post.title}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 opacity-90 group-hover:opacity-100"
                onerror="this.setAttribute('src', '/assets/logo/870.jpeg')"
              />
            ) : (
              <div class="w-full h-full bg-[radial-gradient(ellipse_at_bottom_left,_var(--tw-gradient-stops))] from-neutral-800 to-brand-ink flex items-center justify-center p-6 text-center">
                <span class="font-serif italic text-white/30 text-sm">870tivo Archivo</span>
              </div>
            )}
            
            <div class="absolute top-3 left-3">
              <span class="px-2.5 py-1 rounded bg-black/70 backdrop-blur-md text-[10px] font-bold uppercase tracking-[0.2em] text-white border border-white/10">
                {post.category || 'Ensayo'}
              </span>
            </div>
          </a>

          <div class="p-5 sm:p-6 flex flex-col flex-grow justify-between gap-4">
            <div>
              <div class="flex items-center gap-3 text-[11px] text-brand-muted font-medium mb-3">
                <time datetime={post.created_at}>
                  {formatPostDate(post.created_at)}
                </time>
                <span class="w-1 h-1 rounded-full bg-brand-muted/40"></span>
                <span class="inline-flex items-center gap-1">
                  <Clock class="w-3 h-3 text-brand-orange" />
                  {post.read_time || '5 min'}
                </span>
              </div>

              <h3 class="font-serif text-lg sm:text-xl font-bold text-brand-ink dark:text-white group-hover:text-brand-orange dark:group-hover:text-brand-orange transition-colors leading-snug tracking-tight">
                <a href={`/blog/${post.slug}`} class="focus:outline-none">
                  {post.title}
                </a>
              </h3>

              {post.subtitle && (
                <p class="mt-2.5 text-xs sm:text-sm text-brand-muted line-clamp-2 leading-relaxed">
                  {post.subtitle}
                </p>
              )}
            </div>

            <div class="pt-3 border-t border-brand-ink/5 dark:border-white/5 flex items-center justify-between">
              <a
                href={`/blog/${post.slug}`}
                class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.15em] text-brand-orange hover:text-brand-ink dark:hover:text-white transition-colors group/btn"
              >
                <span>Leer ensayo</span>
                <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover/btn:translate-x-1" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="py-16 sm:py-20 px-6 text-center rounded-2xl bg-brand-card dark:bg-brand-darkCard border border-brand-ink/10 dark:border-white/10 max-w-2xl mx-auto">
      <div class="w-14 h-14 mx-auto mb-4 rounded-xl bg-brand-orange/10 dark:bg-brand-orange/15 border border-brand-orange/20 flex items-center justify-center text-brand-orange">
        <BookOpen class="w-6 h-6" />
      </div>

      <h3 class="font-serif text-xl sm:text-2xl font-bold text-brand-ink dark:text-white mb-2">
        Archivo en preparación
      </h3>
      <p class="text-sm text-brand-muted max-w-md mx-auto leading-relaxed">
        Las obras, ensayos y colaboraciones de <strong class="text-brand-ink dark:text-white font-medium">{authorName}</strong> están en proceso de digitalización y catalogación editorial.
      </p>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/autores"
          class="px-5 py-2.5 rounded-lg bg-brand-bg dark:bg-[#141414] hover:bg-brand-orange/10 text-brand-ink dark:text-white border border-brand-ink/10 dark:border-white/10 text-xs font-bold uppercase tracking-wider transition-colors"
        >
          Explorar otros autores
        </a>
        <a
          href="/"
          class="px-5 py-2.5 rounded-lg bg-brand-orange hover:bg-brand-orange/90 text-white text-xs font-bold uppercase tracking-wider transition-colors shadow-sm"
        >
          Ir a la Revista
        </a>
      </div>
    </div>
  )}
</section>
