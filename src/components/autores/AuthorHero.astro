---
/**
 * src/components/autores/AuthorHero.astro
 * Cabecera editorial del perfil individual de autor.
 * Muestra avatar de alta resolución o iniciales con monograma, nombre en Playfair Display,
 * rol/badge de pertenencia al colectivo, biografía y enlace o red social normalizado.
 */
import type { Json } from '../../types/database';

interface Props {
  name: string;
  specialty?: string | null;
  bio?: string | null;
  avatarUrl?: string | null;
  socialUrl?: string | null;
  socialLinks?: Json | null;
  worksCount?: number;
  galleryCount?: number;
  memberSince?: string;
}

const {
  name,
  specialty,
  bio,
  avatarUrl,
  socialUrl,
  socialLinks,
  worksCount = 0,
  galleryCount = 0,
  memberSince,
} = Astro.props;

// Generar iniciales del autor
function getInitials(fullName: string): string {
  const parts = fullName.trim().split(/\s+/).filter(Boolean);
  if (parts.length >= 2) {
    return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  }
  return fullName.slice(0, 2).toUpperCase() || '870';
}

const initials = getInitials(name);

// Extraer mes abreviado y año de membresía en español (ej: NOV 2026)
function formatMembershipDate(dateStr?: string): string {
  if (!dateStr) return 'NOV 2026';
  try {
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return 'NOV 2026';
    const month = d.toLocaleDateString('es-ES', { month: 'short' }).replace('.', '').toUpperCase();
    const year = d.getFullYear();
    return `${month} ${year}`;
  } catch {
    return 'NOV 2026';
  }
}

const formattedMembership = formatMembershipDate(memberSince);

// Procesar enlaces sociales normalizados
interface NormalizedSocial {
  platform: string;
  label: string;
  url: string;
}

function parseSocial(raw?: string | null): NormalizedSocial | null {
  if (!raw || typeof raw !== 'string') return null;
  const str = raw.trim();
  if (!str) return null;

  let platform = 'web';
  let url = str;
  let label = str;

  // Caso 1: Handle con @ (ej: @valeria o @870tivo)
  if (str.startsWith('@')) {
    const handle = str.replace(/^@+/, '');
    return {
      platform: 'instagram',
      label: `@${handle}`,
      url: `https://instagram.com/${handle}`,
    };
  }

  // Caso 2: URL completa o con dominio
  let withHttp = str;
  if (!withHttp.startsWith('http://') && !withHttp.startsWith('https://')) {
    if (!withHttp.includes('.') && !withHttp.includes('/')) {
      return {
        platform: 'instagram',
        label: `@${withHttp}`,
        url: `https://instagram.com/${withHttp}`,
      };
    }
    withHttp = `https://${withHttp}`;
  }

  try {
    const u = new URL(withHttp);
    const hostname = u.hostname.toLowerCase().replace(/^www\./, '');
    const pathname = u.pathname.replace(/^\/+|\/+$/g, '');
    const firstSegment = pathname.split('/')[0] || '';

    if (hostname.includes('instagram.com')) {
      platform = 'instagram';
      label = firstSegment ? `@${firstSegment}` : 'Instagram';
      url = firstSegment ? `https://instagram.com/${firstSegment}` : withHttp;
    } else if (hostname.includes('twitter.com') || hostname.includes('x.com')) {
      platform = 'x';
      label = firstSegment ? `@${firstSegment}` : '𝕏';
      url = firstSegment ? `https://x.com/${firstSegment}` : withHttp;
    } else if (hostname.includes('substack.com')) {
      platform = 'substack';
      label = hostname;
      url = withHttp;
    } else if (hostname.includes('github.com')) {
      platform = 'github';
      label = firstSegment ? `@${firstSegment}` : 'GitHub';
      url = withHttp;
    } else if (hostname.includes('linkedin.com')) {
      platform = 'linkedin';
      label = 'LinkedIn';
      url = withHttp;
    } else {
      platform = 'web';
      label = hostname || str;
      url = withHttp;
    }
  } catch {
    platform = 'web';
    label = str.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
    url = withHttp;
  }

  return { platform, label, url };
}

const normalizedLinks: NormalizedSocial[] = [];

// 1. Prioridad: social_url principal
const primary = parseSocial(socialUrl);
if (primary) {
  normalizedLinks.push(primary);
}

// 2. Revisar social_links estructurados si existen y no duplican
if (socialLinks && typeof socialLinks === 'object') {
  if (Array.isArray(socialLinks)) {
    for (const item of socialLinks) {
      if (item && typeof item === 'object') {
        const rawUrl = String((item as any).url || (item as any).href || '').trim();
        if (rawUrl) {
          const parsed = parseSocial(rawUrl);
          if (parsed && !normalizedLinks.some((l) => l.url === parsed.url)) {
            normalizedLinks.push(parsed);
          }
        }
      }
    }
  } else {
    for (const [_key, val] of Object.entries(socialLinks)) {
      if (typeof val === 'string' && val.trim()) {
        const parsed = parseSocial(val.trim());
        if (parsed && !normalizedLinks.some((l) => l.url === parsed.url)) {
          normalizedLinks.push(parsed);
        }
      }
    }
  }
}
---

<section class="relative w-full mb-12 sm:mb-16">
  <!-- Navegación de retorno al directorio -->
  <div class="mb-6">
    <a
      href="/autores"
      class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-brand-muted hover:text-brand-orange dark:hover:text-brand-bg transition-colors group"
    >
      <svg
        class="w-4 h-4 transition-transform group-hover:-translate-x-1"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Directorio de Autores
    </a>
  </div>

  <!-- Ficha Editorial Principal -->
  <div class="relative bg-brand-card dark:bg-brand-darkCard border border-brand-ink/10 dark:border-white/10 rounded-2xl p-6 sm:p-10 lg:p-12 shadow-sm overflow-hidden">
    <!-- Marca de agua decorativa sutil de fondo -->
    <div
      class="absolute -right-8 -bottom-10 select-none pointer-events-none opacity-[0.03] dark:opacity-[0.04] font-serif font-black text-9xl sm:text-[14rem] text-brand-ink dark:text-white"
      aria-hidden="true"
    >
      870
    </div>

    <div class="relative z-10 flex flex-col md:flex-row items-center md:items-start gap-8 lg:gap-12 text-center md:text-left">
      <!-- Avatar con marco y sombras editoriales -->
      <div class="shrink-0 relative group">
        {avatarUrl ? (
          <div class="w-32 h-32 sm:w-36 sm:h-36 md:w-40 md:h-40 rounded-2xl overflow-hidden ring-2 ring-brand-orange/40 ring-offset-4 ring-offset-brand-card dark:ring-offset-brand-darkCard shadow-xl bg-brand-bg dark:bg-[#141414]">
            <img
              src={avatarUrl}
              alt={`Fotografía de ${name}`}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div
              class="hidden w-full h-full bg-brand-orange/10 dark:bg-brand-orange/20 items-center justify-center"
              aria-hidden="true"
            >
              <span class="font-serif font-bold text-4xl text-brand-orange">
                {initials}
              </span>
            </div>
          </div>
        ) : (
          <div
            class="w-32 h-32 sm:w-36 sm:h-36 md:w-40 md:h-40 rounded-2xl ring-2 ring-brand-orange/30 ring-offset-4 ring-offset-brand-card dark:ring-offset-brand-darkCard bg-brand-orange/10 dark:bg-brand-orange/15 border border-brand-orange/20 flex items-center justify-center shadow-xl"
            aria-hidden="true"
          >
            <span class="font-serif font-bold text-4xl sm:text-5xl text-brand-orange select-none tracking-tight">
              {initials}
            </span>
          </div>
        )}

        <!-- Pequeño adorno editorial 45° -->
        <div
          class="hidden sm:block absolute -top-1.5 -right-1.5 w-4 h-4 bg-brand-orange rotate-45 border-2 border-brand-card dark:border-brand-darkCard rounded-xs shadow-sm"
          aria-hidden="true"
        ></div>
      </div>

      <!-- Información del Autor -->
      <div class="flex-1 min-w-0">
        <!-- Badge colectivo / especialidad editorial -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-orange/10 dark:bg-brand-orange/20 border border-brand-orange/25 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-orange animate-pulse"></span>
          <span class="text-[10px] sm:text-xs font-bold uppercase tracking-[0.25em] text-brand-orange">
            {specialty?.trim() ? specialty.trim().toUpperCase() : 'FIRMA COLABORADORA'}
          </span>
        </div>

        <!-- Nombre del autor -->
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-brand-ink dark:text-white tracking-tight leading-tight">
          {name}
        </h1>

        <!-- Biografía editorial -->
        {bio ? (
          <p class="mt-4 text-brand-ink/80 dark:text-neutral-300 text-sm sm:text-base leading-relaxed max-w-2xl font-normal">
            {bio}
          </p>
        ) : (
          <p class="mt-3 text-brand-muted text-sm sm:text-base italic max-w-xl">
            Autor y colaborador del colectivo cultural 870tivo, participando activamente en la construcción y difusión de pensamiento visual y literario.
          </p>
        )}

        <!-- Red social o enlace destacado (Directamente bajo la biografía) -->
        {normalizedLinks.length > 0 && (
          <div class="mt-4 flex flex-wrap items-center justify-center md:justify-start gap-2.5">
            {normalizedLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="
                  group/social inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full
                  bg-brand-orange/5 hover:bg-brand-orange/15 dark:bg-white/5 dark:hover:bg-white/10
                  border border-brand-orange/25 hover:border-brand-orange/50 dark:border-white/10 dark:hover:border-brand-orange/30
                  text-brand-ink dark:text-white hover:text-brand-orange dark:hover:text-brand-orange
                  text-xs font-semibold tracking-wide transition-all duration-200 shadow-2xs
                "
                aria-label={`Visitar perfil de ${name}: ${link.label}`}
              >
                {link.platform === 'instagram' && (
                  <svg class="w-3.5 h-3.5 text-brand-orange shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                    <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
                  </svg>
                )}
                {link.platform === 'x' && (
                  <svg class="w-3.5 h-3.5 text-brand-orange shrink-0" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                )}
                {link.platform === 'substack' && (
                  <svg class="w-3.5 h-3.5 text-brand-orange shrink-0" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>
                  </svg>
                )}
                {link.platform !== 'instagram' && link.platform !== 'x' && link.platform !== 'substack' && (
                  <svg class="w-3.5 h-3.5 text-brand-orange shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                    <path d="M2 12h20"/>
                  </svg>
                )}
                <span class="font-medium text-xs text-brand-ink dark:text-neutral-200 group-hover/social:text-brand-orange dark:group-hover/social:text-brand-orange transition-colors">
                  {link.label}
                </span>
                <svg class="w-3 h-3 text-brand-orange opacity-60 group-hover/social:opacity-100 group-hover/social:translate-x-0.5 transition-all shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  <polyline points="15 3 21 3 21 9"/>
                  <line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
              </a>
            ))}
          </div>
        )}

        <!-- Estadísticas del autor -->
        <div class="mt-8 pt-6 border-t border-brand-ink/10 dark:border-white/10 flex flex-wrap items-center justify-center md:justify-start gap-6 sm:gap-10 text-xs">
          <div class="flex items-center gap-2">
            <span class="font-serif text-xl sm:text-2xl font-bold text-brand-ink dark:text-white">
              {worksCount}
            </span>
            <span class="text-brand-muted uppercase tracking-widest text-[11px] font-semibold">
              {worksCount === 1 ? 'Publicación' : 'Publicaciones'}
            </span>
          </div>

          {galleryCount > 0 && (
            <div class="flex items-center gap-2">
              <span class="font-serif text-xl sm:text-2xl font-bold text-brand-ink dark:text-white">
                {galleryCount}
              </span>
              <span class="text-brand-muted uppercase tracking-widest text-[11px] font-semibold">
                {galleryCount === 1 ? 'Obra en Galería' : 'Obras en Galería'}
              </span>
            </div>
          )}

          <div class="flex items-center gap-2">
            <span class="text-brand-muted uppercase tracking-widest text-[11px] font-semibold">
              MIEMBRO DESDE
            </span>
            <span class="font-serif text-sm font-bold text-brand-orange">
              {formattedMembership}
            </span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
