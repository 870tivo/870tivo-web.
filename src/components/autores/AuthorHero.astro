---
/**
 * src/components/autores/AuthorHero.astro
 * Cabecera editorial del perfil individual de autor.
 * Muestra avatar de alta resolución o iniciales con monograma, nombre en Playfair Display,
 * rol/badge de pertenencia al colectivo, biografía y enlaces sociales estructurados.
 */
import type { Json } from '../../types/database';

interface Props {
  name: string;
  bio?: string | null;
  avatarUrl?: string | null;
  socialUrl?: string | null;
  socialLinks?: Json | null;
  worksCount?: number;
  galleryCount?: number;
  memberSince?: string;
}

const {
  name,
  bio,
  avatarUrl,
  socialUrl,
  socialLinks,
  worksCount = 0,
  galleryCount = 0,
  memberSince,
} = Astro.props;

// Generar iniciales del autor
function getInitials(fullName: string): string {
  const parts = fullName.trim().split(/\s+/).filter(Boolean);
  if (parts.length >= 2) {
    return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  }
  return fullName.slice(0, 2).toUpperCase();
}

const initials = getInitials(name);

// Extraer año de membresía
let formattedYear = '2026';
if (memberSince) {
  try {
    formattedYear = new Date(memberSince).getFullYear().toString();
  } catch {
    formattedYear = '2026';
  }
}

// Procesar enlaces sociales normalizados
interface NormalizedSocial {
  platform: string;
  label: string;
  url: string;
}

const normalizedLinks: NormalizedSocial[] = [];

// 1. Procesar objeto social_links (JSONB)
if (socialLinks && typeof socialLinks === 'object' && !Array.isArray(socialLinks)) {
  for (const [key, val] of Object.entries(socialLinks)) {
    if (typeof val === 'string' && val.trim()) {
      const cleanVal = val.trim();
      let href = cleanVal;
      let label = cleanVal;

      if (key === 'instagram') {
        const handle = cleanVal.replace(/^https?:\/\/(www\.)?instagram\.com\/?/, '').replace(/^@/, '').replace(/\/$/, '');
        href = `https://instagram.com/${handle}`;
        label = `@${handle}`;
      } else if (key === 'twitter' || key === 'x') {
        const handle = cleanVal.replace(/^https?:\/\/(www\.)?(twitter|x)\.com\/?/, '').replace(/^@/, '').replace(/\/$/, '');
        href = `https://x.com/${handle}`;
        label = `@${handle}`;
      } else if (key === 'website' || key === 'web') {
        href = cleanVal.startsWith('http') ? cleanVal : `https://${cleanVal}`;
        label = cleanVal.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
      } else if (key === 'email' || key === 'correo') {
        href = `mailto:${cleanVal}`;
        label = cleanVal;
      } else {
        href = cleanVal.startsWith('http') ? cleanVal : `https://${cleanVal}`;
      }

      normalizedLinks.push({
        platform: key.toLowerCase(),
        label,
        url: href,
      });
    }
  }
}

// 2. Si no hay social_links estructurados, usar social_url legado
if (normalizedLinks.length === 0 && socialUrl && socialUrl.trim()) {
  const cleanUrl = socialUrl.trim();
  let href = cleanUrl.startsWith('http') ? cleanUrl : `https://${cleanUrl}`;
  let label = cleanUrl;
  let platform = 'web';

  try {
    const parsed = new URL(href);
    const host = parsed.hostname.toLowerCase();
    const path = parsed.pathname.replace(/^\//, '').split('/')[0] || '';

    if (host.includes('instagram.com')) {
      platform = 'instagram';
      label = path ? `@${path}` : 'Instagram';
    } else if (host.includes('twitter.com') || host.includes('x.com')) {
      platform = 'x';
      label = path ? `@${path}` : 'X';
    } else {
      label = host.replace(/^www\./, '');
    }
  } catch {
    label = cleanUrl;
  }

  normalizedLinks.push({
    platform,
    label,
    url: href,
  });
}
---

<section class="relative w-full mb-12 sm:mb-16">
  <!-- Navegación de retorno al directorio -->
  <div class="mb-6">
    <a
      href="/autores"
      class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-brand-muted hover:text-brand-orange dark:hover:text-brand-bg transition-colors group"
    >
      <svg
        class="w-4 h-4 transition-transform group-hover:-translate-x-1"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Directorio de Autores
    </a>
  </div>

  <!-- Ficha Editorial Principal -->
  <div class="relative bg-brand-card dark:bg-brand-darkCard border border-brand-ink/10 dark:border-white/10 rounded-2xl p-6 sm:p-10 lg:p-12 shadow-sm overflow-hidden">
    <!-- Marca de agua decorativa sutil de fondo -->
    <div
      class="absolute -right-8 -bottom-10 select-none pointer-events-none opacity-[0.03] dark:opacity-[0.04] font-serif font-black text-9xl sm:text-[14rem] text-brand-ink dark:text-white"
      aria-hidden="true"
    >
      870
    </div>

    <div class="relative z-10 flex flex-col md:flex-row items-center md:items-start gap-8 lg:gap-12 text-center md:text-left">
      <!-- Avatar con marco y sombras editoriales -->
      <div class="shrink-0 relative group">
        {avatarUrl ? (
          <div class="w-32 h-32 sm:w-36 sm:h-36 md:w-40 md:h-40 rounded-2xl overflow-hidden ring-2 ring-brand-orange/40 ring-offset-4 ring-offset-brand-card dark:ring-offset-brand-darkCard shadow-xl bg-brand-bg dark:bg-[#141414]">
            <img
              src={avatarUrl}
              alt={`Fotografía de ${name}`}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div
              class="hidden w-full h-full bg-brand-orange/10 dark:bg-brand-orange/20 items-center justify-center"
              aria-hidden="true"
            >
              <span class="font-serif font-bold text-4xl text-brand-orange">
                {initials}
              </span>
            </div>
          </div>
        ) : (
          <div
            class="w-32 h-32 sm:w-36 sm:h-36 md:w-40 md:h-40 rounded-2xl ring-2 ring-brand-orange/30 ring-offset-4 ring-offset-brand-card dark:ring-offset-brand-darkCard bg-brand-orange/10 dark:bg-brand-orange/15 border border-brand-orange/20 flex items-center justify-center shadow-xl"
            aria-hidden="true"
          >
            <span class="font-serif font-bold text-4xl sm:text-5xl text-brand-orange select-none tracking-tight">
              {initials}
            </span>
          </div>
        )}

        <!-- Pequeño adorno editorial 45° -->
        <div
          class="hidden sm:block absolute -top-1.5 -right-1.5 w-4 h-4 bg-brand-orange rotate-45 border-2 border-brand-card dark:border-brand-darkCard rounded-xs shadow-sm"
          aria-hidden="true"
        ></div>
      </div>

      <!-- Información del Autor -->
      <div class="flex-1 min-w-0">
        <!-- Badge colectivo -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-orange/10 dark:bg-brand-orange/20 border border-brand-orange/25 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-orange animate-pulse"></span>
          <span class="text-[10px] sm:text-xs font-bold uppercase tracking-[0.25em] text-brand-orange">
            Firma Colaboradora
          </span>
        </div>

        <!-- Nombre del autor -->
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-brand-ink dark:text-white tracking-tight leading-tight">
          {name}
        </h1>

        <!-- Biografía editorial -->
        {bio ? (
          <p class="mt-4 text-brand-ink/80 dark:text-neutral-300 text-sm sm:text-base leading-relaxed max-w-2xl font-normal">
            {bio}
          </p>
        ) : (
          <p class="mt-3 text-brand-muted text-sm sm:text-base italic max-w-xl">
            Autor y colaborador del colectivo cultural 870tivo, participando activamente en la construcción y difusión de pensamiento visual y literario.
          </p>
        )}

        <!-- Redes sociales y presencia digital -->
        {normalizedLinks.length > 0 && (
          <div class="mt-6 flex flex-wrap items-center justify-center md:justify-start gap-2.5">
            {normalizedLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-brand-bg dark:bg-[#141414] hover:bg-brand-orange/10 dark:hover:bg-brand-orange/20 text-brand-ink dark:text-white hover:text-brand-orange dark:hover:text-brand-orange border border-brand-ink/10 dark:border-white/10 hover:border-brand-orange/30 text-xs font-bold tracking-wider uppercase transition-all duration-200 shadow-xs"
                aria-label={`Enlace a ${link.platform} de ${name}`}
              >
                {link.platform === 'instagram' && (
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                    <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
                  </svg>
                )}
                {(link.platform === 'twitter' || link.platform === 'x') && (
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
                    <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
                  </svg>
                )}
                {link.platform === 'email' && (
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="16" x="2" y="4" rx="2"/>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                  </svg>
                )}
                {link.platform !== 'instagram' && link.platform !== 'twitter' && link.platform !== 'x' && link.platform !== 'email' && (
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                    <path d="M2 12h20"/>
                  </svg>
                )}
                <span>{link.label}</span>
                <svg class="w-3 h-3 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  <polyline points="15 3 21 3 21 9"/>
                  <line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
              </a>
            ))}
          </div>
        )}

        <!-- Estadísticas del autor -->
        <div class="mt-8 pt-6 border-t border-brand-ink/10 dark:border-white/10 flex flex-wrap items-center justify-center md:justify-start gap-6 sm:gap-10 text-xs">
          <div class="flex items-center gap-2">
            <span class="font-serif text-xl sm:text-2xl font-bold text-brand-ink dark:text-white">
              {worksCount}
            </span>
            <span class="text-brand-muted uppercase tracking-widest text-[11px] font-semibold">
              {worksCount === 1 ? 'Publicación' : 'Publicaciones'}
            </span>
          </div>

          {galleryCount > 0 && (
            <div class="flex items-center gap-2">
              <span class="font-serif text-xl sm:text-2xl font-bold text-brand-ink dark:text-white">
                {galleryCount}
              </span>
              <span class="text-brand-muted uppercase tracking-widest text-[11px] font-semibold">
                {galleryCount === 1 ? 'Obra en Galería' : 'Obras en Galería'}
              </span>
            </div>
          )}

          <div class="flex items-center gap-2">
            <span class="text-brand-muted uppercase tracking-widest text-[11px] font-semibold">
              Vinculación
            </span>
            <span class="font-serif text-sm font-bold text-brand-orange">
              {formattedYear}
            </span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

